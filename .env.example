# Copier ce fichier sous le nom '.env' dans votre site et adapter les valeurs.

# Secret d'administration pour la connexion au CMS Inline (/admin et API)
CMS_ADMIN_SECRET=admin123

# Activation du flux de publication Git via API
# Values: true | false
CMS_GIT_ENABLED=false

# Branche Git cible pour la publication (ex: prod, main)
# CMS_GIT_BRANCH=prod
# GIT_DEPLOY_BRANCH=prod

# Configuration du provider Git API (github | gitlab | gitea)
GIT_PROVIDER=github
GIT_OWNER=malibub-digital
GIT_REPO=sites

# Token d'accès API Git avec droits d'écriture sur le dépôt (Personal Access Token)
# GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
