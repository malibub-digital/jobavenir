---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import MinimalHeader from "../../../components/MinimalHeader.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import PremiumIcon from "../../../components/PremiumIcon.astro";
import siteConfig from "../../../../site.config.json";
import campaignsData from "../../../data/campaigns.json";

const { slug } = Astro.params;
const allCampaigns = campaignsData.campaigns || [];
let campaign: any = allCampaigns.find((c: any) => c.slug === slug);

if (!campaign && (slug === "innovation-2026" || slug === "innovation-2026-c1")) {
  campaign = allCampaigns.find((c: any) => c.slug === "innovation-2026-c1" || c.slug === (siteConfig as any).activeCampaignSlug);
}

if (!campaign) {
  return Astro.redirect(`/concours/${(siteConfig as any).activeCampaignSlug || "innovation-2026-c1"}`);
}

const translatedWhatsappGroupUrl = "https://chat.whatsapp.com/GCOebHI61jC41GdDOvVCi7";

const footerLogos = [
  { src: "/images/logo-apej.svg", alt: "APEJ Mali" },
  { src: "/images/logo-eoj.svg", alt: "EOJ Mali" },
  { src: "/images/logo-particip.png", alt: "PartiCIP" },
];
---

<BaseLayout title={`Concours d'Innovation — Mali Job (Bamanankan & N'Ko)`}
  description="Simplified multilingual campaign page in French, Bambara and N'Ko."
>
  <MinimalHeader slot="header" />

  <main class="py-8 sm:py-12 bg-stone-50 min-h-screen">
    <div class="ml-container max-w-4xl mx-auto px-4">

      <!-- Language tabs -->
      <div class="flex gap-2 mb-6 border-b border-stone-200 pb-2">
        <a href="#francais" class="px-3 py-1.5 rounded-t-lg text-xs font-bold bg-white border border-stone-200 text-stone-900 no-underline">Français</a>
        <a href="#bamanankan" class="px-3 py-1.5 rounded-t-lg text-xs font-bold bg-amber-50 border border-amber-200 text-stone-700 no-underline">Bamanankan</a>
        <a href="#nko" class="px-3 py-1.5 rounded-t-lg text-xs font-bold bg-amber-50 border border-amber-200 text-stone-700 no-underline">ߒߞߏ</a>
      </div>

      <!-- FRANÇAIS -->
      <section id="francais" class="bg-white rounded-3xl border border-stone-200 shadow-sm mb-8 scroll-mt-20">
        <div class="p-6 sm:p-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-orange-100 text-orange-800 border border-orange-200/60 mb-4">Français</div>
          <h1 class="text-2xl sm:text-3xl font-black text-stone-900 font-title leading-tight mb-1">Grand Concours d'Innovation Mali Job</h1>
          <p class="text-base font-bold text-orange-600 mb-3">{campaign.prizes.grandPrizeCount} × {campaign.prizes.grandPrizeAmount} + {campaign.prizes.laureateCount} projets mis en lumière</p>

          <!-- BANDEAU DATE LIMITE -->
          <div class="mb-5 flex items-center justify-between gap-2 bg-amber-50 p-3 rounded-xl border border-amber-300 text-xs sm:text-sm font-bold text-stone-800">
            <span class="inline-flex items-center gap-1.5">
              <span>⏱️</span>
              <span>Date limite :</span>
            </span>
            <span class="text-orange-700 font-black">{campaign.submission?.deadline || "30 Novembre 2026 à 23h59"}</span>
          </div>

          <div class="space-y-4">
            <div class="bg-gradient-to-br from-amber-50/90 via-white to-amber-50/50 p-4 sm:p-5 rounded-2xl border-2 border-amber-300 flex items-center gap-4 shadow-xs">
              <PremiumIcon name="money" size={56} variant="gold" class="shrink-0" />
              <div class="min-w-0">
                <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">Ce que vous pouvez gagner</h2>
                <ul class="text-xs sm:text-sm text-stone-700 space-y-1 list-disc pl-4">
                  <li><strong class="whitespace-nowrap">{campaign.prizes.grandPrizeCount} Grands Prix de&nbsp;{campaign.prizes.grandPrizeAmount}</strong> chacun en appui de lancement ou d'amélioration pour accélérer votre projet</li>
                  <li><strong>{campaign.prizes.laureateCount} projets</strong> publiés sur une page officielle Mali Job pour être vus par des partenaires et investisseurs</li>
                </ul>
              </div>
            </div>

            <div class="bg-gradient-to-br from-stone-50 via-white to-stone-50/60 p-4 sm:p-5 rounded-2xl border-2 border-stone-200 flex items-center gap-4 shadow-xs">
              <PremiumIcon name="video" size={56} variant="river" class="shrink-0" />
              <div class="min-w-0">
                <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">Comment participer ?</h2>
                <ol class="text-xs sm:text-sm text-stone-700 space-y-1 list-decimal pl-4">
                  <li>Rejoignez notre groupe WhatsApp ou Telegram (liens ci-dessous)</li>
                  <li>Filmez une vidéo de <strong>moins de 3 minutes</strong> avec votre téléphone</li>
                  <li>Présentez votre projet : le problème que vous résolvez et votre solution</li>
                  <li>Envoyez votre vidéo au numéro qui vous sera donné dans le groupe</li>
                </ol>
              </div>
            </div>

            <div class="bg-gradient-to-br from-emerald-50/90 via-white to-emerald-50/50 p-4 sm:p-5 rounded-2xl border-2 border-emerald-300 flex items-center gap-4 shadow-xs">
              <PremiumIcon name="success" size={56} variant="emerald" class="shrink-0" />
              <div class="min-w-0">
                <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1">C'est gratuit</h2>
                <p class="text-xs sm:text-sm text-stone-700 m-0">Aucun frais de participation. Ouvert à tous les jeunes porteurs de projets au Mali.</p>
              </div>
            </div>

            <div class="bg-white p-4 rounded-xl border-2 border-amber-300/80">
              <h2 class="text-sm font-black text-stone-900 mb-3">💬 Rejoignez les groupes</h2>
              <div class="flex flex-col sm:flex-row gap-3">
                <a href={translatedWhatsappGroupUrl} target="_blank" rel="noopener noreferrer" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 px-4 rounded-xl text-center text-xs no-underline transition-colors">Rejoindre WhatsApp</a>
                <a href={campaign.community.telegramGroupUrl || "https://t.me/malijob_innovation"} target="_blank" rel="noopener noreferrer" class="flex-1 bg-sky-600 hover:bg-sky-700 text-white font-bold py-2.5 px-4 rounded-xl text-center text-xs no-underline transition-colors">Rejoindre Telegram</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- BAMANANKAN -->
      <section id="bamanankan" lang="bm" class="bg-white rounded-3xl border border-amber-200 shadow-sm mb-8 scroll-mt-20">
        <div class="p-6 sm:p-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200/60 mb-4">Bamanankan</div>
          <h1 class="text-2xl sm:text-3xl font-black text-stone-900 font-title leading-tight mb-1">Mali Job ká ɲɔ́gɔndanba — Pórozɛ kúraw</h1>
          <p class="text-base font-bold text-orange-600 mb-3">Wáa 20 (100 000 FCFA) × 3 + Pórozɛ 10 mínnu bɛ́ jìra kɛ́nɛ kàn</p>

          <!-- BANDEAU DATE LIMITE -->
          <div class="mb-5 flex items-center justify-between gap-2 bg-amber-50 p-3 rounded-xl border border-amber-300 text-xs sm:text-sm font-bold text-stone-800">
            <span class="inline-flex items-center gap-1.5">
              <span>⏱️</span>
              <span>Wáati dàn :</span>
            </span>
            <span class="text-orange-700 font-black">{campaign.submission?.deadline === "30 Novembre 2026 à 23h59" ? "Nowanburukalo tìle 30 sàn 2026 — 23h59" : campaign.submission?.deadline === "Ouverture prochaine" ? "À bɛ́nà dá wúli sɔ́ɔni" : (campaign.submission?.deadline || "Nowanburukalo tìle 30 sàn 2026 — 23h59")}</span>
          </div>

          <div class="space-y-4">
            <div class="bg-gradient-to-br from-amber-50/90 via-white to-amber-50/50 p-4 sm:p-5 rounded-2xl border-2 border-amber-300 flex items-center gap-4 shadow-xs">
              <PremiumIcon name="money" size={56} variant="gold" class="shrink-0" />
              <div class="min-w-0">
                <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">Áw bɛ́ sé kà mîn sɔ̀rɔ</h2>
                <ul class="text-xs sm:text-sm text-stone-700 space-y-1 list-disc pl-4">
                  <li><strong>Mɔ̀gɔ 3 fɔ́lɔ mínnu bɛ́ sé sɔ̀rɔ :</strong> <strong class="whitespace-nowrap">wáa 20 (100&nbsp;000&nbsp;FCFA)</strong> bɛ́ dí ù kélen-kélen bɛ́ɛ mà wálasa k'ù dɛ̀mɛ kà pórozɛ dámìnɛ wàlímà k'à ɲɛ́taa téliya</li>
                  <li><strong>Pórozɛ 10</strong> bɛ́nà jìra Mali Job ká siti ɲɛ́ kɛ́rɛnkɛrɛnnen kàn, wálasa jɛ̀ɲɔgɔnw ni wáridonnaw k'ù yé</li>
                </ul>
              </div>
            </div>

            <div class="bg-gradient-to-br from-stone-50 via-white to-stone-50/60 p-4 sm:p-5 rounded-2xl border-2 border-stone-200 flex items-center gap-4 shadow-xs">
              <PremiumIcon name="video" size={56} variant="river" class="shrink-0" />
              <div class="min-w-0">
                <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">Áw bɛ́ sé kà áw sèn dòn à lá cógo dì?</h2>
                <ol class="text-xs sm:text-sm text-stone-700 space-y-1 list-decimal pl-4">
                  <li>Áw ká dòn án ká WhatsApp wàlímà Telegram kúlu kɔ́nɔ (síraw bɛ́ dùguma)</li>
                  <li>Áw ká wideyo dɔ́ tà ni áw ká tèlefɔni yé, <strong>à kànâ tɛ̀mɛ míniti 3 kàn</strong></li>
                  <li>Áw ká áw ká pórozɛ jìra : áw bɛ́ gɛ̀lɛya mîn ɲɛ́nabɔ àní áw ká fɛ̀ɛrɛ</li>
                  <li>Nimɔrɔ mîn bɛ́nà dí áw mà kúlu kɔ́nɔ, áw ká áw ká wideyo cí ò kàn</li>
                </ol>
              </div>
            </div>

            <div class="bg-gradient-to-br from-emerald-50/90 via-white to-emerald-50/50 p-4 sm:p-5 rounded-2xl border-2 border-emerald-300 flex items-center gap-4 shadow-xs">
              <PremiumIcon name="success" size={56} variant="emerald" class="shrink-0" />
              <div class="min-w-0">
                <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1">Sàra t'à lá</h2>
                <p class="text-xs sm:text-sm text-stone-700 m-0">Áw tɛ́ wári sí sàra kà áw sèn dòn à lá. À dáyɛ̀lɛlen bɛ́ Mali fúnankɛ pórozɛtigiw bɛ́ɛ yé.</p>
              </div>
            </div>

            <div class="bg-white p-4 rounded-xl border-2 border-amber-300/80">
              <h2 class="text-sm font-black text-stone-900 mb-3">💬 Áw ká dòn kúluw kɔ́nɔ</h2>
              <div class="flex flex-col sm:flex-row gap-3">
                <a href={translatedWhatsappGroupUrl} target="_blank" rel="noopener noreferrer" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 px-4 rounded-xl text-center text-xs no-underline transition-colors">Dòn WhatsApp kɔ́nɔ</a>
                <a href={campaign.community.telegramGroupUrl || "https://t.me/malijob_innovation"} target="_blank" rel="noopener noreferrer" class="flex-1 bg-sky-600 hover:bg-sky-700 text-white font-bold py-2.5 px-4 rounded-xl text-center text-xs no-underline transition-colors">Dòn Telegram kɔ́nɔ</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- N'KO -->
      <section id="nko" dir="rtl" lang="nqo" class="bg-white rounded-3xl border border-amber-200 shadow-sm mb-8 scroll-mt-20">
        <div class="p-6 sm:p-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200/60 mb-4">ߒߞߏ</div>
          <h1 class="text-2xl sm:text-3xl font-black text-stone-900 font-title leading-tight mb-1">ߡߊ߬ߟߌ ߖߐߔ (ߡߊ߬ߟߌ ߓߊ߯ߙߊ߫ ߞߏ) ߞߎ߲߬ߦߌ߬ߙߊ߬ߟߌ ߢߐ߲߯ߘߊ߲ߓߊ</h1>
          <p class="text-base font-bold text-orange-600 mb-3">ߛߋߝߊ ߥߊ߯ ߂߀ <bdi dir="ltr">(100&nbsp;000&nbsp;FCFA)</bdi> × ߃ + ߖߊ߬ߕߋ߬ߛߌ߰ ߁߀ ߡߍ߲ ߠߎ߬ ߡߊߦߋߙߋ߲ߣߍ߲</p>

          <!-- BANDEAU DATE LIMITE -->
          <div class="mb-5 flex items-center justify-between gap-2 bg-amber-50 p-3 rounded-xl border border-amber-300 text-xs sm:text-sm font-bold text-stone-800">
            <span class="inline-flex items-center gap-1.5">
              <span>⏱️</span>
              <span>ߕߎ߬ߡߊ ߘߊ߲߭ :</span>
            </span>
            <span class="text-orange-700 font-black">ߣߍߣߍߓߊ ߕߟߋ߬ ߃߀/߂߀߂߆ / ߂߃ߙߋ߲ ߡ ߅߉</span>
          </div>

          <div class="space-y-4">
            <div class="bg-gradient-to-br from-amber-50/90 via-white to-amber-50/50 p-4 sm:p-5 rounded-2xl border-2 border-amber-300 flex items-center gap-4 shadow-xs">
              <PremiumIcon name="money" size={56} variant="gold" class="shrink-0" />
              <div class="min-w-0">
                <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">ߊߟߎ߫ ߓߍߛߋ߫ ߞߊ߬ ߡߍ߲ ߛߐ߬ߘߐ߲߬</h2>
                <ul class="text-xs sm:text-sm text-stone-700 space-y-1 list-disc ps-4">
                  <li><strong>ߡߐ߰ ߃ ߝߟߐ߫ ߡߍ߲ ߠߎ߫ ߡߊߣߊ߬ ߛߎߘߊ߲߫ :</strong> ߛߋߝߊ ߥߊ߯ ߂߀ <bdi dir="ltr">(100&nbsp;000&nbsp;FCFA)</bdi> ߓߍߣߊ߬ ߘߴߊ߬ߟߎ߫ ߞߋߟߋ߲߫-ߞߋߟߋ߲߫ ߡߊ߬ ߛߊ߫ ߞߵߊ߬ߟߎ߬ ߟߊ߫ ߖߊ߬ߕߋ߬ߛߌ߰ ߟߎ߬ ߓߐߢߟߊ߫</li>
                  <li><strong>ߖߊ߬ߕߋ߬ߛߌ߰ ߁߀</strong> ߓߍߣߊ߬ ߟߊߖߍ߲ߛߍ߲߫ ߡߊ߬ߟߌ ߖߐߔ ߞߐߜߍ߫ ߓߟߏߡߊߞߊ߬ߣߍ߲ ߞߊ߲߬ ߛߊ߫ ߒ߬ ߞߏߢߐ߲߮ ߠߎ߬ ߣߌ߫ ߖߐ߰ߣߍ߲߬ߦߊ߬ߟߊ ߟߎ߬ ߦߴߊ߬ ߡߊߝߟߍ߫</li>
                </ul>
              </div>
            </div>

            <div class="bg-gradient-to-br from-stone-50 via-white to-stone-50/60 p-4 sm:p-5 rounded-2xl border-2 border-stone-200 flex items-center gap-4 shadow-xs">
              <PremiumIcon name="video" size={56} variant="river" class="shrink-0" />
              <div class="min-w-0">
                <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">ߌ ߓߍߛߋ߫ ߞߊ߬ ߕߍ߬ߘߍ߫ ߊ߬ ߘߐ߫ ߘߌ߬ ؟</h2>
                <ol class="text-xs sm:text-sm text-stone-700 space-y-1 list-decimal ps-4">
                  <li>ߌ ߓߍ߫ ߘߎ߰ߡߊ߬ ߛߘߌ߬ߜߋ߲ ߢߌ߲߬ ߛߐ߲߬ߞߌ߲߫ ߛߊ߫ ߞߊ߬ ߘߏ߲߬ ߒ߬ ߠߊ߫ ߥߛߊߔ ߞߙߎ ߘߐ߫ ߥߟߊ߫ ߕߟߋߞߙߊߡ ߞߙߎ ߘߐ߫</li>
                  <li>ߌ ߖߍ߬ߘߍ߫ ߖߌ߰ߦߊ߬ߖߟߎ߬ߦߊ߬ ߌ ߟߊ߫ ߜߋߟߋ߲ߜߋߟߋ߲ ߠߊ߫ ߞߵߌ ߟߊ߫ ߖߊ߬ߕߋ߬ߛߌ߮ ߢߊߝߐ߫ ߞߵߏ߬ ߗߌ߫ ߊ߲ ߡߊ߬ ߒߞߵߊ߬ ߞߊߣߊ߬ ߕߊ߬ߡߌ߲߫ ߡߌ߬ߛߍ߲߫ ߃ ߞߊ߲߬</li>
                  <li>ߊߟߎ߫ ߦߴߊߟߎ߫ ߟߊ߫ ߖߊ߬ߕߋ߬ߛߌ߰ ߟߎ߬ ߡߊߦߌ߬ߘߊ߬ : ߊߟߎ߫ ߓߍ߫ ߝߙߋߞߋ߫ ߡߍ߲ ߠߎ߫ ߘߊ߲ߘߊ߫ ߊ߬ ߣߴߊߟߎ߫ ߟߊ߫ ߝߍ߰ߙߍ ߟߎ߬</li>
                  <li>ߊ߲ ߞߊ߬ ߝߙߍߕߍ ߡߍ߲ ߓߌ߬ߟߊ߬ ߞߙߎ ߞߊ߲߬ ߌ ߟߊ߫ ߖߌ߰ߦߊ߬ߖߟߎ߬ߦߊ ߗߌ߫ ߏ߬ ߞߊ߲߬</li>
                </ol>
              </div>
            </div>

            <div class="bg-gradient-to-br from-emerald-50/90 via-white to-emerald-50/50 p-4 sm:p-5 rounded-2xl border-2 border-emerald-300 flex items-center gap-4 shadow-xs">
              <PremiumIcon name="success" size={56} variant="emerald" class="shrink-0" />
              <div class="min-w-0">
                <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1">ߝߌߛߙߌ ߟߋ߬</h2>
                <p class="text-xs sm:text-sm text-stone-700 m-0">ߛߊ߫ ߞߊ߬ ߕߍ߬ߘߍ߫ ߊ߬ ߘߐ߫ ߖߐ߰ߣߍ߲߬ ߝߏߛߌ߫ ߕߍ߫ ߛߙߊ߬. ߊ߬ ߘߊߦߟߍ߬ߣߍ߲߫ ߡߊ߬ߟߌ ߝߎߣߎ߲ߞߋ ߖߊ߬ߕߋ߬ߛߌ߮ ߡߊߟߐ߲ߓߊ߮ ߓߍ߯ ߦߋ߫.</p>
              </div>
            </div>

            <div class="bg-white p-4 rounded-xl border-2 border-amber-300/80">
              <h2 class="text-sm font-black text-stone-900 mb-3">💬 ߊߟߎ߫ ߦߋ߫ ߦߟߍ߬ ߞߙߎ ߟߎ߫ ߞߊ߲߬</h2>
              <div class="flex flex-col sm:flex-row gap-3">
                <a href={translatedWhatsappGroupUrl} target="_blank" rel="noopener noreferrer" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 px-4 rounded-xl text-center text-xs no-underline transition-colors">WhatsApp</a>
                <a href={campaign.community.telegramGroupUrl || "https://t.me/malijob_innovation"} target="_blank" rel="noopener noreferrer" class="flex-1 bg-sky-600 hover:bg-sky-700 text-white font-bold py-2.5 px-4 rounded-xl text-center text-xs no-underline transition-colors">Telegram</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="text-center mb-8">
        <a href={`/concours/${campaign.slug}`} class="text-xs font-bold text-stone-500 hover:text-stone-800 no-underline inline-flex items-center gap-1">
          <span>←</span>
          <span>Voir la page complète du concours (français)</span>
        </a>
      </div>
    </div>
  </main>

  <Footer serviceName={siteConfig.title} serviceTagline="un dispositif de l'APEJ"
    slot="footer"
    institution={siteConfig.institution}
    partnerLogos={footerLogos}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>