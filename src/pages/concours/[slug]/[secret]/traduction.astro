---
export const prerender = false;

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import MinimalHeader from "../../../../components/MinimalHeader.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import PremiumIcon from "../../../../components/PremiumIcon.astro";
import siteConfig from "../../../../../site.config.json";
import campaignsData from "../../../../data/campaigns.json";

const { slug, secret } = Astro.params;
const allCampaigns = campaignsData.campaigns || [];
let campaign: any = allCampaigns.find((c: any) => c.slug === slug);

if (!campaign && (slug === "innovation-2026" || slug === "innovation-2026-c1")) {
  campaign = allCampaigns.find((c: any) => c.slug === "innovation-2026-c1" || c.slug === (siteConfig as any).activeCampaignSlug);
}

if (!campaign) {
  return Astro.redirect(`/concours/${(siteConfig as any).activeCampaignSlug || "innovation-2026-c1"}`);
}

if (secret !== campaign.secretToken) {
  return Astro.redirect(`/concours/${campaign.slug}`);
}

const cleanPhone = (campaign.submission.juryWhatsappNumber || "").replace(/[^0-9]/g, "");
const waUrl = `https://wa.me/${cleanPhone}`;
const tgUrl = `https://t.me/${cleanPhone}`;

const footerLogos = [
  { src: "/images/logo-apej.svg", alt: "APEJ Mali" },
  { src: "/images/logo-eoj.svg", alt: "EOJ Mali" },
  { src: "/images/logo-particip.png", alt: "PartiCIP" },
];
---

<BaseLayout title={`Consignes simplifiées — Concours Mali Job`}
  description="Simplified multilingual secret instructions page."
>
  <MinimalHeader slot="header" />

  <main class="py-8 sm:py-12 bg-stone-50 min-h-screen">
    <div class="ml-container max-w-4xl mx-auto px-4">

      <div class="mb-4 rounded-2xl bg-stone-900 text-amber-300 p-4 text-xs font-bold flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-md border border-amber-400/30">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-stone-200">Lien réservé aux membres de la communauté</span>
        </div>
        <div class="inline-flex items-center gap-2 bg-stone-800/90 px-3 py-1.5 rounded-xl border border-stone-700">
          <span class="text-stone-300">Période de candidature :</span>
          <strong class="text-amber-300 font-black text-xs sm:text-sm whitespace-nowrap">19 au 30 Novembre 2026</strong>
        </div>
      </div>

      <!-- BANDEAU DÉPÔT OUVERT & DATE LIMITE -->
      <div
        class="mb-6 rounded-3xl bg-gradient-to-br from-emerald-600 via-emerald-700 to-teal-800 p-5 sm:p-7 text-white shadow-lg border-2 border-emerald-400 relative overflow-hidden"
      >
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-5 text-center md:text-left">
          <div class="max-w-xl">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-black/20 text-emerald-200 border border-emerald-300/30 mb-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Candidatures ouvertes</span>
            </span>
            <h2 class="text-xl sm:text-2xl font-black font-title leading-tight text-white mb-1.5">
              Envoyez votre vidéo avant le {campaign.submission.deadline}
            </h2>
            <p class="text-xs sm:text-sm text-emerald-100 m-0 leading-relaxed">
              Le numéro direct du jury est actif. Tournez simplement votre vidéo de 3 minutes chrono sur votre téléphone et envoyez-la dès maintenant sur WhatsApp ou Telegram.
            </p>
          </div>

          <!-- Rappel de clôture -->
          <div class="bg-stone-900/90 backdrop-blur-sm rounded-2xl p-4 sm:p-5 border border-emerald-400/40 text-center shrink-0 w-full md:w-auto shadow-inner">
            <div class="text-xs font-black uppercase tracking-wider text-emerald-300 mb-1">Clôture des dépôts</div>
            <div class="text-lg sm:text-xl font-black text-white">30 Novembre 2026</div>
            <div class="text-xs font-bold text-amber-300 mt-0.5">à 23h59 précises</div>
          </div>
        </div>
      </div>

      <!-- Language tabs -->
      <div class="flex gap-2 mb-6 border-b border-stone-200 pb-2">
        <a href="#fr" class="px-3 py-1.5 rounded-t-lg text-xs font-bold bg-white border border-stone-200 text-stone-900 no-underline">Français</a>
        <a href="#bm" class="px-3 py-1.5 rounded-t-lg text-xs font-bold bg-amber-50 border border-amber-200 text-stone-700 no-underline">Bamanankan</a>
        <a href="#nko" class="px-3 py-1.5 rounded-t-lg text-xs font-bold bg-amber-50 border border-amber-200 text-stone-700 no-underline">ߒߞߏ</a>
      </div>

      <!-- FRANÇAIS -->
      <section id="fr" class="bg-white rounded-3xl border border-stone-200 shadow-sm mb-8 scroll-mt-20">
        <div class="p-6 sm:p-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-orange-100 text-orange-800 border border-orange-200/60 mb-4">Français</div>
          <h1 class="text-2xl sm:text-3xl font-black text-stone-900 font-title mb-4">Envoyez votre vidéo au jury</h1>

          <div class="bg-gradient-to-br from-amber-50/90 via-white to-amber-50/50 p-4 sm:p-5 rounded-2xl border-2 border-amber-300 mb-4 flex items-center gap-4 shadow-xs">
            <PremiumIcon name="money" size={56} variant="gold" class="shrink-0" />
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">Ce que vous pouvez gagner</h2>
              <ul class="text-xs sm:text-sm text-stone-700 space-y-1 list-disc pl-4">
                <li><strong class="whitespace-nowrap">{campaign.prizes.grandPrizeCount} Grands Prix de&nbsp;{campaign.prizes.grandPrizeAmount}</strong> chacun en appui de lancement ou d'accélération</li>
                <li><strong>{campaign.prizes.laureateCount} projets</strong> mis en valeur sur Mali Job</li>
              </ul>
            </div>
          </div>

          <div class="bg-gradient-to-br from-stone-50 via-white to-stone-50/60 p-4 sm:p-5 rounded-2xl border-2 border-stone-200 mb-5 flex items-center gap-4 shadow-xs">
            <PremiumIcon name="video" size={56} variant="river" class="shrink-0" />
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">Comment envoyer votre vidéo</h2>
              <ol class="text-xs sm:text-sm text-stone-700 space-y-1 list-decimal pl-4">
                <li>Filmez-vous en <strong>moins de 3 minutes</strong> avec votre téléphone</li>
                <li>Dites : votre nom, votre projet, le problème que vous résolvez, et à quoi servira l'argent</li>
                <li>Envoyez la vidéo au numéro ci-dessous sur WhatsApp ou Telegram</li>
                <li>Ajoutez vos nom, prénom, ville et un numéro où vous joindre</li>
              </ol>
            </div>
          </div>

          <!-- Numéro direct -->
          <div class="bg-stone-900 rounded-xl p-5 border border-amber-400/30 text-center mb-4">
            <p class="text-xs text-amber-300 font-bold uppercase tracking-wider mb-1">Numéro du jury</p>
            <p class="text-3xl sm:text-4xl font-black text-white tracking-wider">{campaign.submission.juryWhatsappDisplay}</p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-5 rounded-xl text-center text-sm no-underline transition-colors shadow-md">📱 Envoyer sur WhatsApp</a>
            <a href={tgUrl} target="_blank" rel="noopener noreferrer" class="flex-1 bg-sky-600 hover:bg-sky-700 text-white font-bold py-3 px-5 rounded-xl text-center text-sm no-underline transition-colors shadow-md">✈️ Envoyer sur Telegram</a>
          </div>
        </div>
      </section>

      <!-- BAMANANKAN -->
      <section id="bm" lang="bm" class="bg-white rounded-3xl border border-amber-200 shadow-sm mb-8 scroll-mt-20">
        <div class="p-6 sm:p-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200/60 mb-4">Bamanankan</div>
          <h1 class="text-2xl sm:text-3xl font-black text-stone-900 font-title mb-4">Áw ká áw ká wideyo cí súgandilaw mà</h1>

          <div class="bg-gradient-to-br from-amber-50/90 via-white to-amber-50/50 p-4 sm:p-5 rounded-2xl border-2 border-amber-300 mb-4 flex items-center gap-4 shadow-xs">
            <PremiumIcon name="money" size={56} variant="gold" class="shrink-0" />
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">Áw bɛ́ sé kà mîn sɔ̀rɔ</h2>
              <ul class="text-xs sm:text-sm text-stone-700 space-y-1 list-disc pl-4">
                <li><strong>Mɔ̀gɔ 3 fɔ́lɔ mínnu bɛ́ sé sɔ̀rɔ :</strong> <strong class="whitespace-nowrap">wáa 20 (100&nbsp;000&nbsp;FCFA)</strong> bɛ́ dí ù kélen-kélen bɛ́ɛ mà wálasa kà pórozɛ dámìnɛ wàlímà k'à láteliya</li>
                <li><strong>Pórozɛ 10</strong> bɛ́nà jìra kɛ́nɛ kàn Mali Job ká siti kàn</li>
              </ul>
            </div>
          </div>

          <div class="bg-gradient-to-br from-stone-50 via-white to-stone-50/60 p-4 sm:p-5 rounded-2xl border-2 border-stone-200 mb-5 flex items-center gap-4 shadow-xs">
            <PremiumIcon name="video" size={56} variant="river" class="shrink-0" />
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">Áw bɛ́ sé kà áw ká wideyo cí cógo dì?</h2>
              <ol class="text-xs sm:text-sm text-stone-700 space-y-1 list-decimal pl-4">
                <li>Áw ká wideyo dɔ́ tà ni áw ká tèlefɔni yé, <strong>à kànâ tɛ̀mɛ míniti 3 kàn</strong></li>
                <li>Áw ká nìn fɔ́ : áw tɔ́gɔ, áw ká pórozɛ, áw bɛ́ gɛ̀lɛya mîn ɲɛ́nabɔ, àní áw bɛ́nà mùn kɛ́ ni wári yé</li>
                <li>Nimɔrɔ mîn bɛ́ dùguma, áw ká áw ká wideyo cí ò kàn WhatsApp wàlímà Telegram fɛ̀</li>
                <li>Áw ká nìn fàra à kàn : áw tɔ́gɔ ni áw jàmu, áw ká dùgu, àní nimɔrɔ mîn ná án bɛ́ sé kà áw sɔ̀rɔ</li>
              </ol>
            </div>
          </div>

          <div class="bg-stone-900 rounded-xl p-5 border border-amber-400/30 text-center mb-4">
            <p class="text-xs text-amber-300 font-bold uppercase tracking-wider mb-1">Súgandilaw ká nimɔrɔ</p>
            <p class="text-3xl sm:text-4xl font-black text-white tracking-wider">{campaign.submission.juryWhatsappDisplay}</p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-5 rounded-xl text-center text-sm no-underline transition-colors shadow-md">📱 À cí WhatsApp kàn</a>
            <a href={tgUrl} target="_blank" rel="noopener noreferrer" class="flex-1 bg-sky-600 hover:bg-sky-700 text-white font-bold py-3 px-5 rounded-xl text-center text-sm no-underline transition-colors shadow-md">✈️ À cí Telegram kàn</a>
          </div>
        </div>
      </section>

      <!-- N'KO -->
      <section id="nko" dir="rtl" lang="nqo" class="bg-white rounded-3xl border border-amber-200 shadow-sm mb-8 scroll-mt-20">
        <div class="p-6 sm:p-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200/60 mb-4">ߒߞߏ</div>
          <p class="text-sm font-bold text-orange-600 mb-1">ߡߊ߬ߟߌ ߖߐߔ (ߡߊ߬ߟߌ ߓߊ߯ߙߊ߫ ߞߏ) ߞߎ߲߬ߦߌ߬ߙߊ߬ߟߌ ߢߐ߲߯ߘߊ߲ߓߊ</p>
          <h1 class="text-2xl sm:text-3xl font-black text-stone-900 font-title mb-4">ߌ ߞߊ߫ ߡߍ߲ߕߊ ߦߋߕߊ ߗߌ߫ ߖߟߊߕߞߍߓߊ߮ ߎ߬ ߡߊ߬.</h1>

          <div class="bg-gradient-to-br from-amber-50/90 via-white to-amber-50/50 p-4 sm:p-5 rounded-2xl border-2 border-amber-300 mb-4 flex items-center gap-4 shadow-xs">
            <PremiumIcon name="money" size={56} variant="gold" class="shrink-0" />
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">ߌ ߓߴߛߋ߫ ߞߊ߬ ߡߌ߲ ߛߐ߬ߙߐ߲߬</h2>
              <ul class="text-xs sm:text-sm text-stone-700 space-y-1 list-disc ps-4">
                <li><strong>ߛߋߝߊ߫ ߥߊ߯ ߂߀ <bdi dir="ltr">(100&nbsp;000&nbsp;FCFA)</bdi> ߞߎ߲߬ߢߊ߬ߘߐ߬ߓߊ߫ ߃ :</strong> ߓߍ߯ ߓߴߛߋ߫ ߞߊ߬ ߡߌ߲ ߛߐ߬ߙߐ߲߬ ߓߊ߯ߙߊ ߘߊߡߌ߬ߣߊ߬ߟߌ ߟߊ߫ ߥߟߴߊ߬ ߟߊߕߋߟߌߦߊߟߌ ߟߊ߫.</li>
                <li><strong>ߜߙߋ߬ߡߊߕߍ߰ߕߊ߫ ߁߀</strong> ߓߍ߫ ߟߊߡߐ߲߬ߧߊ߬ ߡߊ߬ߟߌ ߖߐߔ (ߡߊ߬ߟߌ ߓߊ߯ߙߊ߫ ߞߏ) ߓߟߏ߫.</li>
              </ul>
            </div>
          </div>

          <div class="bg-gradient-to-br from-stone-50 via-white to-stone-50/60 p-4 sm:p-5 rounded-2xl border-2 border-stone-200 mb-5 flex items-center gap-4 shadow-xs">
            <PremiumIcon name="video" size={56} variant="river" class="shrink-0" />
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-black text-stone-900 mb-1.5">ߌ ߞߊ߫ ߡߍ߲ߕߊ ߦߋߕߊ ߗߌ߫ ߗߞߏߦߊ.</h2>
              <ol class="text-xs sm:text-sm text-stone-700 space-y-1 list-decimal ps-4">
                <li>ߌ ߖߌ߬ߦߊ߬ߖߟߎ ߘߏ߫ ߞߍ߫ ߌ ߞߊ߲߬ ߸ ߊ߬ ߘߞߐߦߊߟߋ߲ ߞߊ߫ ߞߍ߫ ߡߌ߬ߛߍ߲߫ ߃ ߦߋ߫.</li>
                <li>ߞߊ߬ ߣߌ߲߬ ߠߎ߬ ߝߐ߫ : ߌ ߕߐ߮ ߸ ߌ ߞߊ߫ ߜߙߋ߬ߡߊ߬ߕߞߍߕߊ ߸ ߌ ߞߊ߫ ߝߙߋߞߋ ߝߏߣߌ߲ߕߊ ߊ߬ ߣߌ߫ ߥߊߙߌ ߘߌߟߋ߲ ߢߊ߬ߞߏ ߌ ߞߊ߫ ߓߊ߯ߙߊ ߟߊ߫.</li>
                <li>ߖߌ߬ߦߊ߬ߖߟߎ ߗߌ߫ ߥߛߊߔ ߥߟߊ߫ ߕߟߋߜߙߊߡ ߝߍ߬ ߝߙߍߕߍ ߞߏߝߐߟߋ߲ ߠߎ߬ ߞߊ߲߬.</li>
                <li>ߣߌ߲߬ ߠߎ߬ ߝߊ߬ߙߴߊ߬ ߞߊ߲߬ : ߌ ߕߐ߮ ߸ ߌ ߖߊ߬ߡߎ߲ ߸ ߛߏ ߊ߬ ߣߌ߫ ߝߙߍߕߍ ߌ ߓߍ߫ ߛߐߙߐ߲߫ ߡߌ߲ ߠߊ߫.</li>
              </ol>
            </div>
          </div>

          <div class="bg-stone-900 rounded-xl p-5 border border-amber-400/30 text-center mb-4">
            <p class="text-xs text-amber-300 font-bold uppercase tracking-wider mb-1">ߖߟߊߕߞߍߟߊ ߞߊ߫ ߝߙߍߕߍ</p>
            <p dir="ltr" class="text-3xl sm:text-4xl font-black text-white tracking-wider">{campaign.submission.juryWhatsappDisplay}</p>
            <p dir="ltr" class="text-sm font-bold text-stone-300 mt-1">+߂߂߃ ߇߀߅߁߄߀߄߀</p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-5 rounded-xl text-center text-sm no-underline transition-colors shadow-md">WhatsApp</a>
            <a href={tgUrl} target="_blank" rel="noopener noreferrer" class="flex-1 bg-sky-600 hover:bg-sky-700 text-white font-bold py-3 px-5 rounded-xl text-center text-sm no-underline transition-colors shadow-md">Telegram</a>
          </div>
        </div>
      </section>

      <div class="text-center mb-8">
        <a href={`/concours/${campaign.slug}/simple`} class="text-xs font-bold text-stone-500 hover:text-stone-800 no-underline inline-flex items-center gap-1">
          <span>←</span>
          <span>Retour à la page simplifiée du concours</span>
        </a>
      </div>
    </div>
  </main>

  <Footer serviceName={siteConfig.title} serviceTagline="un dispositif de l'APEJ"
    slot="footer"
    institution={siteConfig.institution}
    partnerLogos={footerLogos}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>