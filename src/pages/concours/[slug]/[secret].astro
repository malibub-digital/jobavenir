---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import MinimalHeader from "../../../components/MinimalHeader.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import siteConfig from "../../../../site.config.json";
import campaignsData from "../../../data/campaigns.json";

const { slug, secret } = Astro.params;
const allCampaigns = campaignsData.campaigns || [];
let campaign = allCampaigns.find((c) => c.slug === slug);

// Rétrocompatibilité : si l'URL demandée est l'ancien slug 'innovation-2026', on fait correspondre avec la campagne active ou 'innovation-2026-c1'
if (!campaign && (slug === "innovation-2026" || slug === "innovation-2026-c1")) {
  campaign = allCampaigns.find((c) => c.slug === "innovation-2026-c1" || c.slug === (siteConfig as any).activeCampaignSlug);
}

if (!campaign) {
  return Astro.redirect(`/concours/${(siteConfig as any).activeCampaignSlug || "innovation-2026-c1"}`);
}

// Vérification du token secret de la page : si l'URL n'est pas exacte, on renvoie vers la page publique du concours
if (secret !== campaign.secretToken) {
  return Astro.redirect(`/concours/${campaign.slug}`);
}

const cleanWhatsappPhone = (campaign.submission.juryWhatsappNumber || "").replace(/[^0-9]/g, "");
const whatsappDirectUrl = `https://wa.me/${cleanWhatsappPhone}?text=${encodeURIComponent(
  campaign.submission.juryWhatsappPrefill || "Bonjour Mali Job, voici ma vidéo de candidature :"
)}`;

const footerLogos = [
  { src: "/images/logo-apej.svg", alt: "APEJ Mali - Agence Pour la Promotion de l'Emploi des Jeunes" },
  { src: "/images/logo-eoj.svg", alt: "EOJ Mali - Espace d'Orientation Jeunesse" },
  { src: "/images/logo-particip.png", alt: "PartiCIP - Partenaire d'accompagnement & insertion" },
];

const siteUrl = (Astro.site?.origin || (siteConfig as any).siteUrl || "https://job.malihub.digital").replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageJpg = `${siteUrl}/images/og-concours-candidature-video.jpg`;
const pageTitle = `Consignes de candidature vidéo — ${campaign.title} | ${siteConfig.title}`;
const teaserDescription = `Déposez votre vidéo de 3 minutes chrono avant le ${campaign.submission.deadline}. 3 × 100 000 FCFA & 10 vitrines officielles offertes !`;
---

<BaseLayout
  title={pageTitle}
  description={teaserDescription}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow" />

    <meta property="og:site_name" content="Mali Job" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={teaserDescription} />
    <meta property="og:image" content={ogImageJpg} />
    <meta property="og:image:secure_url" content={ogImageJpg} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Candidature vidéo au Concours d'Innovation Mali Job 2026" />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={teaserDescription} />
    <meta name="twitter:image" content={ogImageJpg} />
  </Fragment>

  <MinimalHeader slot="header" />

  <main class="py-8 sm:py-12 bg-gradient-to-b from-amber-50/60 via-stone-50 to-white min-h-screen">
    <div class="ml-container max-w-3xl mx-auto px-4">
      <!-- Badge discret date limite -->
      <div class="mb-4 rounded-xl bg-stone-900 text-amber-300 px-4 py-2.5 text-xs font-bold flex items-center justify-between gap-2 shadow-sm">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Accès privé WhatsApp / Telegram</span>
        </span>
        <span class="text-stone-300">Date limite : <strong class="text-white">{campaign.submission.deadline}</strong></span>
      </div>

      <!-- Bloc principal -->
      <div class="bg-white rounded-3xl p-5 sm:p-8 border border-stone-200 shadow-sm mb-6">
        <!-- Titre direct et percutant -->
        <div class="text-center sm:text-left mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-950 border border-amber-300 mb-3">
            <i class="ml-icon-video-chat-fill ml-icon--xs"></i>
            <span>Dépôt de candidature</span>
          </span>
          <h1 class="text-2xl sm:text-3xl font-black text-stone-900 font-title leading-tight mb-2">
            Votre vidéo en 3 minutes chrono ⏱️
          </h1>
          <p class="text-sm sm:text-base text-stone-600 m-0">
            {campaign.submission.introText}
          </p>
        </div>

        <!-- RAPPEL CLAIR : LES RÉCOMPENSES -->
        <div class="rounded-2xl bg-stone-900 text-white p-4 sm:p-5 mb-6 border border-amber-400/30">
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-amber-300">
              <i class="ml-icon-trophy-line ml-icon--xs"></i>
              <span>Ce qu'il y a à gagner</span>
            </span>
            <a
              href={campaign.prizes.modelArticleUrl}
              target="_blank"
              class="shrink-0 px-2.5 py-1 rounded-lg bg-amber-400 hover:bg-amber-300 text-stone-950 text-[11px] font-black no-underline inline-flex items-center gap-1 transition-colors"
            >
              <span>Voir un exemple de page</span>
              <span>&rarr;</span>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10 flex items-start gap-2.5">
              <span class="text-base leading-none">🌟</span>
              <div>
                <strong class="text-emerald-300 block mb-0.5">10 projets lauréats mis en valeur</strong>
                <p class="text-stone-300 text-xs m-0 leading-relaxed">
                  Votre projet rédigé et publié sur Mali Job avec une page officielle pour vous faire connaître et convaincre des partenaires.
                </p>
              </div>
            </div>

            <div class="p-3 rounded-xl bg-amber-400/10 border border-amber-400/30 flex items-start gap-2.5">
              <span class="text-base leading-none">💰</span>
              <div>
                <strong class="text-amber-300 block mb-0.5">3 Grands Prix : 100 000 FCFA chacun</strong>
                <p class="text-stone-300 text-xs m-0 leading-relaxed">
                  Les 3 meilleurs projets reçoivent en plus une aide directe de 100 000 FCFA cash pour faire décoller leur activité.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- LES 4 POINTS : VISUEL ULTRA SIMPLE -->
        <div class="mb-6">
          <h2 class="text-base sm:text-lg font-black text-stone-900 font-title mb-3 flex items-center gap-2">
            <span>4 questions simples à dire dans la vidéo :</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {campaign.submission.videoQuestions.map((q: any) => (
              <div class="p-3.5 rounded-2xl bg-amber-50/60 border border-amber-200/80">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-orange-600 text-white text-xs font-black">
                    {q.step}
                  </span>
                  <h3 class="text-sm font-extrabold text-stone-900 m-0">
                    {q.title}
                  </h3>
                </div>
                <p class="text-xs text-stone-600 m-0 leading-snug">
                  {q.prompt}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- CONSEILS COURTS -->
        <div class="rounded-xl bg-stone-100 p-3.5 mb-6 text-xs text-stone-700 flex flex-col sm:flex-row gap-2 sm:gap-4 sm:items-center">
          <span class="font-extrabold text-stone-900 shrink-0 inline-flex items-center gap-1">
            💡 <span>Conseils :</span>
          </span>
          <div class="flex flex-wrap gap-x-4 gap-y-1">
            {campaign.submission.tips.map((tip: string) => (
              <span class="inline-flex items-center gap-1.5">
                <span class="text-orange-500 font-bold">•</span>
                <span>{tip}</span>
              </span>
            ))}
          </div>
        </div>

        <!-- BOUTONS D'ACTION WHATSAPP / TELEGRAM EN GRAND -->
        <div class="rounded-2xl bg-emerald-950 text-white p-5 sm:p-6 text-center border-2 border-emerald-500/40">
          <h2 class="text-lg sm:text-xl font-black font-title text-white mb-1.5">
            Prêt ? Envoyez votre vidéo ici :
          </h2>
          <p class="text-xs text-stone-300 mb-4 max-w-md mx-auto">
            Envoyez votre vidéo avec vos <strong>Nom, Prénom, Titre du projet, Ville</strong> et un <strong>numéro de téléphone joignable</strong> pour que le jury puisse vous recontacter :
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-md mx-auto mb-3">
            <a
              href={whatsappDirectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-emerald-500 hover:bg-emerald-400 text-stone-950 font-black py-3 px-4 rounded-xl shadow transition-all flex items-center justify-center gap-2 no-underline text-sm"
            >
              <i class="ml-icon-whatsapp-line ml-icon--sm"></i>
              <span>WhatsApp Jury</span>
            </a>

            <a
              href={campaign.submission.juryTelegramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-sky-500 hover:bg-sky-400 text-stone-950 font-black py-3 px-4 rounded-xl shadow transition-all flex items-center justify-center gap-2 no-underline text-sm"
            >
              <i class="ml-icon-telegram-line ml-icon--sm"></i>
              <span>Telegram Jury</span>
            </a>
          </div>

          <p class="text-[11px] text-stone-400 m-0">
            Gratuit et sans engagement. Réservé aux membres de la communauté Mali Job.
          </p>
        </div>
      </div>

      <div class="text-center">
        <a
          href={`/concours/${campaign.slug}`}
          class="text-xs font-bold text-stone-500 hover:text-stone-800 no-underline inline-flex items-center gap-1"
        >
          <span>&larr;</span>
          <span>Retour aux informations du concours</span>
        </a>
      </div>
    </div>
  </main>

  <Footer serviceName={siteConfig.title} serviceTagline="un dispositif de l'APEJ"
    slot="footer"
    institution={siteConfig.institution}
    partnerLogos={footerLogos}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
