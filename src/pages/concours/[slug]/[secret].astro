---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import MinimalHeader from "../../../components/MinimalHeader.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import siteConfig from "../../../../site.config.json";
import campaignsData from "../../../data/campaigns.json";

const { slug, secret } = Astro.params;
const allCampaigns = campaignsData.campaigns || [];
const campaign = allCampaigns.find((c) => c.slug === slug);

if (!campaign) {
  return Astro.redirect(`/concours/${(siteConfig as any).activeCampaignSlug || "innovation-2026"}`);
}

// Vérification du token secret de la page : si l'URL n'est pas exacte, on renvoie vers la page publique du concours
if (secret !== campaign.secretToken) {
  return Astro.redirect(`/concours/${campaign.slug}`);
}

const cleanWhatsappPhone = (campaign.submission.juryWhatsappNumber || "").replace(/[^0-9]/g, "");
const whatsappDirectUrl = `https://wa.me/${cleanWhatsappPhone}?text=${encodeURIComponent(
  campaign.submission.juryWhatsappPrefill || "Bonjour Mali Job, voici ma vidéo de candidature :"
)}`;

const footerLogos = [
  { src: "/images/logo-apej.svg", alt: "APEJ Mali - Agence Pour la Promotion de l'Emploi des Jeunes" },
  { src: "/images/logo-eoj.svg", alt: "EOJ Mali - Espace d'Orientation Jeunesse" },
  { src: "/images/logo-particip.png", alt: "PartiCIP - Partenaire d'accompagnement & insertion" },
];
---

<BaseLayout
  title={`Consignes de candidature vidéo — ${campaign.title} | ${siteConfig.title}`}
  description="Page réservée aux membres des groupes WhatsApp et Telegram Mali Job : découvrez comment envoyer votre vidéo de moins de 3 minutes."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow" />
  </Fragment>

  <MinimalHeader slot="header" />

  <main class="py-10 sm:py-14 bg-gradient-to-b from-amber-50/70 via-stone-50 to-white min-h-screen">
    <div class="ml-container max-w-4xl mx-auto px-4">
      <!-- Bandeau d'accès privilégié membres du groupe -->
      <div class="mb-6 rounded-2xl bg-stone-900 text-amber-300 px-4 py-3 text-xs font-bold flex flex-wrap items-center justify-between gap-2 border border-amber-400/30 shadow-sm">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="inline-flex items-center gap-1">
            <i class="ml-icon-lock-fill ml-icon--xs"></i>
            <span>Accès réservé aux membres du groupe WhatsApp / Telegram Mali Job</span>
          </span>
        </div>
        <span class="text-stone-300">Date limite : <strong class="text-white">{campaign.submission.deadline}</strong></span>
      </div>

      <!-- En-tête de la page secrète -->
      <div class="bg-white rounded-3xl p-6 sm:p-10 border-2 border-amber-300/90 shadow-md mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-950 border border-amber-300 mb-3">
          <i class="ml-icon-video-chat-fill ml-icon--xs"></i>
          <span>Guide de participation — {campaign.edition}</span>
        </span>

        <h1 class="text-2xl sm:text-4xl font-black text-stone-900 font-title leading-tight mb-3">
          Comment envoyer votre vidéo de moins de {campaign.submission.maxDurationMinutes} minutes
        </h1>

        <p class="text-sm sm:text-base text-stone-700 leading-relaxed mb-6">
          {campaign.submission.introText}
        </p>

        <!-- RAPPEL DE CE QU'IL Y A À GAGNER + APERÇU VISUEL DU MODÈLE DE PAGE LAURÉAT -->
        <div class="rounded-3xl bg-stone-900 text-white p-5 sm:p-7 border-2 border-amber-400/50 shadow-md mb-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
            <div class="lg:col-span-7">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 border border-amber-400/40 text-xs font-extrabold mb-3">
                <i class="ml-icon-trophy-line ml-icon--xs"></i>
                <span>Ce qu'il y a à gagner</span>
              </div>
              <ul class="text-xs sm:text-sm text-stone-200 font-bold space-y-2 m-0 pl-4 mb-5">
                <li>
                  <strong class="text-amber-300">{campaign.prizes.grandPrizeCount} Grands Prix de {campaign.prizes.grandPrizeAmount}</strong> + mise en avant en une du site officiel.
                </li>
                <li>
                  <strong class="text-emerald-300">{campaign.prizes.laureateCount} places de Lauréats « Vitrine Officielle » :</strong> votre projet rédigé et publié sur Mali Job avec une page dédiée pour communiquer et lever des fonds.
                </li>
              </ul>
              <a
                href={campaign.prizes.modelArticleUrl}
                target="_blank"
                class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-xs sm:text-sm font-black no-underline inline-flex items-center gap-2 shadow-sm transition-all"
              >
                <i class="ml-icon-search-line ml-icon--xs"></i>
                <span>Voir le modèle de page Lauréat</span>
                <span>&rarr;</span>
              </a>
            </div>

            <!-- Aperçu visuel du modèle d'article -->
            <div class="lg:col-span-5">
              <a
                href={campaign.prizes.modelArticleUrl}
                target="_blank"
                class="block bg-white text-stone-900 rounded-2xl p-3.5 border-2 border-amber-300 shadow-sm hover:-translate-y-0.5 transition-all no-underline group"
              >
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-100 text-amber-950 text-[10px] font-black border border-amber-300">
                    <i class="ml-icon-trophy-line ml-icon--xs"></i>
                    <span>Exemple de page Lauréat</span>
                  </span>
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                    Aperçu
                  </span>
                </div>
                <div class="h-24 rounded-xl overflow-hidden mb-2.5 relative bg-stone-100">
                  <img
                    src="/images/categories/agriculture_elevage/01.webp"
                    alt="Aperçu du modèle de page Lauréat"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                  <span class="absolute bottom-1.5 left-2 text-[10px] font-bold text-white inline-flex items-center gap-1">
                    <i class="ml-icon-map-pin-2-line ml-icon--xs"></i>
                    <span>Exemple : SolaFroid Mali</span>
                  </span>
                </div>
                <div class="text-xs font-black text-stone-900 group-hover:text-orange-600 transition-colors mb-1 line-clamp-1">
                  À quoi ressemblera votre page sur Mali Job
                </div>
                <div class="text-[11px] font-extrabold text-orange-600 flex items-center justify-between pt-1.5 border-t border-stone-100">
                  <span>Ouvrir l'exemple</span>
                  <span>&rarr;</span>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- LES 4 QUESTIONS SIMPLES À DIRE DANS LA VIDÉO -->
        <h2 class="text-lg sm:text-xl font-black text-stone-900 font-title mb-4 flex items-center gap-2">
          <i class="ml-icon-file-list-3-line ml-icon--sm text-amber-600"></i>
          <span>Les 4 points simples à aborder dans votre vidéo (&lt; {campaign.submission.maxDurationMinutes} min)</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          {campaign.submission.videoQuestions.map((q: any) => (
            <div class="p-5 rounded-2xl bg-stone-50 border border-stone-200/90 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2.5">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg bg-orange-600 text-white text-xs font-black">
                    Partie {q.step}
                  </span>
                  <span class="text-xs font-bold text-stone-500 bg-white px-2.5 py-0.5 rounded-full border border-stone-200">
                    ⏱️ {q.duration}
                  </span>
                </div>
                <h3 class="text-base font-extrabold text-stone-900 font-title mb-1.5">
                  {q.title}
                </h3>
                <p class="text-xs sm:text-sm text-stone-700 leading-relaxed m-0">
                  {q.prompt}
                </p>
              </div>
            </div>
          ))}
        </div>

        <!-- CONSEILS PRATIQUES SIMPLES -->
        <div class="rounded-2xl bg-stone-100/80 p-5 border border-stone-200 mb-8">
          <div class="text-xs font-black uppercase tracking-wider text-stone-700 mb-2 flex items-center gap-1.5">
            <i class="ml-icon-lightbulb-line ml-icon--xs text-amber-700"></i>
            <span>3 conseils simples avant d'envoyer</span>
          </div>
          <ul class="space-y-1.5 text-xs sm:text-sm text-stone-700 m-0 pl-5">
            {campaign.submission.tips.map((tip: string) => (
              <li>{tip}</li>
            ))}
          </ul>
        </div>

        <!-- ZONE D'ENVOI DE LA VIDÉO AU JURY (WHATSAPP / TELEGRAM) -->
        <div class="rounded-3xl bg-stone-900 text-white p-6 sm:p-8 border-2 border-emerald-400/50 text-center">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs font-extrabold mb-3">
            <i class="ml-icon-cellphone-line ml-icon--xs"></i>
            <span>Dépôt direct de votre candidature</span>
          </span>
          <h2 class="text-xl sm:text-2xl font-black font-title text-white mb-2">
            Où envoyer votre vidéo de moins de {campaign.submission.maxDurationMinutes} minutes ?
          </h2>
          <p class="text-xs sm:text-sm text-stone-300 max-w-xl mx-auto leading-relaxed mb-6">
            Envoyez directement votre vidéo accompagnée de votre <strong>Nom, Prénom, Ville et Titre du projet</strong> au secrétariat du Jury sur WhatsApp ou Telegram :
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl mx-auto mb-5">
            <a
              href={whatsappDirectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-emerald-500 hover:bg-emerald-400 text-stone-950 font-black py-4 px-5 rounded-2xl shadow-lg transition-all flex flex-col items-center justify-center no-underline"
            >
              <span class="text-sm sm:text-base inline-flex items-center gap-1.5">
                <i class="ml-icon-whatsapp-line ml-icon--sm"></i>
                <span>Envoyer sur WhatsApp Jury</span>
              </span>
              <span class="text-xs font-bold opacity-85 mt-0.5">{campaign.submission.juryWhatsappDisplay}</span>
            </a>

            <a
              href={campaign.submission.juryTelegramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-sky-500 hover:bg-sky-400 text-stone-950 font-black py-4 px-5 rounded-2xl shadow-lg transition-all flex flex-col items-center justify-center no-underline"
            >
              <span class="text-sm sm:text-base inline-flex items-center gap-1.5">
                <i class="ml-icon-telegram-line ml-icon--sm"></i>
                <span>Envoyer sur Telegram Jury</span>
              </span>
              <span class="text-xs font-bold opacity-85 mt-0.5">@{campaign.submission.juryTelegramUsername}</span>
            </a>
          </div>

          <p class="text-[11px] text-stone-400 m-0">
            Rappel : vous devez être membre du <a href={campaign.community.whatsappGroupUrl} target="_blank" class="text-amber-300 underline">groupe WhatsApp</a> ou du <a href={campaign.community.telegramGroupUrl} target="_blank" class="text-amber-300 underline">canal Telegram</a> Mali Job pour que votre candidature soit validée.
          </p>
        </div>
      </div>

      <div class="text-center">
        <a
          href={`/concours/${campaign.slug}`}
          class="text-xs font-extrabold text-stone-600 hover:text-orange-600 no-underline inline-flex items-center gap-1.5"
        >
          <span>&larr;</span>
          <span>Retour à la présentation générale de la campagne</span>
        </a>
      </div>
    </div>
  </main>

  <Footer serviceName={siteConfig.title} serviceTagline="un dispositif de l'APEJ"
    slot="footer"
    institution={siteConfig.institution}
    partnerLogos={footerLogos}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
