---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import MinimalHeader from "../../../components/MinimalHeader.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import PremiumIcon from "../../../components/PremiumIcon.astro";
import siteConfig from "../../../../site.config.json";
import campaignsData from "../../../data/campaigns.json";

const { slug, secret } = Astro.params;
const allCampaigns = campaignsData.campaigns || [];
let campaign = allCampaigns.find((c) => c.slug === slug);

// Rétrocompatibilité : si l'URL demandée est l'ancien slug 'innovation-2026', on fait correspondre avec la campagne active ou 'innovation-2026-c1'
if (!campaign && (slug === "innovation-2026" || slug === "innovation-2026-c1")) {
  campaign = allCampaigns.find((c) => c.slug === "innovation-2026-c1" || c.slug === (siteConfig as any).activeCampaignSlug);
}

if (!campaign) {
  return Astro.redirect(`/concours/${(siteConfig as any).activeCampaignSlug || "innovation-2026-c1"}`);
}

// Vérification du token secret de la page : si l'URL n'est pas exacte, on renvoie vers la page publique du concours
if (secret !== campaign.secretToken) {
  return Astro.redirect(`/concours/${campaign.slug}`);
}

const cleanWhatsappPhone = (campaign.submission.juryWhatsappNumber || "").replace(/[^0-9]/g, "");
const whatsappDirectUrl = `https://wa.me/${cleanWhatsappPhone}?text=${encodeURIComponent(
  campaign.submission.juryWhatsappPrefill || "Bonjour Mali Job, voici ma vidéo de candidature :"
)}`;
const telegramDirectUrl = `https://t.me/${cleanWhatsappPhone}`;

const footerLogos = [
  { src: "/images/logo-apej.svg", alt: "APEJ Mali - Agence Pour la Promotion de l'Emploi des Jeunes" },
  { src: "/images/logo-eoj.svg", alt: "EOJ Mali - Espace d'Orientation Jeunesse" },
  { src: "/images/logo-particip.png", alt: "PartiCIP - Partenaire d'accompagnement & insertion" },
];

const siteUrl = (Astro.site?.origin || (siteConfig as any).siteUrl || "https://job.malihub.digital").replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageJpg = `${siteUrl}/images/og-concours-candidature-video.jpg`;
const pageTitle = `Consignes de candidature vidéo — ${campaign.title} | ${siteConfig.title}`;
const teaserDescription = `Déposez votre vidéo de 3 minutes chrono avant le ${campaign.submission.deadline}. 3 × 100 000 FCFA & 10 vitrines officielles offertes !`;
---

<BaseLayout
  title={pageTitle}
  description={teaserDescription}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow" />

    <meta property="og:site_name" content="Mali Job" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={teaserDescription} />
    <meta property="og:image" content={ogImageJpg} />
    <meta property="og:image:secure_url" content={ogImageJpg} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Candidature vidéo au Concours d'Innovation Mali Job 2026" />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={teaserDescription} />
    <meta name="twitter:image" content={ogImageJpg} />
  </Fragment>

  <MinimalHeader slot="header" />

  <main class="py-8 sm:py-12 bg-gradient-to-b from-amber-50/60 via-stone-50 to-white min-h-screen">
    <div class="ml-container max-w-3xl mx-auto px-4">
      <!-- Bandeau statut d'accès & calendrier officiel -->
      <div class="mb-4 rounded-2xl bg-stone-900 text-amber-300 p-4 text-xs font-bold flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-md border border-amber-400/30">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-stone-200">Lien secret réservé aux membres de la communauté</span>
        </div>
        <div class="inline-flex items-center gap-2 bg-stone-800/90 px-3 py-1.5 rounded-xl border border-stone-700">
          <span class="text-stone-300">Période de candidature :</span>
          <strong class="text-amber-300 font-black text-xs sm:text-sm whitespace-nowrap">19 au 30 Novembre 2026</strong>
        </div>
      </div>

      <!-- BANDEAU DÉPÔT OUVERT & DATE LIMITE -->
      <div
        class="mb-6 rounded-3xl bg-gradient-to-br from-emerald-600 via-emerald-700 to-teal-800 p-5 sm:p-7 text-white shadow-lg border-2 border-emerald-400 relative overflow-hidden"
      >
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-5 text-center md:text-left">
          <div class="max-w-xl">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-black/20 text-emerald-200 border border-emerald-300/30 mb-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Candidatures ouvertes</span>
            </span>
            <h2 class="text-xl sm:text-2xl font-black font-title leading-tight text-white mb-1.5">
              Envoyez votre vidéo avant le {campaign.submission.deadline}
            </h2>
            <p class="text-xs sm:text-sm text-emerald-100 m-0 leading-relaxed">
              Le numéro direct du jury est actif. Tournez simplement votre vidéo de 3 minutes chrono sur votre téléphone et envoyez-la dès maintenant sur WhatsApp ou Telegram.
            </p>
          </div>

          <!-- Rappel de clôture -->
          <div class="bg-stone-900/90 backdrop-blur-sm rounded-2xl p-4 sm:p-5 border border-emerald-400/40 text-center shrink-0 w-full md:w-auto shadow-inner">
            <div class="text-xs font-black uppercase tracking-wider text-emerald-300 mb-1">Clôture des dépôts</div>
            <div class="text-lg sm:text-xl font-black text-white">30 Novembre 2026</div>
            <div class="text-xs font-bold text-amber-300 mt-0.5">à 23h59 précises</div>
          </div>
        </div>
      </div>

      <!-- Bloc principal -->
      <div class="bg-white rounded-3xl p-5 sm:p-8 border border-stone-200 shadow-sm mb-6">
        <!-- Titre direct et percutant -->
        <div class="text-center sm:text-left mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-950 border border-amber-300 mb-3">
            <i class="ml-icon-video-chat-fill ml-icon--xs"></i>
            <span>Dépôt de candidature</span>
          </span>
          <h1 class="text-2xl sm:text-3xl font-black text-stone-900 font-title leading-tight mb-2">
            Votre vidéo en 3 minutes chrono ⏱️
          </h1>
          <p class="text-sm sm:text-base text-stone-600 m-0">
            {campaign.submission.introText}
          </p>
        </div>

        <!-- LANGUES ACCEPTÉES -->
        {campaign.submission.languages && (
          <div class="rounded-2xl bg-gradient-to-r from-emerald-50/90 via-white to-emerald-50/40 border-2 border-emerald-300 p-4 sm:p-4.5 mb-4 flex items-center gap-4 shadow-xs">
            <PremiumIcon name="language" size={52} variant="emerald" class="shrink-0" />
            <div class="min-w-0 flex-1">
              <strong class="block text-sm sm:text-base font-black text-emerald-950 mb-0.5">{campaign.submission.languages.label}</strong>
              <p class="text-xs sm:text-sm text-emerald-900 m-0 leading-relaxed">{campaign.submission.languages.text}</p>
            </div>
          </div>
        )}

        <!-- VISAGE NON OBLIGATOIRE -->
        {campaign.submission.faceOptional && (
          <div class="rounded-2xl bg-gradient-to-r from-sky-50/90 via-white to-sky-50/40 border-2 border-sky-300 p-4 sm:p-4.5 mb-6 flex items-center gap-4 shadow-xs">
            <PremiumIcon name="video" size={52} variant="river" class="shrink-0" />
            <div class="min-w-0 flex-1">
              <strong class="block text-sm sm:text-base font-black text-sky-950 mb-0.5">{campaign.submission.faceOptional.label}</strong>
              <p class="text-xs sm:text-sm text-sky-900 m-0 leading-relaxed">{campaign.submission.faceOptional.text}</p>
            </div>
          </div>
        )}

        <!-- RAPPEL CLAIR : LES RÉCOMPENSES -->
        <div class="rounded-2xl bg-stone-900 text-white p-4 sm:p-5 mb-6 border border-amber-400/30">
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-amber-300">
              <i class="ml-icon-trophy-line ml-icon--xs"></i>
              <span>Ce qu'il y a à gagner</span>
            </span>
            <a
              href={campaign.prizes.modelArticleUrl}
              target="_blank"
              data-umami-event="view-model-laureate-page"
              data-umami-event-campaign={campaign.slug}
              class="shrink-0 px-3 py-1.5 rounded-lg bg-amber-400 hover:bg-amber-300 text-stone-950 text-xs font-black no-underline inline-flex items-center gap-1 transition-colors"
            >
              <span>Voir un exemple de page</span>
              <span>&rarr;</span>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-sm">
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-3.5">
              <PremiumIcon name="avatar" size={44} variant="emerald" class="shrink-0" />
              <div class="min-w-0 flex-1">
                <strong class="text-emerald-300 block mb-0.5">10 projets lauréats mis en valeur</strong>
                <p class="text-stone-300 text-xs sm:text-sm m-0 leading-relaxed">
                  Votre projet rédigé et publié sur Mali Job avec une page officielle pour vous faire connaître et convaincre des partenaires.
                </p>
              </div>
            </div>

            <div class="p-3.5 rounded-xl bg-amber-400/10 border border-amber-400/30 flex items-center gap-3.5">
              <PremiumIcon name="money" size={44} variant="gold" class="shrink-0" />
              <div class="min-w-0 flex-1">
                <strong class="text-amber-300 block mb-0.5 whitespace-nowrap">3 Grands Prix : 100&nbsp;000 FCFA chacun</strong>
                <p class="text-stone-300 text-xs sm:text-sm m-0 leading-relaxed">
                  Un appui financier direct de 100&nbsp;000 FCFA pour amorcer votre lancement ou accélérer l'amélioration de votre activité.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- NUMÉRO DIRECT POUR ENVOI -->
        <div class="rounded-2xl bg-stone-900 p-4 sm:p-5 mb-6 border border-amber-400/30">
          <div class="flex items-center gap-2 mb-1">
            <i class="ml-icon-cellphone-line ml-icon--sm text-amber-400"></i>
            <span class="text-sm sm:text-base font-black text-amber-300">Votre contact direct pour le concours</span>
          </div>
          <p class="text-xs sm:text-sm text-stone-300 mb-1.5">Envoyez votre vidéo directement sur WhatsApp ou Telegram au numéro officiel du jury :</p>
          <div class="text-2xl sm:text-3xl font-black text-center text-white bg-amber-400/10 rounded-xl p-3 border border-amber-400/30 tracking-wider">
            {campaign.submission.juryWhatsappDisplay}
          </div>
        </div>

        <!-- LES 4 POINTS : VISUEL ULTRA SIMPLE -->
        <div class="mb-6">
          <h2 class="text-base sm:text-lg font-black text-stone-900 font-title mb-3 flex items-center gap-2">
            <span>4 questions simples à dire dans la vidéo :</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {campaign.submission.videoQuestions.map((q: any) => (
              <div class="p-4 rounded-2xl bg-amber-50/60 border border-amber-200/80">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-orange-600 text-white text-xs font-black">
                    {q.step}
                  </span>
                  <h3 class="text-sm sm:text-base font-extrabold text-stone-900 m-0">
                    {q.title}
                  </h3>
                </div>
                <p class="text-xs sm:text-sm text-stone-600 m-0 leading-relaxed">
                  {q.prompt}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- CONSEILS COURTS -->
        <div class="rounded-xl bg-stone-100 p-4 mb-6 text-xs sm:text-sm text-stone-700 flex flex-col sm:flex-row gap-2 sm:gap-4 sm:items-center">
          <span class="font-extrabold text-stone-900 shrink-0 inline-flex items-center gap-1.5">
            <i class="ml-icon-lightbulb-line text-amber-600"></i>
            <span>Conseils :</span>
          </span>
          <div class="flex flex-wrap gap-x-4 gap-y-1">
            {campaign.submission.tips.map((tip: string) => (
              <span class="inline-flex items-center gap-1.5">
                <span class="text-orange-500 font-bold">•</span>
                <span>{tip}</span>
              </span>
            ))}
          </div>
        </div>

        <!-- BOUTONS D'ACTION WHATSAPP / TELEGRAM EN GRAND -->
        <div class="rounded-2xl bg-emerald-950 text-white p-5 sm:p-6 text-center border-2 border-emerald-500/40">
          <div id="jury-activation-status" class="mb-3 inline-flex items-center gap-2 bg-emerald-400/20 text-emerald-300 px-3 py-1 rounded-full text-xs font-bold border border-emerald-400/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Ligne du jury ouverte</span>
          </div>

          <h2 class="text-lg sm:text-xl font-black font-title text-white mb-1.5">
            Envoyer ma vidéo au jury
          </h2>
          <p class="text-xs sm:text-sm text-stone-300 mb-4 max-w-md mx-auto leading-relaxed">
            Envoyez votre vidéo avec vos <strong>Nom, Prénom, Titre du projet, Ville</strong> et un <strong>numéro téléphone</strong> pour que le jury puisse vous recontacter. Cliquez sur votre application préférée :
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-md mx-auto mb-3">
            <a
              href={whatsappDirectUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="submit-contest-video-whatsapp"
              data-umami-event-campaign={campaign.slug}
              class="bg-emerald-500 hover:bg-emerald-400 text-stone-950 font-black py-3.5 px-4 rounded-xl shadow transition-all flex items-center justify-center gap-2 no-underline text-sm sm:text-base"
            >
              <i class="ml-icon-whatsapp-line ml-icon--sm"></i>
              <span>Envoyer sur WhatsApp</span>
            </a>

            <a
              href={telegramDirectUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="submit-contest-video-telegram"
              data-umami-event-campaign={campaign.slug}
              class="bg-sky-500 hover:bg-sky-400 text-stone-950 font-black py-3.5 px-4 rounded-xl shadow transition-all flex items-center justify-center gap-2 no-underline text-sm sm:text-base"
            >
              <i class="ml-icon-telegram-line ml-icon--sm"></i>
              <span>Envoyer sur Telegram</span>
            </a>
          </div>

          {campaign.submission.confidentiality && (
            <div class="text-xs sm:text-sm text-emerald-200 bg-white/10 rounded-xl p-3.5 max-w-md mx-auto mb-3 leading-snug flex items-center gap-3 text-left">
              <PremiumIcon name="padlock" size={36} variant="stone" class="shrink-0" />
              <span class="min-w-0 flex-1">
                <strong class="text-white">{campaign.submission.confidentiality.label}.</strong> {campaign.submission.confidentiality.text}
              </span>
            </div>
          )}

          <p class="text-xs text-stone-400 m-0">
            Gratuit et sans engagement. Vous recevrez une confirmation sous 48h.
          </p>
        </div>
      </div>

      <div class="text-center">
        <a
          href={`/concours/${campaign.slug}`}
          class="text-xs sm:text-sm font-bold text-stone-500 hover:text-stone-800 no-underline inline-flex items-center gap-1"
        >
          <span>&larr;</span>
          <span>Retour aux informations du concours</span>
        </a>
      </div>
    </div>
  </main>

  <Footer serviceName={siteConfig.title} serviceTagline="un dispositif de l'APEJ"
    slot="footer"
    institution={siteConfig.institution}
    partnerLogos={footerLogos}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
