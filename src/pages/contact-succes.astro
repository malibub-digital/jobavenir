---
import BaseLayout from '@malihub/sites-core/layouts/BaseLayout.astro';
import MinimalHeader from "../components/MinimalHeader.astro";
import Footer from '@malihub/sites-core/components/Footer.astro';
import siteConfig from '../../site.config.json';
---

<BaseLayout title={`Message Envoyé — Confirmation — ${siteConfig.title}`} description="Confirmation d'envoi de votre message à l'administration.">
  <MinimalHeader slot="header" />

  <main id="main-content" class="py-16 bg-[var(--ml-color-river-50)]/40 min-h-screen flex items-center justify-center">
    <div class="ml-container max-w-2xl mx-auto px-4 text-center">
      <div class="bg-white border border-[var(--ml-color-neutral-200)] rounded-3xl p-8 md:p-12 shadow-xl relative overflow-hidden">
        <!-- Accent Glow background -->
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[var(--ml-color-green-500)] via-transparent to-transparent pointer-events-none"></div>

        <!-- Animated Checkmark Badge -->
        <div class="w-20 h-20 bg-[var(--ml-color-green-50)] text-[var(--ml-color-green-600)] rounded-full flex items-center justify-center mx-auto mb-6 border-2 border-[var(--ml-color-green-200)] shadow-inner">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>

        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-[var(--ml-color-green-100)] text-[var(--ml-color-green-800)] mb-3">
          Demande enregistrée avec succès
        </span>

        <h1 class="text-2xl md:text-3xl font-black text-[var(--ml-color-neutral-900)] font-title mb-4">
          Merci ! Votre message a bien été transmis.
        </h1>

        <p class="text-sm md:text-base text-[var(--ml-color-neutral-600)] leading-relaxed mb-8 max-w-lg mx-auto">
          Nos équipes d'assistance administrative accusent réception de votre demande. Un numéro de suivi vous sera communiqué par email et une réponse vous sera apportée sous <strong>24 à 48 heures ouvrées</strong>.
        </p>

        <!-- Recapitulatif Box -->
        <div class="bg-[var(--ml-color-river-50)]/70 p-5 rounded-2xl border border-[var(--ml-color-river-100)] text-left text-xs text-[var(--ml-color-neutral-700)] mb-8 space-y-2">
          <div class="flex justify-between">
            <span class="font-bold text-[var(--ml-color-river-800)]">Référence du ticket :</span>
            <span class="font-mono text-[var(--ml-color-neutral-900)]">ML-2026-8942</span>
          </div>
          <div class="flex justify-between">
            <span class="font-bold text-[var(--ml-color-river-800)]">Délai estimé :</span>
            <span>Moins de 48 heures</span>
          </div>
        </div>

        <div class="flex flex-wrap justify-center gap-4">
          <a href="/" class="px-6 py-3 bg-[var(--ml-color-green-700)] hover:bg-[var(--ml-color-green-800)] text-white font-bold rounded-xl text-sm transition-all shadow-md no-underline inline-flex items-center gap-2">
            <span>Retour à l'accueil</span>
            <span>&rarr;</span>
          </a>
          <a href="/services" class="px-6 py-3 bg-[var(--ml-color-neutral-100)] hover:bg-[var(--ml-color-neutral-200)] text-[var(--ml-color-neutral-800)] font-bold rounded-xl text-sm transition-all no-underline">
            Consulter les démarches
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer
    slot="footer"
    institution={siteConfig.institution}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
