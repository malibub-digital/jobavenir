---
export const prerender = false;

import BaseLayout from "@malihub/sites-core/layouts/BaseLayout.astro";
import MinimalHeader from "../components/MinimalHeader.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import siteConfig from "../../site.config.json";
import homeData from "../data/pages/home.json";
import { getUnifiedJobs } from "../lib/db";

const allJobs = await getUnifiedJobs();
const recentJobs = allJobs.sort(
  (a, b) =>
    new Date(b.data.publishedDate).getTime() -
    new Date(a.data.publishedDate).getTime(),
);

const countEmplois = allJobs.filter(
  (j) => j.data.opportunityType === "JOB",
).length;

const countStages = allJobs.filter(
  (j) => j.data.opportunityType === "STAGE",
).length;

const countFormations = allJobs.filter(
  (j) => j.data.opportunityType === "TRAINING",
).length;

const countProjets = allJobs.filter(
  (j) => j.data.opportunityType === "PROJECT_CALL",
).length;

const countAnnonces = allJobs.filter(
  (j) => j.data.opportunityType === "ANNOUNCEMENT",
).length;

const latestAnnouncements = allJobs
  .filter((j) => j.data.opportunityType === "ANNOUNCEMENT")
  .slice(0, 3);

const footerLogos = [
  { src: "/images/logo-apej.svg", alt: "APEJ Mali" },
  { src: "/images/logo-eoj.svg", alt: "EOJ Mali" },
];
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  emergencyNotice={siteConfig.emergencyNotice}
>
  <MinimalHeader slot="header" />

  <section
    class="ml-hero bg-gradient-to-b from-amber-50/70 via-amber-50/20 to-white text-stone-900 pt-6 pb-20 sm:pt-12 sm:pb-16 md:pt-16 md:pb-24 px-2 sm:px-4 relative overflow-hidden border-b border-stone-200/60 min-h-[360px] sm:min-h-[420px] flex items-center justify-center"
  >
    <div
      class="hero-illustration-left absolute left-0 bottom-0 w-[85px] xs:w-[110px] sm:w-[220px] md:w-[260px] lg:w-[320px] xl:w-[380px] pointer-events-none select-none z-10 opacity-70 sm:opacity-100"
    >
      <img
        src="/images/jobavenir-4.png"
        alt="Illustration Métiers et Formation Mali"
        class="w-full h-auto object-contain object-left-bottom drop-shadow-sm max-h-[380px]"
        loading="eager"
      />
    </div>

    <div class="max-w-3xl mx-auto text-center relative z-20 px-10 sm:px-6">
      <span
        class="inline-flex items-center gap-1.5 bg-orange-100/90 text-orange-950 text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider mb-2.5 border border-orange-200 shadow-sm"
      >
        <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
        Portail Jeunesse & Emploi au Mali
      </span>

      <h1
        class="text-xl sm:text-4xl lg:text-5xl font-black font-title tracking-tight mb-2.5 text-stone-900 leading-[1.15]"
      >
        {homeData.hero.title}
      </h1>

      <p
        class="text-xs sm:text-lg text-stone-600 leading-relaxed mb-2.5 sm:mb-8 max-w-xl mx-auto font-medium"
      >
        {homeData.hero.subtitle}
      </p>

      <div class="flex justify-center w-full">
        <a
          href="#offres"
          class="w-full sm:w-auto justify-center bg-orange-600 hover:bg-orange-700 text-white font-extrabold px-5 py-2.5 sm:px-9 sm:py-4 rounded-xl shadow-lg shadow-orange-600/25 transition-all hover:scale-[1.02] active:scale-[0.98] no-underline inline-flex items-center gap-2 text-xs sm:text-base"
        >
          <span>Explorer toutes les opportunités</span>
          <svg
            class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-orange-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
          >
        </a>
      </div>
    </div>

    <div
      class="hero-illustration-right absolute right-0 bottom-0 w-[90px] xs:w-[120px] sm:w-[220px] md:w-[260px] lg:w-[320px] xl:w-[380px] pointer-events-none select-none z-10 opacity-70 sm:opacity-100"
    >
      <img
        src="/images/jobavenir-5.png"
        alt="Illustration Opportunités Jeunesse Mali"
        class="w-full h-auto object-contain object-right-bottom drop-shadow-sm max-h-[380px]"
        loading="eager"
      />
    </div>
  </section>

  <!-- 5 PILIERS D'OPPORTUNITÉS (COMPTEURS DYNAMIQUES & CARTES CLICQUABLES) -->
  <section class="py-10 bg-stone-50 border-b border-stone-200/80">
    <div class="ml-container max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        <!-- BLOC 1 : EMPLOIS & CARRIÈRES (BLEU NUIT & CYAN VIBRANT) -->
        <a
          href="/offres?type=emploi"
          class="p-4 rounded-2xl bg-gradient-to-br from-blue-900 via-indigo-950 to-slate-900 text-white shadow-md relative overflow-hidden group hover:scale-[1.03] hover:shadow-xl transition-all duration-300 no-underline flex flex-col justify-between border border-blue-800/40"
        >
          <div
            class="absolute inset-0 opacity-15 pointer-events-none bg-repeat"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%2338BDF8' stroke-width='1.2' stroke-opacity='0.6'%3E%3Cpath d='M30 0 L60 30 L30 60 L0 30 Z'/%3E%3Ccircle cx='30' cy='30' r='4' fill='%2338BDF8' fill-opacity='0.5'/%3E%3C/g%3E%3C/svg%3E&quot;); background-size: 50px 50px;"
          >
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3">
              <div
                class="w-10 h-10 rounded-xl bg-blue-500/20 backdrop-blur-md border border-blue-400/30 text-sky-200 flex items-center justify-center font-bold shadow-sm shrink-0 group-hover:bg-blue-500/30 transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path></svg
                >
              </div>
              <span
                class="inline-flex items-center gap-1 text-[11px] font-extrabold bg-blue-500/20 px-2 py-0.5 rounded-full backdrop-blur-sm border border-blue-400/25 text-sky-200"
              >
                <span>{countEmplois} {countEmplois > 1 ? "opportunités" : "opportunité"}</span>
              </span>
            </div>
            <div>
              <h3
                class="text-base font-black text-white font-title leading-tight mb-1 group-hover:translate-x-0.5 transition-transform"
              >
                Emplois
              </h3>
              <p
                class="text-[11px] text-sky-100/80 leading-snug font-medium line-clamp-2"
              >
                Postes en CDI, CDD et missions professionnelles.
              </p>
            </div>
          </div>
        </a>

        <!-- BLOC 2 : STAGES & IMMERSION (TERRE AMBRÉE & ORANGE CHAUD) -->
        <a
          href="/offres?type=stage"
          class="p-4 rounded-2xl bg-gradient-to-br from-amber-600 via-orange-700 to-amber-900 text-white shadow-md relative overflow-hidden group hover:scale-[1.03] hover:shadow-xl transition-all duration-300 no-underline flex flex-col justify-between border border-amber-500/40"
        >
          <div
            class="absolute inset-0 opacity-20 pointer-events-none bg-repeat"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23FDE047' stroke-width='1.2' stroke-opacity='0.6'%3E%3Cpath d='M30 0 L60 30 L30 60 L0 30 Z'/%3E%3Ccircle cx='30' cy='30' r='4' fill='%23FDE047' fill-opacity='0.5'/%3E%3C/g%3E%3C/svg%3E&quot;); background-size: 50px 50px;"
          >
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3">
              <div
                class="w-10 h-10 rounded-xl bg-amber-400/20 backdrop-blur-md border border-amber-300/30 text-amber-200 flex items-center justify-center font-bold shadow-sm shrink-0 group-hover:bg-amber-400/30 transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 14l9-5-9-5-9 5 9 5z"></path><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                  ></path></svg
                >
              </div>
              <span
                class="inline-flex items-center gap-1 text-[11px] font-extrabold bg-amber-400/20 px-2 py-0.5 rounded-full backdrop-blur-sm border border-amber-300/25 text-amber-100"
              >
                <span>{countStages} {countStages > 1 ? "opportunités" : "opportunité"}</span>
              </span>
            </div>
            <div>
              <h3
                class="text-base font-black text-white font-title leading-tight mb-1 group-hover:translate-x-0.5 transition-transform"
              >
                Stages
              </h3>
              <p
                class="text-[11px] text-amber-100/90 leading-snug font-medium line-clamp-2"
              >
                Stages PFE, qualification et immersions APEJ.
              </p>
            </div>
          </div>
        </a>

        <!-- BLOC 3 : FORMATIONS & MÉTIERS (VIOLET IMPÉRIAL & INDIGO) -->
        <a
          href="/offres?type=formation"
          class="p-4 rounded-2xl bg-gradient-to-br from-purple-800 via-indigo-900 to-slate-950 text-white shadow-md relative overflow-hidden group hover:scale-[1.03] hover:shadow-xl transition-all duration-300 no-underline flex flex-col justify-between border border-purple-600/30"
        >
          <div
            class="absolute inset-0 opacity-15 pointer-events-none bg-repeat"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23C084FC' stroke-width='1.2' stroke-opacity='0.6'%3E%3Cpath d='M30 0 L60 30 L30 60 L0 30 Z'/%3E%3Ccircle cx='30' cy='30' r='4' fill='%23C084FC' fill-opacity='0.5'/%3E%3C/g%3E%3C/svg%3E&quot;); background-size: 50px 50px;"
          >
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3">
              <div
                class="w-10 h-10 rounded-xl bg-purple-500/20 backdrop-blur-md border border-purple-400/30 text-purple-200 flex items-center justify-center font-bold shadow-sm shrink-0 group-hover:bg-purple-500/30 transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                  ></path></svg
                >
              </div>
              <span
                class="inline-flex items-center gap-1 text-[11px] font-extrabold bg-purple-500/20 px-2 py-0.5 rounded-full backdrop-blur-sm border border-purple-400/25 text-purple-200"
              >
                <span>{countFormations} {countFormations > 1 ? "opportunités" : "opportunité"}</span>
              </span>
            </div>
            <div>
              <h3
                class="text-base font-black text-white font-title leading-tight mb-1 group-hover:translate-x-0.5 transition-transform"
              >
                Formations
              </h3>
              <p
                class="text-[11px] text-purple-100/90 leading-snug font-medium line-clamp-2"
              >
                Ateliers certifiants et compétences techniques.
              </p>
            </div>
          </div>
        </a>

        <!-- BLOC 4 : PROJETS & SUBVENTIONS (ÉMERAUDE & VERT SAHEL) -->
        <a
          href="/offres?type=projet"
          class="p-4 rounded-2xl bg-gradient-to-br from-emerald-700 via-teal-800 to-stone-900 text-white shadow-md relative overflow-hidden group hover:scale-[1.03] hover:shadow-xl transition-all duration-300 no-underline flex flex-col justify-between border border-emerald-500/40"
        >
          <div
            class="absolute inset-0 opacity-20 pointer-events-none bg-repeat"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%2334D399' stroke-width='1.2' stroke-opacity='0.6'%3E%3Cpath d='M30 0 L60 30 L30 60 L0 30 Z'/%3E%3Ccircle cx='30' cy='30' r='4' fill='%2334D399' fill-opacity='0.5'/%3E%3C/g%3E%3C/svg%3E&quot;); background-size: 50px 50px;"
          >
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3">
              <div
                class="w-10 h-10 rounded-xl bg-emerald-400/20 backdrop-blur-md border border-emerald-300/30 text-emerald-200 flex items-center justify-center font-bold shadow-sm shrink-0 group-hover:bg-emerald-400/30 transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                >
              </div>
              <span
                class="inline-flex items-center gap-1 text-[11px] font-extrabold bg-emerald-400/20 px-2 py-0.5 rounded-full backdrop-blur-sm border border-emerald-300/25 text-emerald-100"
              >
                <span>{countProjets} {countProjets > 1 ? "opportunités" : "opportunité"}</span>
              </span>
            </div>
            <div>
              <h3
                class="text-base font-black text-white font-title leading-tight mb-1 group-hover:translate-x-0.5 transition-transform"
              >
                Projets & Subventions
              </h3>
              <p
                class="text-[11px] text-emerald-100/90 leading-snug font-medium line-clamp-2"
              >
                Guichets ouverts, dotations et concours.
              </p>
            </div>
          </div>
        </a>

        <!-- BLOC 5 : ANNONCES & VEILLE (ARDOISE INSTITUTIONNELLE & CORAIL) -->
        <a
          href="/offres?type=annonce"
          class="p-4 rounded-2xl bg-gradient-to-br from-slate-700 via-stone-800 to-stone-950 text-white shadow-md relative overflow-hidden group hover:scale-[1.03] hover:shadow-xl transition-all duration-300 no-underline flex flex-col justify-between border border-slate-600/40"
        >
          <div
            class="absolute inset-0 opacity-20 pointer-events-none bg-repeat"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23E2E8F0' stroke-width='1.2' stroke-opacity='0.5'%3E%3Cpath d='M30 0 L60 30 L30 60 L0 30 Z'/%3E%3Ccircle cx='30' cy='30' r='4' fill='%23E2E8F0' fill-opacity='0.4'/%3E%3C/g%3E%3C/svg%3E&quot;); background-size: 50px 50px;"
          >
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3">
              <div
                class="w-10 h-10 rounded-xl bg-white/15 backdrop-blur-md border border-white/20 text-slate-100 flex items-center justify-center font-bold shadow-sm shrink-0 group-hover:bg-white/25 transition-colors text-base"
              >
                📢
              </div>
              <span
                class="inline-flex items-center gap-1 text-[11px] font-extrabold bg-white/15 px-2 py-0.5 rounded-full backdrop-blur-sm border border-white/20 text-slate-200"
              >
                <span>{countAnnonces} {countAnnonces > 1 ? "opportunités" : "opportunité"}</span>
              </span>
            </div>
            <div>
              <h3
                class="text-base font-black text-white font-title leading-tight mb-1 group-hover:translate-x-0.5 transition-transform"
              >
                Annonces
              </h3>
              <p
                class="text-[11px] text-slate-200/90 leading-snug font-medium line-clamp-2"
              >
                Communiqués ministériels et réformes.
              </p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section id="offres" class="py-12 bg-white">
    <div class="ml-container max-w-5xl mx-auto px-4">
      <div class="flex flex-wrap justify-between items-end mb-8 gap-4">
        <div>
          <span
            class="text-xs font-bold uppercase tracking-wider text-orange-800 bg-orange-100 px-3.5 py-1 rounded-full mb-2 inline-block border border-orange-200"
          >
            Dernières opportunités
          </span>
          <h2
            class="text-2xl md:text-3xl font-black text-stone-900 font-title m-0"
          >
            Dernières opportunités publiées
          </h2>
        </div>
        <a
          href="/offres"
          class="text-xs font-extrabold text-orange-600 hover:text-orange-700 hover:underline inline-flex items-center gap-1 no-underline"
        >
          <span>Voir toutes les opportunités</span>
          <span>&rarr;</span>
        </a>
      </div>

      {
        recentJobs.length === 0 ? (
          <div class="py-12 px-4 text-center max-w-md mx-auto">
            <p class="text-sm font-semibold text-stone-700 mb-1">
              Il n'y a pas d'offre pour l'instant.
            </p>
            <p class="text-xs text-stone-400">
              Revenez bientôt consulter les nouvelles opportunités disponibles.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {recentJobs.map((job) => (
              <article class="bg-stone-50 p-6 rounded-2xl border border-stone-200/90 shadow-sm hover:shadow-md hover:border-orange-500 transition-all duration-200 group flex flex-col justify-between">
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                    <span class={`px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${
                      job.data.opportunityType === 'ANNOUNCEMENT'
                        ? 'bg-slate-100 text-slate-800 border-slate-300'
                        : job.data.opportunityType === 'PROJECT_CALL'
                        ? 'bg-emerald-100 text-emerald-900 border-emerald-300'
                        : job.data.opportunityType === 'STAGE'
                        ? 'bg-amber-100 text-amber-900 border-amber-200'
                        : job.data.opportunityType === 'TRAINING'
                        ? 'bg-orange-100 text-orange-950 border-orange-200'
                        : 'bg-amber-100 text-amber-900 border-amber-200'
                    }`}>
                      {job.data.opportunityType === 'ANNOUNCEMENT' ? 'Annonce' : job.data.opportunityType === 'PROJECT_CALL' ? 'Appel à projets' : job.data.contractType}
                    </span>
                    <span class="text-[11px] font-semibold text-stone-500 flex items-center gap-1">
                      <svg
                        class="w-3.5 h-3.5 text-stone-400 inline"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        />
                      </svg>
                      {job.data.location}
                    </span>
                  </div>

                  <h3 class="text-lg font-bold text-stone-900 group-hover:text-orange-600 transition-colors mb-2 font-title">
                    <a
                      href={`/offres/${job.slug}`}
                      class="no-underline text-inherit"
                    >
                      {job.data.title}
                    </a>
                  </h3>

                  <p class="text-xs text-stone-600 line-clamp-2 mb-4 leading-relaxed">
                    {job.data.excerpt}
                  </p>
                </div>

                <div class="flex items-center justify-between text-[11px] text-stone-500 pt-3 border-t border-stone-200/60">
                  <span class="font-semibold text-stone-700 flex items-center gap-1">
                    <svg
                      class="w-3.5 h-3.5 text-amber-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m3 0h1M9 7h1m-1 4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                      />
                    </svg>
                    {job.data.company}
                  </span>
                  <a
                    href={`/offres/${job.slug}`}
                    class="font-bold text-orange-600 group-hover:translate-x-1 transition-transform no-underline inline-flex items-center gap-1"
                  >
                    <span>Détail</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <Footer
    slot="footer"
    institution={siteConfig.institution}
    partnerLogos={footerLogos}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
