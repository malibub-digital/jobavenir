---
import BaseLayout from '@malihub/sites-core/layouts/BaseLayout.astro';
import MinimalHeader from "../components/MinimalHeader.astro";
import Footer from '@malihub/sites-core/components/Footer.astro';
import { getCollection } from 'astro:content';
import siteConfig from '../../site.config.json';
import homeData from '../data/pages/home.json';
import { getUnifiedJobs } from '../lib/db';

const markdownJobs = await getCollection('jobs');
const allJobs = await getUnifiedJobs(markdownJobs);
const recentJobs = allJobs.sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const countEmplois = allJobs.filter(j => j.data.contractType === 'CDI' || j.data.contractType === 'CDD' || j.data.contractType === 'Intérim').length;
const countStages = allJobs.filter(j => j.data.contractType === 'Stage' || j.data.contractType === 'Apprentissage').length;
const countFormations = 12;

const footerLogos = [
  { src: '/images/logo-apej.svg', alt: 'APEJ Mali' },
  { src: '/images/logo-eoj.svg', alt: 'EOJ Mali' }
];
---

<BaseLayout title={siteConfig.title} description={siteConfig.description} emergencyNotice={siteConfig.emergencyNotice}>
  <MinimalHeader slot="header" />

  <section class="ml-hero bg-gradient-to-b from-amber-50/70 via-amber-50/20 to-white text-stone-900 pt-6 pb-20 sm:pt-12 sm:pb-16 md:pt-16 md:pb-24 px-2 sm:px-4 relative overflow-hidden border-b border-stone-200/60 min-h-[360px] sm:min-h-[420px] flex items-center justify-center">
    
    <div class="hero-illustration-left absolute left-0 bottom-0 w-[85px] xs:w-[110px] sm:w-[220px] md:w-[260px] lg:w-[320px] xl:w-[380px] pointer-events-none select-none z-10 opacity-70 sm:opacity-100">
      <img
        src="/images/jobavenir-4.png"
        alt="Illustration Métiers et Formation Mali"
        class="w-full h-auto object-contain object-left-bottom drop-shadow-sm max-h-[380px]"
        loading="eager"
      />
    </div>

    <div class="max-w-3xl mx-auto text-center relative z-20 px-10 sm:px-6">
      
      <span class="inline-flex items-center gap-1.5 bg-orange-100/90 text-orange-950 text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider mb-2.5 border border-orange-200 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
        Offres d'emploi au Mali
      </span>

      <h1 class="text-xl sm:text-4xl lg:text-5xl font-black font-title tracking-tight mb-2.5 text-stone-900 leading-[1.15]">
        {homeData.hero.title}
      </h1>

      <p class="text-xs sm:text-lg text-stone-600 leading-relaxed mb-2.5 sm:mb-8 max-w-xl mx-auto font-medium">
        {homeData.hero.subtitle}
      </p>

      <div class="flex justify-center w-full">
        <a href="#offres" class="w-full sm:w-auto justify-center bg-orange-600 hover:bg-orange-700 text-white font-extrabold px-5 py-2.5 sm:px-9 sm:py-4 rounded-xl shadow-lg shadow-orange-600/25 transition-all hover:scale-[1.02] active:scale-[0.98] no-underline inline-flex items-center gap-2 text-xs sm:text-base">
          <span>Voir les offres disponibles</span>
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-orange-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

    </div>

    <div class="hero-illustration-right absolute right-0 bottom-0 w-[90px] xs:w-[120px] sm:w-[220px] md:w-[260px] lg:w-[320px] xl:w-[380px] pointer-events-none select-none z-10 opacity-70 sm:opacity-100">
      <img
        src="/images/jobavenir-5.png"
        alt="Illustration Opportunités Jeunesse Mali"
        class="w-full h-auto object-contain object-right-bottom drop-shadow-sm max-h-[380px]"
        loading="eager"
      />
    </div>

  </section>

  <section class="py-10 bg-stone-50 border-b border-stone-200/80">
    <div class="ml-container max-w-4xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-6 rounded-2xl bg-gradient-to-br from-amber-600 via-orange-600 to-amber-700 text-white shadow-md relative overflow-hidden group hover:scale-[1.02] transition-transform">
          <div class="absolute inset-0 opacity-20 pointer-events-none bg-repeat" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23FFFFFF' stroke-width='1.2' stroke-opacity='0.6'%3E%3Cpath d='M30 0 L60 30 L30 60 L0 30 Z'/%3E%3Ccircle cx='30' cy='30' r='4' fill='%23FFFFFF' fill-opacity='0.5'/%3E%3C/g%3E%3C/svg%3E&quot;); background-size: 50px 50px;"></div>

          <div class="relative z-10 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-md border border-white/30 text-white flex items-center justify-center font-bold shadow-sm shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <span class="block text-2xl font-black text-white font-title leading-none mb-1">{countEmplois} Offres</span>
              <span class="text-xs font-bold text-amber-100 uppercase tracking-wide">Emplois CDI et CDD</span>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-gradient-to-br from-amber-700 via-amber-800 to-stone-900 text-white shadow-md relative overflow-hidden group hover:scale-[1.02] transition-transform">
          <div class="absolute inset-0 opacity-20 pointer-events-none bg-repeat" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23F59E0B' stroke-width='1.2' stroke-opacity='0.6'%3E%3Cpath d='M30 0 L60 30 L30 60 L0 30 Z'/%3E%3Ccircle cx='30' cy='30' r='4' fill='%23F59E0B' fill-opacity='0.5'/%3E%3C/g%3E%3C/svg%3E&quot;); background-size: 50px 50px;"></div>

          <div class="relative z-10 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-md border border-white/30 text-white flex items-center justify-center font-bold shadow-sm shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
            </div>
            <div>
              <span class="block text-2xl font-black text-white font-title leading-none mb-1">{countStages} Postes</span>
              <span class="text-xs font-bold text-amber-200 uppercase tracking-wide">Stages et Immersion</span>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-gradient-to-br from-orange-600 via-amber-600 to-amber-700 text-white shadow-md relative overflow-hidden group hover:scale-[1.02] transition-transform">
          <div class="absolute inset-0 opacity-20 pointer-events-none bg-repeat" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23FDE047' stroke-width='1.2' stroke-opacity='0.6'%3E%3Cpath d='M30 0 L60 30 L30 60 L0 30 Z'/%3E%3Ccircle cx='30' cy='30' r='4' fill='%23FDE047' fill-opacity='0.5'/%3E%3C/g%3E%3C/svg%3E&quot;); background-size: 50px 50px;"></div>

          <div class="relative z-10 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-md border border-white/30 text-white flex items-center justify-center font-bold shadow-sm shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            </div>
            <div>
              <span class="block text-2xl font-black text-white font-title leading-none mb-1">{countFormations} Sessions</span>
              <span class="text-xs font-bold text-amber-100 uppercase tracking-wide">Formations Métiers</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section id="offres" class="py-12 bg-white">
    <div class="ml-container max-w-5xl mx-auto px-4">
      <div class="flex flex-wrap justify-between items-end mb-8 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-orange-800 bg-orange-100 px-3.5 py-1 rounded-full mb-2 inline-block border border-orange-200">
            Dernières opportunités
          </span>
          <h2 class="text-2xl md:text-3xl font-black text-stone-900 font-title m-0">Toutes les offres d'emploi</h2>
        </div>
        <a href="/offres" class="text-xs font-extrabold text-orange-600 hover:text-orange-700 hover:underline inline-flex items-center gap-1 no-underline">
          <span>Voir toutes les offres</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {recentJobs.map((job) => (
          <article class="bg-stone-50 p-6 rounded-2xl border border-stone-200/90 shadow-sm hover:shadow-md hover:border-orange-500 transition-all duration-200 group flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-900 border border-amber-200">
                  {job.data.contractType}
                </span>
                <span class="text-[11px] font-semibold text-stone-500 flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-stone-400 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                  {job.data.location}
                </span>
              </div>
              
              <h3 class="text-lg font-bold text-stone-900 group-hover:text-orange-600 transition-colors mb-2 font-title">
                <a href={`/offres/${job.slug}`} class="no-underline text-inherit">
                  {job.data.title}
                </a>
              </h3>
              
              <p class="text-xs text-stone-600 line-clamp-2 mb-4 leading-relaxed">
                {job.data.excerpt}
              </p>
            </div>

            <div class="flex items-center justify-between text-[11px] text-stone-500 pt-3 border-t border-stone-200/60">
              <span class="font-semibold text-stone-700 flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m3 0h1M9 7h1m-1 4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                {job.data.company}
              </span>
              <a href={`/offres/${job.slug}`} class="font-bold text-orange-600 group-hover:translate-x-1 transition-transform no-underline inline-flex items-center gap-1">
                <span>Détail</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer
    slot="footer"
    institution={siteConfig.institution}
    partnerLogos={footerLogos}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
