---
export const prerender = false;

import BaseLayout from "@malihub/sites-core/layouts/BaseLayout.astro";
import MinimalHeader from "../components/MinimalHeader.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import siteConfig from "../../site.config.json";
import homeData from "../data/pages/home.json";
import { getUnifiedJobs } from "../lib/db";

const allJobs = await getUnifiedJobs();
const recentJobs = allJobs.sort(
  (a, b) =>
    new Date(b.data.publishedDate).getTime() -
    new Date(a.data.publishedDate).getTime(),
);

const countEmplois = allJobs.filter(
  (j) => j.data.opportunityType === "JOB",
).length;

const countStages = allJobs.filter(
  (j) => j.data.opportunityType === "STAGE",
).length;

const countFormations = allJobs.filter(
  (j) => j.data.opportunityType === "TRAINING",
).length;

const countProjets = allJobs.filter(
  (j) => j.data.opportunityType === "PROJECT_CALL",
).length;

const countAnnonces = allJobs.filter(
  (j) => j.data.opportunityType === "ANNOUNCEMENT",
).length;

const latestAnnouncements = allJobs
  .filter((j) => j.data.opportunityType === "ANNOUNCEMENT")
  .slice(0, 3);

const footerLogos = [
  { src: "/images/logo-apej.svg", alt: "APEJ Mali" },
  { src: "/images/logo-eoj.svg", alt: "EOJ Mali" },
];
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  emergencyNotice={siteConfig.emergencyNotice}
>
  <MinimalHeader slot="header" />

  <!-- HERO PRINCIPAL AVEC RECHERCHE INTÉGRÉE & DESIGN PERCUTANT (CENTRAGE VERTICAL SUR DESKTOP) -->
  <section
    class="ml-hero bg-gradient-to-b from-amber-50/80 via-orange-50/25 to-white text-stone-900 pt-7 pb-44 sm:py-14 lg:py-16 px-3 sm:px-4 relative overflow-hidden border-b border-stone-200/60 min-h-[520px] sm:min-h-[440px] lg:min-h-[460px] sm:flex sm:items-center sm:justify-center"
  >
    <!-- Illustrations latérales décoratives (entièrement visibles, ancrées à la base du hero) -->
    <div
      class="hero-illustration-left absolute -left-1 sm:left-0 md:left-2 lg:left-6 bottom-0 w-[130px] sm:w-[220px] md:w-[280px] lg:w-[350px] xl:w-[410px] pointer-events-none select-none z-0 opacity-80 sm:opacity-85 lg:opacity-100 transition-all duration-300"
    >
      <img
        src="/images/jobavenir-4.png"
        alt="Illustration Métiers et Formation Mali"
        class="w-full h-auto object-contain object-left-bottom drop-shadow-md max-h-[290px] sm:max-h-[440px]"
        loading="eager"
      />
    </div>

    <div
      class="hero-illustration-right absolute -right-1 sm:right-0 md:right-2 lg:right-6 bottom-0 w-[130px] sm:w-[220px] md:w-[280px] lg:w-[350px] xl:w-[410px] pointer-events-none select-none z-0 opacity-80 sm:opacity-85 lg:opacity-100 transition-all duration-300"
    >
      <img
        src="/images/jobavenir-5.png"
        alt="Illustration Opportunités Jeunesse Mali"
        class="w-full h-auto object-contain object-right-bottom drop-shadow-md max-h-[290px] sm:max-h-[440px]"
        loading="eager"
      />
    </div>

    <!-- Conteneur central d'action -->
    <div class="w-full max-w-4xl mx-auto text-center relative z-10 px-2 sm:px-4">
      <!-- Titre d'accroche percutant -->
      <h1
        class="text-2xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-black font-title tracking-tight text-stone-900 leading-[1.18] mb-6 max-w-3xl mx-auto"
      >
        Emploi, formation, projet<br /><span class="text-orange-600"
          >trouvez votre voie</span
        >
      </h1>

      <!-- BARRE DE RECHERCHE RAPIDE CENTRALE & TENDANCES GROUPÉES -->
      <div class="bg-white/95 backdrop-blur-md p-2.5 sm:p-3 rounded-2xl sm:rounded-3xl shadow-xl shadow-orange-950/5 border border-stone-200 max-w-2xl mx-auto mb-4 text-left transition-all relative z-20">
        <form
          action="/opportunites"
          method="GET"
          class="focus-within:ring-2 focus-within:ring-orange-500/20 rounded-xl"
        >
          <div class="flex flex-col sm:flex-row items-stretch gap-2">
            <!-- Champ recherche texte -->
            <div class="relative flex-1 flex items-center">
              <div class="absolute left-3.5 text-stone-400 pointer-events-none">
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
              <input
                type="text"
                name="q"
                placeholder="Métier, compétence, organisme..."
                class="w-full pl-11 pr-3 py-3 rounded-xl text-sm sm:text-base text-stone-900 placeholder:text-stone-400 bg-stone-50/50 sm:bg-transparent border border-stone-200/60 sm:border-none focus:outline-none"
              />
            </div>

            <!-- Sélecteur de type d'opportunité -->
            <div
              class="sm:w-48 border-t sm:border-t-0 sm:border-l border-stone-200 pt-2 sm:pt-0 sm:pl-2 flex items-center"
            >
              <label for="hero-type-select" class="sr-only"
                >Type d'opportunité</label
              >
              <select
                id="hero-type-select"
                name="type"
                class="w-full py-2.5 px-2.5 text-xs sm:text-sm font-semibold text-stone-700 bg-stone-50 hover:bg-stone-100 rounded-xl border border-stone-200/80 focus:outline-none cursor-pointer"
              >
                <option value="tous">Toutes les voies</option>
                <option value="emploi">💼 Emplois</option>
                <option value="stage">🎓 Stages</option>
                <option value="formation">📚 Formations</option>
                <option value="projet">🚀 Projets</option>
                <option value="annonce">📢 Annonces</option>
              </select>
            </div>

            <!-- Bouton CTA de recherche -->
            <button
              type="submit"
              class="bg-orange-600 hover:bg-orange-700 active:scale-[0.98] text-white font-extrabold px-6 py-3 rounded-xl shadow-md shadow-orange-600/25 transition-all flex items-center justify-center gap-2 cursor-pointer text-sm sm:text-base shrink-0"
            >
              <span>Rechercher</span>
              <svg
                class="w-4 h-4 text-orange-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </div>
        </form>

        <!-- FILTRES RAPIDES TENDANCES INTÉGRÉS DANS LA CARTE -->
        <div class="pt-2.5 mt-2.5 border-t border-stone-100/90 flex flex-wrap items-center gap-1.5 text-xs text-stone-600">
          <span
            class="font-bold text-stone-400 text-[10px] sm:text-[11px] uppercase tracking-wider flex items-center gap-1 mr-0.5"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
            Tendances :
          </span>
          <a
            href="/opportunites?region=bamako"
            class="px-2.5 py-1 rounded-full bg-stone-100 hover:bg-orange-50 hover:text-orange-700 text-stone-700 font-medium transition-colors no-underline text-[11px] border border-stone-200/60"
          >
            📍 Bamako
          </a>
          <a
            href="/opportunites?region=segou"
            class="px-2.5 py-1 rounded-full bg-stone-100 hover:bg-orange-50 hover:text-orange-700 text-stone-700 font-medium transition-colors no-underline text-[11px] border border-stone-200/60"
          >
            📍 Ségou
          </a>
          <a
            href="/opportunites?secteur=informatique"
            class="px-2.5 py-1 rounded-full bg-stone-100 hover:bg-orange-50 hover:text-orange-700 text-stone-700 font-medium transition-colors no-underline text-[11px] border border-stone-200/60"
          >
            💻 Tech
          </a>
          <a
            href="/opportunites?secteur=finance"
            class="px-2.5 py-1 rounded-full bg-stone-100 hover:bg-orange-50 hover:text-orange-700 text-stone-700 font-medium transition-colors no-underline text-[11px] border border-stone-200/60"
          >
            📊 Finance
          </a>
          <a
            href="/opportunites?secteur=agriculture"
            class="px-2.5 py-1 rounded-full bg-stone-100 hover:bg-orange-50 hover:text-orange-700 text-stone-700 font-medium transition-colors no-underline text-[11px] border border-stone-200/60"
          >
            🌾 Agriculture
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 PILIERS D'OPPORTUNITÉS (CARTES TEINTÉES RAFFINÉES & DISTINCTIVES AVEC PATTERN SUBTIL) -->
  <section
    class="py-10 sm:py-14 bg-gradient-to-b from-stone-50 via-amber-50/30 to-stone-100/60 border-b border-stone-200/70 relative"
  >
    <div class="ml-container max-w-7xl mx-auto px-4 relative z-10">
      <div
        class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-2"
      >
        <div>
          <h2
            class="text-xl sm:text-2xl font-black text-stone-900 font-title m-0"
          >
            Explorez par domaine d'opportunité
          </h2>
        </div>
        <span class="text-xs text-stone-500 font-medium">
          {allJobs.length} opportunités actives centralisées
        </span>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3.5"
      >
        <!-- BLOC 1 : EMPLOIS (AMBRE DORÉ CLAIR) -->
        <a
          href="/opportunites?type=emploi"
          class="group p-4 rounded-2xl bg-gradient-to-b from-amber-50/90 to-orange-50/40 hover:from-amber-100/90 hover:to-orange-100/50 shadow-sm hover:shadow-md transition-all duration-300 no-underline flex flex-col justify-between border border-amber-200/90 hover:border-amber-400 relative overflow-hidden hover:scale-[1.02]"
        >
          <div
            class="absolute inset-0 opacity-[0.06] pointer-events-none bg-repeat"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 0 L40 20 L20 40 L0 20 Z' fill='none' stroke='%23D97706' stroke-width='1'/%3E%3C/svg%3E&quot;); background-size: 36px 36px;"
          >
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3.5">
              <div
                class="w-10 h-10 rounded-xl bg-amber-500/15 text-amber-900 flex items-center justify-center font-bold border border-amber-300/60 group-hover:bg-amber-600 group-hover:text-white transition-all duration-200 shadow-sm"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <span
                class="inline-flex items-center gap-1 text-[11px] font-extrabold bg-amber-100 text-amber-950 px-2.5 py-0.5 rounded-full border border-amber-300 shadow-xs"
              >
                <span
                  >{countEmplois} {countEmplois > 1 ? "offres" : "offre"}</span
                >
              </span>
            </div>
            <h3
              class="text-base font-extrabold text-stone-900 group-hover:text-amber-800 transition-colors mb-1 font-title"
            >
              Emplois
            </h3>
            <p class="text-xs text-stone-700 leading-relaxed font-normal">
              Postes en CDI, CDD et missions professionnelles.
            </p>
          </div>
          <div
            class="mt-4 pt-3 border-t border-amber-200/70 flex items-center justify-between text-xs font-bold text-amber-800 group-hover:translate-x-0.5 transition-transform relative z-10"
          >
            <span>Explorer</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- BLOC 2 : STAGES (ORANGE CHAUD / PÊCHE CUIVRÉE CLAIRE) -->
        <a
          href="/opportunites?type=stage"
          class="group p-4 rounded-2xl bg-gradient-to-b from-orange-50/90 to-amber-50/50 hover:from-orange-100/90 hover:to-amber-100/60 shadow-sm hover:shadow-md transition-all duration-300 no-underline flex flex-col justify-between border border-orange-200/90 hover:border-orange-400 relative overflow-hidden hover:scale-[1.02]"
        >
          <div
            class="absolute inset-0 opacity-[0.06] pointer-events-none bg-repeat"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 0 L40 20 L20 40 L0 20 Z' fill='none' stroke='%23EA580C' stroke-width='1'/%3E%3C/svg%3E&quot;); background-size: 36px 36px;"
          >
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3.5">
              <div
                class="w-10 h-10 rounded-xl bg-orange-500/15 text-orange-900 flex items-center justify-center font-bold border border-orange-300/60 group-hover:bg-orange-600 group-hover:text-white transition-all duration-200 shadow-sm"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 14l9-5-9-5-9 5 9 5z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                  ></path>
                </svg>
              </div>
              <span
                class="inline-flex items-center gap-1 text-[11px] font-extrabold bg-orange-100 text-orange-950 px-2.5 py-0.5 rounded-full border border-orange-300 shadow-xs"
              >
                <span>{countStages} {countStages > 1 ? "stages" : "stage"}</span
                >
              </span>
            </div>
            <h3
              class="text-base font-extrabold text-stone-900 group-hover:text-orange-800 transition-colors mb-1 font-title"
            >
              Stages
            </h3>
            <p class="text-xs text-stone-700 leading-relaxed font-normal">
              Stages PFE, qualifications et immersions APEJ.
            </p>
          </div>
          <div
            class="mt-4 pt-3 border-t border-orange-200/70 flex items-center justify-between text-xs font-bold text-orange-800 group-hover:translate-x-0.5 transition-transform relative z-10"
          >
            <span>Explorer</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- BLOC 3 : FORMATIONS (OCRE SAFRAN / MIEL ENSOLEILLÉ CLAIR) -->
        <a
          href="/opportunites?type=formation"
          class="group p-4 rounded-2xl bg-gradient-to-b from-yellow-50/90 to-amber-50/60 hover:from-yellow-100/90 hover:to-amber-100/70 shadow-sm hover:shadow-md transition-all duration-300 no-underline flex flex-col justify-between border border-yellow-300/80 hover:border-yellow-500 relative overflow-hidden hover:scale-[1.02]"
        >
          <div
            class="absolute inset-0 opacity-[0.06] pointer-events-none bg-repeat"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 0 L40 20 L20 40 L0 20 Z' fill='none' stroke='%23CA8A04' stroke-width='1'/%3E%3C/svg%3E&quot;); background-size: 36px 36px;"
          >
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3.5">
              <div
                class="w-10 h-10 rounded-xl bg-yellow-500/15 text-yellow-950 flex items-center justify-center font-bold border border-yellow-300/70 group-hover:bg-yellow-600 group-hover:text-white transition-all duration-200 shadow-sm"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                  ></path>
                </svg>
              </div>
              <span
                class="inline-flex items-center gap-1 text-[11px] font-extrabold bg-yellow-100 text-yellow-950 px-2.5 py-0.5 rounded-full border border-yellow-300 shadow-xs"
              >
                <span
                  >{countFormations}
                  {countFormations > 1 ? "sessions" : "session"}</span
                >
              </span>
            </div>
            <h3
              class="text-base font-extrabold text-stone-900 group-hover:text-yellow-800 transition-colors mb-1 font-title"
            >
              Formations
            </h3>
            <p class="text-xs text-stone-700 leading-relaxed font-normal">
              Ateliers certifiants et compétences techniques.
            </p>
          </div>
          <div
            class="mt-4 pt-3 border-t border-yellow-200/80 flex items-center justify-between text-xs font-bold text-yellow-800 group-hover:translate-x-0.5 transition-transform relative z-10"
          >
            <span>Explorer</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- BLOC 4 : PROJETS & SUBVENTIONS (TERRE CUITE / ROUGE BRIQUE CLAIR) -->
        <a
          href="/opportunites?type=projet"
          class="group p-4 rounded-2xl bg-gradient-to-b from-rose-50/90 to-orange-50/50 hover:from-rose-100/90 hover:to-orange-100/60 shadow-sm hover:shadow-md transition-all duration-300 no-underline flex flex-col justify-between border border-rose-200/90 hover:border-rose-400 relative overflow-hidden hover:scale-[1.02]"
        >
          <div
            class="absolute inset-0 opacity-[0.06] pointer-events-none bg-repeat"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 0 L40 20 L20 40 L0 20 Z' fill='none' stroke='%23E11D48' stroke-width='1'/%3E%3C/svg%3E&quot;); background-size: 36px 36px;"
          >
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3.5">
              <div
                class="w-10 h-10 rounded-xl bg-rose-500/15 text-rose-900 flex items-center justify-center font-bold border border-rose-300/60 group-hover:bg-rose-600 group-hover:text-white transition-all duration-200 shadow-sm"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <span
                class="inline-flex items-center gap-1 text-[11px] font-extrabold bg-rose-100 text-rose-950 px-2.5 py-0.5 rounded-full border border-rose-300 shadow-xs"
              >
                <span
                  >{countProjets} {countProjets > 1 ? "appels" : "appel"}</span
                >
              </span>
            </div>
            <h3
              class="text-base font-extrabold text-stone-900 group-hover:text-rose-800 transition-colors mb-1 font-title"
            >
              Projets & Fonds
            </h3>
            <p class="text-xs text-stone-700 leading-relaxed font-normal">
              Guichets ouverts, dotations et concours.
            </p>
          </div>
          <div
            class="mt-4 pt-3 border-t border-rose-200/70 flex items-center justify-between text-xs font-bold text-rose-800 group-hover:translate-x-0.5 transition-transform relative z-10"
          >
            <span>Explorer</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- BLOC 5 : ANNONCES & VEILLE (SABLE CHAUD / TERRE AMBRÉE DOUCE) -->
        <a
          href="/opportunites?type=annonce"
          class="group p-4 rounded-2xl bg-gradient-to-b from-stone-50/95 to-amber-50/40 hover:from-amber-50/90 hover:to-stone-100/80 shadow-sm hover:shadow-md transition-all duration-300 no-underline flex flex-col justify-between border border-stone-200 hover:border-amber-400 relative overflow-hidden hover:scale-[1.02]"
        >
          <div
            class="absolute inset-0 opacity-[0.06] pointer-events-none bg-repeat"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 0 L40 20 L20 40 L0 20 Z' fill='none' stroke='%2378350F' stroke-width='1'/%3E%3C/svg%3E&quot;); background-size: 36px 36px;"
          >
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3.5">
              <div
                class="w-10 h-10 rounded-xl bg-amber-800/10 text-amber-950 flex items-center justify-center font-bold border border-amber-300/50 group-hover:bg-amber-800 group-hover:text-white transition-all duration-200 shadow-sm"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"
                  ></path>
                </svg>
              </div>
              <span
                class="inline-flex items-center gap-1 text-[11px] font-extrabold bg-stone-100 text-stone-800 px-2.5 py-0.5 rounded-full border border-stone-300 shadow-xs"
              >
                <span
                  >{countAnnonces}
                  {countAnnonces > 1 ? "annonces" : "annonce"}</span
                >
              </span>
            </div>
            <h3
              class="text-base font-extrabold text-stone-900 group-hover:text-amber-900 transition-colors mb-1 font-title"
            >
              Annonces
            </h3>
            <p class="text-xs text-stone-700 leading-relaxed font-normal">
              Communiqués officiels et avis institutionnels.
            </p>
          </div>
          <div
            class="mt-4 pt-3 border-t border-stone-200/80 flex items-center justify-between text-xs font-bold text-amber-900 group-hover:translate-x-0.5 transition-transform relative z-10"
          >
            <span>Explorer</span>
            <span>&rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section id="offres" class="py-12 bg-white">
    <div class="ml-container max-w-5xl mx-auto px-4">
      <div class="flex flex-wrap justify-between items-end mb-8 gap-4">
        <div>
          <h2
            class="text-2xl md:text-3xl font-black text-stone-900 font-title m-0"
          >
            Dernières opportunités publiées
          </h2>
        </div>
        <a
          href="/opportunites"
          class="text-xs font-extrabold text-orange-600 hover:text-orange-700 hover:underline inline-flex items-center gap-1 no-underline"
        >
          <span>Voir toutes les opportunités</span>
          <span>&rarr;</span>
        </a>
      </div>

      {
        recentJobs.length === 0 ? (
          <div class="py-12 px-4 text-center max-w-md mx-auto">
            <p class="text-sm font-semibold text-stone-700 mb-1">
              Il n'y a pas d'offre pour l'instant.
            </p>
            <p class="text-xs text-stone-400">
              Revenez bientôt consulter les nouvelles opportunités disponibles.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {recentJobs.map((job) => (
              <article class="bg-stone-50 p-6 rounded-2xl border border-stone-200/90 shadow-sm hover:shadow-md hover:border-orange-500 transition-all duration-200 group flex flex-col justify-between">
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                    <span
                      class={`px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${
                        job.data.opportunityType === "ANNOUNCEMENT"
                          ? "bg-slate-100 text-slate-800 border-slate-300"
                          : job.data.opportunityType === "PROJECT_CALL"
                            ? "bg-emerald-100 text-emerald-900 border-emerald-300"
                            : job.data.opportunityType === "STAGE"
                              ? "bg-amber-100 text-amber-900 border-amber-200"
                              : job.data.opportunityType === "TRAINING"
                                ? "bg-orange-100 text-orange-950 border-orange-200"
                                : "bg-amber-100 text-amber-950 border-amber-300"
                      }`}
                    >
                      {job.data.opportunityType === "ANNOUNCEMENT"
                        ? "📢 Annonce"
                        : job.data.opportunityType === "PROJECT_CALL"
                          ? "🚀 Projet"
                          : job.data.opportunityType === "STAGE"
                            ? "🎓 Stage"
                            : job.data.opportunityType === "TRAINING"
                              ? "📚 Formation"
                              : "💼 Emploi"}
                    </span>
                    <span class="text-[11px] text-stone-600 font-semibold bg-stone-200/60 px-2 py-0.5 rounded-md">
                      📍 {job.data.location}
                    </span>
                  </div>

                  <h3 class="text-lg font-bold text-stone-900 group-hover:text-orange-600 transition-colors mb-2 font-title">
                    <a
                      href={`/opportunites/${job.slug}`}
                      class="no-underline text-inherit"
                    >
                      {job.data.title}
                    </a>
                  </h3>

                  <p class="text-xs text-stone-600 line-clamp-2 mb-4 leading-relaxed">
                    {job.data.excerpt}
                  </p>
                </div>

                <div class="flex items-center justify-between text-[11px] text-stone-500 pt-3 border-t border-stone-200/60">
                  <span class="font-semibold text-stone-700 flex items-center gap-1">
                    <svg
                      class="w-3.5 h-3.5 text-amber-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m3 0h1M9 7h1m-1 4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                      />
                    </svg>
                    {job.data.company}
                  </span>
                  <a
                    href={`/opportunites/${job.slug}`}
                    class="font-bold text-orange-600 group-hover:translate-x-1 transition-transform no-underline inline-flex items-center gap-1"
                  >
                    <span>Détail</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <Footer
    slot="footer"
    institution={siteConfig.institution}
    partnerLogos={footerLogos}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
