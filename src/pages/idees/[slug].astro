---
export const prerender = false;

import BaseLayout from "@malihub/sites-core/layouts/BaseLayout.astro";
import MinimalHeader from "../../components/MinimalHeader.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import siteConfig from "../../../site.config.json";
import { getIdeaBySlug } from "../../lib/db";
import { getCategoryImage } from "../../lib/image-bank";

const { slug } = Astro.params;
const idea = slug ? await getIdeaBySlug(slug) : null;

if (!idea) {
  return Astro.redirect("/idees");
}

const bannerBgImage = getCategoryImage(idea.sector, idea.slug);

const levelColor = 
  idea.demarrageLevel === 'Très faible' 
    ? 'bg-emerald-500 text-white' 
    : idea.demarrageLevel === 'Conséquent'
      ? 'bg-rose-500 text-white'
      : 'bg-amber-500 text-white';

const pageTitle = `${idea.title} — Idée de Projet | ${siteConfig.title}`;
const pageDescription = `${idea.concept} Action test sous 48h sans capital.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={bannerBgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={bannerBgImage} />
  </Fragment>

  <MinimalHeader slot="header" showBackHome={true} />

  <main class="py-8 md:py-12 bg-stone-100/70 min-h-screen">
    <div class="ml-container max-w-3xl mx-auto px-4">
      
      <!-- NAVIGATION RETOUR -->
      <div class="flex items-center justify-between mb-4 text-xs font-bold text-stone-600">
        <a
          href="/idees"
          class="inline-flex items-center gap-1.5 hover:text-orange-600 transition-colors no-underline"
        >
          <span>&larr;</span>
          <span>Toutes les idées de projets</span>
        </a>
        <span class="text-stone-400 font-medium">Fiche #{idea.slug.slice(0, 8)}</span>
      </div>

      <!-- CARTE CENTRALE FICHE D'ACTION -->
      <div class="bg-white rounded-3xl border border-stone-200/90 shadow-md overflow-hidden transition-all">
        
        <!-- BANNIÈRE VISUELLE -->
        <div class="relative min-h-[220px] md:min-h-[260px] bg-stone-900 text-white p-6 md:p-8 flex flex-col justify-between overflow-hidden">
          <img
            src={bannerBgImage}
            alt={idea.title}
            class="absolute inset-0 w-full h-full object-cover opacity-80"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/30 mix-blend-multiply"></div>

          <!-- BADGES EN-TÊTE -->
          <div class="relative z-10 flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 rounded-lg text-xs font-black bg-white/95 text-stone-900 shadow-sm backdrop-blur-sm">
              {idea.sector}
            </span>
            <span class={`px-2.5 py-1 rounded-lg text-xs font-bold shadow-sm ${levelColor}`}>
              Investissement : {idea.demarrageLevel}
            </span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-black/50 text-white backdrop-blur-sm">
              📍 {idea.zoneCible}
            </span>
          </div>

          <!-- TITRE DE L'IDÉE -->
          <div class="relative z-10 mt-6">
            <h1 class="text-xl md:text-2xl lg:text-3xl font-black font-title tracking-tight text-white mb-2 leading-tight">
              {idea.title}
            </h1>
            <p class="text-xs md:text-sm text-stone-200 font-medium line-clamp-2">
              Micro-activité pensée pour l'économie locale, les marchés et les circuits courts.
            </p>
          </div>
        </div>

        <!-- CONTENU DÉTAILLÉ DE L'IDÉE -->
        <div class="p-6 md:p-8 space-y-6">
          
          <!-- EN-TÊTE ACTION IMMÉDIATE (HIGHLIGHT 48H) -->
          <div class="bg-gradient-to-br from-amber-500/10 via-orange-500/10 to-amber-600/10 border-2 border-orange-400/80 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center gap-2 text-sm font-black text-orange-900 mb-2">
              <span class="text-lg">⚡</span>
              <span>Test de validation en moins de 48h (Zéro dépense)</span>
            </div>
            <p class="text-sm font-semibold text-stone-900 leading-relaxed m-0">
              {idea.premiereAction}
            </p>
            <div class="mt-3 pt-3 border-t border-orange-200/60 flex items-center justify-between text-[11px] text-stone-600">
              <span>💡 But : valider l'intérêt réel des clients avant d'engager le moindre sou.</span>
            </div>
          </div>

          <!-- SECTION 1 : LE BESOIN OU FRICTION IDENTIFIÉE -->
          <div>
            <h2 class="text-xs font-extrabold uppercase tracking-wider text-stone-700 mb-2 flex items-center gap-2">
              <span class="w-1.5 h-3 bg-orange-500 rounded-full"></span>
              <span>1. Friction ou opportunité locale observée</span>
            </h2>
            <div class="bg-stone-50 p-4 rounded-xl border border-stone-200/70 text-xs md:text-sm text-stone-700 leading-relaxed">
              {idea.besoinIdentifie}
            </div>
          </div>

          <!-- SECTION 2 : LE CONCEPT ET SOLUTION PROPOSÉE -->
          <div>
            <h2 class="text-xs font-extrabold uppercase tracking-wider text-stone-700 mb-2 flex items-center gap-2">
              <span class="w-1.5 h-3 bg-orange-500 rounded-full"></span>
              <span>2. Le concept de micro-activité</span>
            </h2>
            <div class="p-4 rounded-xl bg-white border border-stone-200 text-xs md:text-sm text-stone-800 leading-relaxed font-medium">
              {idea.concept}
            </div>
          </div>

          <!-- SECTION 3 : PUBLIC ET CLIENTS CIBLES -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-stone-50 p-4 rounded-xl border border-stone-200/70">
              <span class="text-[11px] font-bold text-stone-500 uppercase tracking-wider block mb-1">
                👥 Public & Clients cibles
              </span>
              <p class="text-xs md:text-sm font-bold text-stone-800 m-0">
                {idea.publicCible}
              </p>
            </div>

            <div class="bg-stone-50 p-4 rounded-xl border border-stone-200/70">
              <span class="text-[11px] font-bold text-stone-500 uppercase tracking-wider block mb-1">
                📱 Canaux recommandés
              </span>
              <p class="text-xs md:text-sm font-bold text-stone-800 m-0">
                WhatsApp, Orange Money, Wave & Vente directe
              </p>
            </div>
          </div>

          <!-- SECTION 4 : COMPÉTENCES CLÉS À MOBILISER -->
          {idea.competencesCles && idea.competencesCles.length > 0 && (
            <div>
              <h2 class="text-xs font-extrabold uppercase tracking-wider text-stone-700 mb-2.5 flex items-center gap-2">
                <span class="w-1.5 h-3 bg-orange-500 rounded-full"></span>
                <span>Compétences pratiques nécessaires</span>
              </h2>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 pl-0 list-none text-xs text-stone-700 m-0">
                {idea.competencesCles.map((comp) => (
                  <li class="flex items-center gap-2 bg-stone-50 p-2.5 rounded-xl border border-stone-200/60">
                    <span class="text-orange-500 font-bold">✓</span>
                    <span class="font-semibold">{comp}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- SECTION ACTIONS & PARTAGE -->
          <div class="pt-6 border-t border-stone-200/80">
            <div class="flex flex-col sm:flex-row gap-3">
              <!-- PARTAGE WHATSAPP EN 1 CLIC -->
              <button
                type="button"
                onclick={`window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent('💡 Idée de projet pour le Mali : ' + document.title + ' ' + window.location.href), '_blank');`}
                class="flex-1 py-3.5 px-5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition-colors inline-flex items-center justify-center gap-2 shadow-sm cursor-pointer"
              >
                <span>Partager cette idée sur WhatsApp</span>
                <span>💬</span>
              </button>

              <a
                href="/opportunites"
                class="py-3.5 px-5 bg-stone-800 hover:bg-stone-900 text-white text-xs font-bold rounded-xl transition-colors inline-flex items-center justify-center gap-2 shadow-sm no-underline"
              >
                <span>Trouver un financement / concours</span>
                <span>🚀</span>
              </a>
            </div>

            <p class="text-[11px] text-stone-500 text-center mt-3">
              JobAvenir ne garantit aucun revenu. Cette fiche est une étincelle d'initiative pour vous aider à tester votre marché local.
            </p>
          </div>

        </div>

        <!-- PIED DE FICHE AVEC RETOUR -->
        <div class="bg-amber-50/60 px-6 py-4 border-t border-amber-200/60 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-stone-700">
          <span class="font-medium">Explorer d'autres initiatives entrepreneuriales</span>
          <a
            href="/idees"
            class="text-orange-600 font-extrabold hover:underline no-underline inline-flex items-center gap-1"
          >
            <span>Toutes les idées de projets</span>
            <span>&rarr;</span>
          </a>
        </div>

      </div>

    </div>
  </main>

  <Footer
    slot="footer"
    institution={siteConfig.institution}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
