---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import MinimalHeader from "../../components/MinimalHeader.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import siteConfig from "../../../site.config.json";
import { getIdeaBySlug } from "../../lib/db";
import { getCategoryImage } from "../../lib/image-bank";
import OpportunityAdminPanel from "../../components/OpportunityAdminPanel.astro";

import fs from "fs";
import path from "path";

const { slug } = Astro.params;
const idea = slug ? await getIdeaBySlug(slug) : null;

if (!idea) {
  return Astro.redirect("/idees");
}

const bannerBgImage = getCategoryImage(idea.sector, idea.slug);

let ogImagePath = `/images/og/${idea.slug}.webp`;
const localOgFile = path.resolve(process.cwd(), "public", ogImagePath.replace(/^\//, ""));
if (!fs.existsSync(localOgFile)) {
  ogImagePath = bannerBgImage || "/images/categories/default.webp";
}

const siteUrl = Astro.site?.origin || siteConfig.siteUrl || "https://job.malihub.digital";
const ogImageUrl = ogImagePath.startsWith('http') ? ogImagePath : `${siteUrl}${ogImagePath}`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const levelColor = 
  idea.demarrageLevel === 'Très faible' 
    ? 'bg-emerald-500 text-white' 
    : idea.demarrageLevel === 'Conséquent'
      ? 'bg-rose-500 text-white'
      : 'bg-amber-500 text-white';

// Titre percutant avec catégorie explicite en texte (sans émojis pour éviter les doublons avec le favicon)
const budgetTag = idea.demarrageLevel ? `(Budget ${idea.demarrageLevel.toLowerCase()})` : '';
const ogTitle = `Idée Business : ${idea.title} ${budgetTag}`.trim();
const pageTitle = `${ogTitle} — ${siteConfig.title}`;

// Description télégraphique : Problème ciblé + niveau de capital + CTA
const problemSnippet = idea.besoinIdentifie
  ? idea.besoinIdentifie.replace(/\s+/g, ' ').trim()
  : idea.concept.replace(/\s+/g, ' ').trim();

// Nettoyage pour ne jamais répéter le titre dans la description
let teaserClean = problemSnippet;
if (teaserClean.toLowerCase().startsWith(idea.title.toLowerCase())) {
  teaserClean = teaserClean.slice(idea.title.length).replace(/^[:\s.–-]+/, '').trim();
}

const actionSuffix = "Plan d'action & test 48h ➔";
const maxProblemLen = 145 - actionSuffix.length;
const truncatedProblem = teaserClean.length > maxProblemLen
  ? teaserClean.slice(0, maxProblemLen - 3) + '... '
  : teaserClean + '. ';

const pageDescription = `${truncatedProblem}${actionSuffix}`.trim();
const isImageWebp = ogImageUrl.endsWith('.webp');
const ogImageType = isImageWebp ? 'image/webp' : 'image/jpeg';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <!-- Balises OpenGraph dynamiques pour WhatsApp, Facebook, LinkedIn -->
    <meta property="og:site_name" content="JobAvenir Mali" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={idea.title} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={idea.title} />
  </Fragment>

  <MinimalHeader slot="header" showBackHome={true} />

  <main class="py-8 md:py-12 bg-stone-100/70 min-h-screen">
    <div class="ml-container max-w-3xl mx-auto px-4">
      
      <!-- NAVIGATION RETOUR -->
      <div class="flex items-center justify-between mb-4 text-xs font-bold text-stone-600">
        <a
          href="/idees"
          class="inline-flex items-center gap-1.5 hover:text-orange-600 transition-colors no-underline"
        >
          <span>&larr;</span>
          <span>Toutes les idées de projets</span>
        </a>
        <span class="text-stone-400 font-medium">Fiche #{idea.slug.slice(0, 8)}</span>
      </div>

      <!-- PANNEAU D'ADMINISTRATION IN-PAGE -->
      <OpportunityAdminPanel
        type="idea"
        slug={idea.slug}
        isActive={idea.isActive ?? true}
        title={idea.title}
        socialPublishAt={idea.socialPublishAt}
        socialStatus={idea.socialStatus}
        socialWhatsapp={idea.socialWhatsapp}
        socialTelegram={idea.socialTelegram}
        socialTiktok={idea.socialTiktok}
      />

      <!-- CARTE CENTRALE FICHE D'ACTION -->
      <div class="bg-white rounded-3xl border border-stone-200/90 shadow-md overflow-hidden transition-all">
        
        <!-- BANNIÈRE VISUELLE -->
        <div class="relative min-h-[220px] md:min-h-[260px] bg-stone-900 text-white p-6 md:p-8 flex flex-col justify-between overflow-hidden">
          <img
            src={bannerBgImage}
            alt={idea.title}
            class="absolute inset-0 w-full h-full object-cover opacity-80"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/30 mix-blend-multiply"></div>

          <!-- BADGES EN-TÊTE -->
          <div class="relative z-10 flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 rounded-lg text-xs font-black bg-amber-400 text-stone-950 shadow-sm border border-amber-300">
              💡 Idée à lancer
            </span>
            <span class="px-3 py-1 rounded-lg text-xs font-black bg-white/95 text-stone-900 shadow-sm backdrop-blur-sm">
              {idea.sector}
            </span>
            <span class={`px-2.5 py-1 rounded-lg text-xs font-bold shadow-sm ${levelColor}`}>
              Investissement : {idea.demarrageLevel}
            </span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-black/50 text-white backdrop-blur-sm">
              📍 {idea.zoneCible}
            </span>
          </div>

          <!-- TITRE DE L'IDÉE -->
          <div class="relative z-10 mt-6">
            <h1 class="text-xl md:text-2xl lg:text-3xl font-black font-title tracking-tight text-white mb-2 leading-tight">
              {idea.title}
            </h1>
            <p class="text-xs md:text-sm text-stone-200 font-medium line-clamp-2">
              Micro-activité pensée pour l'économie locale, les marchés et les circuits courts.
            </p>
          </div>
        </div>

        <!-- CONTENU DÉTAILLÉ DE L'IDÉE -->
        <div class="p-5 md:p-8 space-y-6">
          
          <!-- DÉFI 48H ULTRA-CONCRET (ZÉRO CAPITAL) -->
          <div class="bg-gradient-to-br from-amber-500/15 via-orange-500/10 to-amber-500/5 border-2 border-orange-400 rounded-2xl p-4 md:p-5 shadow-sm">
            <div class="flex items-center gap-2 text-xs md:text-sm font-black text-orange-950 uppercase tracking-wide mb-1.5">
              <span class="text-lg">⚡</span>
              <span>Défi test en 48h (0 FCFA dépensé)</span>
            </div>
            <p class="text-sm md:text-base font-bold text-stone-900 leading-snug m-0">
              {idea.premiereAction}
            </p>
            <p class="text-[11px] text-stone-600 mt-2 m-0 font-medium">
              👉 À faire avant de dépenser de l'argent : vérifier si les clients sont vraiment prêts à payer.
            </p>
          </div>

          <!-- EN 3 POINTS SIMPLES -->
          <div class="space-y-4">
            <!-- POINT 1 : LE PROBLÈME -->
            <div class="bg-stone-50 p-4 rounded-2xl border border-stone-200/80">
              <div class="flex items-center gap-2 mb-1 text-xs font-black uppercase text-stone-700 tracking-wider">
                <span>🎯</span>
                <span>Le problème constaté</span>
              </div>
              <p class="text-xs md:text-sm text-stone-800 font-medium m-0 leading-relaxed">
                {idea.besoinIdentifie}
              </p>
            </div>

            <!-- POINT 2 : CE QUE VOUS FAITES -->
            <div class="bg-stone-50 p-4 rounded-2xl border border-stone-200/80">
              <div class="flex items-center gap-2 mb-1 text-xs font-black uppercase text-stone-700 tracking-wider">
                <span>🛠️</span>
                <span>Ce que vous proposez</span>
              </div>
              <p class="text-xs md:text-sm text-stone-900 font-bold m-0 leading-relaxed">
                {idea.concept}
              </p>
            </div>

            <!-- POINT 3 : CLIENTS ET CANAUX EN 2 BLOCS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="bg-stone-50 p-3.5 rounded-2xl border border-stone-200/80">
                <span class="text-[11px] font-black text-stone-600 uppercase tracking-wider block mb-1">
                  👥 Vos futurs clients
                </span>
                <p class="text-xs md:text-sm font-bold text-stone-900 m-0">
                  {idea.publicCible}
                </p>
              </div>

              <div class="bg-stone-50 p-3.5 rounded-2xl border border-stone-200/80">
                <span class="text-[11px] font-black text-stone-600 uppercase tracking-wider block mb-1">
                  📱 Moyens simples
                </span>
                <p class="text-xs md:text-sm font-bold text-stone-900 m-0">
                  WhatsApp, Orange Money, Wave & Présentiel
                </p>
              </div>
            </div>
          </div>

          <!-- COMPÉTENCES UTILES -->
          {idea.competencesCles && idea.competencesCles.length > 0 && (
            <div>
              <div class="text-[11px] font-black uppercase tracking-wider text-stone-600 mb-2 flex items-center gap-1.5">
                <span>💪</span>
                <span>Savoir-faire utiles</span>
              </div>
              <div class="flex flex-wrap gap-2">
                {idea.competencesCles.map((comp) => (
                  <span class="inline-flex items-center gap-1 text-xs font-bold bg-amber-50 text-amber-900 border border-amber-200/80 px-3 py-1.5 rounded-xl">
                    <span class="text-orange-500">✓</span> {comp}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- BOUTONS D'ACTION DIRECTS -->
          <div class="pt-4 border-t border-stone-200/80">
            <div class="flex flex-col sm:flex-row gap-3">
              <!-- PARTAGE WHATSAPP -->
              <button
                type="button"
                onclick={`window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent('💡 Idée de projet pour le Mali : ' + document.title + ' ' + window.location.href), '_blank');`}
                class="flex-1 py-3.5 px-5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-black rounded-xl transition-colors inline-flex items-center justify-center gap-2 shadow-sm cursor-pointer"
              >
                <span>Envoyer sur WhatsApp</span>
                <span>💬</span>
              </button>

              <a
                href="/opportunites"
                class="py-3.5 px-5 bg-stone-900 hover:bg-black text-white text-xs font-black rounded-xl transition-colors inline-flex items-center justify-center gap-2 shadow-sm no-underline"
              >
                <span>Trouver un financement / concours</span>
                <span>🚀</span>
              </a>
            </div>
          </div>

        </div>

        <!-- PIED DE FICHE AVEC RETOUR -->
        <div class="bg-amber-50/60 px-6 py-4 border-t border-amber-200/60 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-stone-700">
          <span class="font-medium">Explorer d'autres initiatives entrepreneuriales</span>
          <a
            href="/idees"
            class="text-orange-600 font-extrabold hover:underline no-underline inline-flex items-center gap-1"
          >
            <span>Toutes les idées de projets</span>
            <span>&rarr;</span>
          </a>
        </div>

      </div>

    </div>
  </main>

  <Footer
    slot="footer"
    institution={siteConfig.institution}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
