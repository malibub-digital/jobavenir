---
export const prerender = false;

import BaseLayout from '@malihub/sites-core/layouts/BaseLayout.astro';
import MinimalHeader from "../../components/MinimalHeader.astro";
import Footer from '@malihub/sites-core/components/Footer.astro';
import siteConfig from '../../../site.config.json';
import { getAllDbIdeas } from '../../lib/db';
import { getCategoryImage } from '../../lib/image-bank';
import { CATEGORY_LABELS } from '../../config/categories';

const allIdeas = await getAllDbIdeas();

const levels = [
  { id: 'tous', label: 'Tous les niveaux' },
  { id: 'très faible', label: '🟢 Démarrage très faible' },
  { id: 'modéré', label: '🟡 Démarrage modéré' },
  { id: 'conséquent', label: '🔴 Démarrage conséquent' }
];

const zones = [
  { id: 'tous', label: 'Toutes les zones' },
  { id: 'bamako', label: 'Urbain (Bamako)' },
  { id: 'périurbain', label: 'Périurbain' },
  { id: 'rural', label: 'Rural & Régions' }
];
---

<BaseLayout 
  title={`Idées de Micro-Projets & Entrepreneuriat — ${siteConfig.title}`} 
  description="Concepts concrets d'activités entrepreneuriales, micro-projets et opportunités économiques contextualisés pour le Mali."
>
  <MinimalHeader slot="header" showBackHome={true} />

  <main class="py-12 bg-stone-50 min-h-screen">
    <div class="ml-container max-w-6xl mx-auto px-4">
      
      <!-- EN-TÊTE HARMONISÉ -->
      <div class="mb-10 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100/80 border border-amber-200 text-amber-800 text-xs font-bold mb-3">
          💡 Générateur d'initiatives locales
        </div>
        <h1 class="text-3xl md:text-4xl font-black text-stone-900 font-title mb-2">Idées de Micro-Projets</h1>
        <p class="text-base md:text-lg text-stone-600 font-medium">
          Concepts d'entrepreneuriat frugaux, frictions locales et <span class="text-orange-600 font-bold">actions tests réalisables sous 48h</span> sans capital.
        </p>
      </div>

      <!-- BARRE DE RECHERCHE ET FILTRES -->
      <div class="bg-white p-5 md:p-6 rounded-2xl border border-stone-200 shadow-sm mb-8">
        <div class="flex flex-col gap-4">
          <!-- Recherche textuelle -->
          <div class="relative w-full">
            <label for="search-input" class="sr-only">Rechercher une idée de projet</label>
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input
              type="text"
              id="search-input"
              placeholder="Rechercher par concept, compétence (ex: Solaire, Maraîchage, WhatsApp), besoin..."
              class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--ml-color-mandingue-orange)] focus:border-transparent transition-all"
            />
            <button
              id="clear-search-btn"
              type="button"
              class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-stone-400 hover:text-stone-600 text-sm"
              title="Effacer"
            >
              ✕
            </button>
          </div>

          <!-- Filtres déroulants -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <!-- Secteur -->
            <div>
              <label for="sector-select" class="block text-[11px] font-bold text-stone-500 mb-1 uppercase tracking-wider">Filière / Secteur</label>
              <select
                id="sector-select"
                class="w-full px-3 py-2 rounded-xl border border-stone-200 text-xs font-semibold text-stone-700 bg-white focus:outline-none focus:ring-2 focus:ring-[var(--ml-color-mandingue-orange)]"
              >
                <option value="tous">Tous les secteurs</option>
                {CATEGORY_LABELS.map((sec) => (
                  <option value={sec.toLowerCase()}>{sec}</option>
                ))}
              </select>
            </div>

            <!-- Niveau d'investissement -->
            <div>
              <label for="level-select" class="block text-[11px] font-bold text-stone-500 mb-1 uppercase tracking-wider">Niveau de départ</label>
              <select
                id="level-select"
                class="w-full px-3 py-2 rounded-xl border border-stone-200 text-xs font-semibold text-stone-700 bg-white focus:outline-none focus:ring-2 focus:ring-[var(--ml-color-mandingue-orange)]"
              >
                {levels.map((lvl) => (
                  <option value={lvl.id}>{lvl.label}</option>
                ))}
              </select>
            </div>

            <!-- Zone Cible -->
            <div>
              <label for="zone-select" class="block text-[11px] font-bold text-stone-500 mb-1 uppercase tracking-wider">Zone d'action</label>
              <select
                id="zone-select"
                class="w-full px-3 py-2 rounded-xl border border-stone-200 text-xs font-semibold text-stone-700 bg-white focus:outline-none focus:ring-2 focus:ring-[var(--ml-color-mandingue-orange)]"
              >
                {zones.map((z) => (
                  <option value={z.id}>{z.label}</option>
                ))}
              </select>
            </div>
          </div>

          <!-- Ligne Compteur & Reset -->
          <div class="flex items-center justify-between pt-2 border-t border-stone-100">
            <button
              id="reset-filters-btn"
              type="button"
              class="text-xs font-bold text-orange-600 hover:text-orange-800 hover:underline px-2 py-1 rounded-lg hover:bg-orange-50 transition-colors hidden cursor-pointer"
            >
              ✕ Réinitialiser les filtres
            </button>
            <div class="text-xs font-bold text-stone-600 bg-stone-100 px-3 py-1.5 rounded-full border border-stone-200/60 ml-auto" id="results-count">
              {allIdeas.length} idée{allIdeas.length > 1 ? 's' : ''} de projet
            </div>
          </div>
        </div>
      </div>

      <!-- ÉTAT AUCUN RÉSULTAT RECHERCHE -->
      <div id="no-results" class="hidden py-16 px-4 text-center max-w-md mx-auto bg-white rounded-2xl border border-stone-200 shadow-sm my-6">
        <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center mx-auto mb-3 text-xl font-bold">
          🔍
        </div>
        <p class="text-base font-bold text-stone-800 mb-1">Aucune idée correspondante</p>
        <p class="text-xs text-stone-500 mb-4">Essayez d'ajuster vos critères ou mots-clés.</p>
        <button
          id="btn-clear-empty"
          type="button"
          class="px-4 py-2 bg-[var(--ml-color-mandingue-orange)] text-white text-xs font-bold rounded-xl shadow-sm hover:opacity-95"
        >
          Voir toutes les idées
        </button>
      </div>

      <!-- ÉTAT VIDE GLOBAL -->
      {allIdeas.length === 0 ? (
        <div class="bg-white rounded-2xl border border-stone-200 p-12 text-center max-w-md mx-auto shadow-sm">
          <div class="w-16 h-16 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
            💡
          </div>
          <h2 class="text-lg font-bold text-stone-900 mb-2">Génération en cours</h2>
          <p class="text-xs text-stone-500 mb-4">
            Le pipeline d'exploration analyse les études de cas et innovations locales pour ajouter de nouvelles opportunités.
          </p>
          <a
            href="/opportunites"
            class="inline-block px-4 py-2 bg-[var(--ml-color-mandingue-orange)] text-white text-xs font-bold rounded-xl shadow-sm hover:opacity-95"
          >
            Explorer les opportunités actives
          </a>
        </div>
      ) : (
        <!-- GRILLE DES CARTES D'IDÉES -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="ideas-list">
          {allIdeas.map((idea) => {
            const cardImage = getCategoryImage(idea.sector, idea.slug);
            const levelColor = 
              idea.demarrageLevel === 'Très faible' 
                ? 'bg-emerald-50 text-emerald-700 border-emerald-200' 
                : idea.demarrageLevel === 'Conséquent'
                  ? 'bg-rose-50 text-rose-700 border-rose-200'
                  : 'bg-amber-50 text-amber-700 border-amber-200';

            const searchableText = `${idea.title} ${idea.sector} ${idea.zoneCible} ${idea.concept} ${idea.besoinIdentifie} ${idea.premiereAction} ${(idea.competencesCles || []).join(' ')}`.toLowerCase();

            return (
              <article 
                class="idea-card bg-white rounded-2xl border border-stone-200 shadow-sm hover:border-[var(--ml-color-mandingue-orange)] hover:shadow-md transition-all flex flex-col justify-between overflow-hidden group"
                data-sector={idea.sector.toLowerCase()}
                data-level={idea.demarrageLevel.toLowerCase()}
                data-zone={idea.zoneCible.toLowerCase()}
                data-text={searchableText}
              >
                <!-- Image d'illustration sectorielle -->
                <div class="relative h-40 w-full overflow-hidden bg-stone-100 border-b border-stone-100">
                  <img 
                    src={cardImage} 
                    alt={idea.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
                  
                  <!-- Badges flottants -->
                  <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
                    <span class="px-2.5 py-1 rounded-lg text-[10px] font-black bg-amber-500 text-stone-950 shadow-sm border border-amber-300">
                      💡 Idée à lancer
                    </span>
                    <div class="flex items-center gap-1.5">
                      <span class="px-2.5 py-1 rounded-lg text-[10px] font-extrabold bg-white/95 text-stone-900 shadow-sm backdrop-blur-sm">
                        {idea.sector}
                      </span>
                      <span class={`px-2 py-0.5 rounded-lg text-[10px] font-bold border backdrop-blur-sm bg-white/95 ${levelColor}`}>
                        {idea.demarrageLevel}
                      </span>
                    </div>
                  </div>

                  <div class="absolute bottom-3 left-3 right-3">
                    <span class="inline-block text-[11px] font-semibold text-white/90">
                      📍 {idea.zoneCible}
                    </span>
                  </div>
                </div>

                <!-- Corps de la carte -->
                <div class="p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <h2 class="text-lg font-bold text-stone-900 group-hover:text-orange-600 transition-colors mb-2 leading-snug">
                      <a href={`/idees/${idea.slug}`}>
                        {idea.title}
                      </a>
                    </h2>

                    <!-- Concept résumé -->
                    <p class="text-xs text-stone-600 mb-4 line-clamp-3 leading-relaxed">
                      {idea.concept}
                    </p>

                    <!-- Encart Action 48h (Différenciateur clé) -->
                    <div class="bg-amber-50/80 border border-amber-200/70 rounded-xl p-3 mb-4">
                      <div class="flex items-center gap-1.5 text-[11px] font-bold text-amber-900 mb-1">
                        <span>⚡ Action test sous 48h (0 budget) :</span>
                      </div>
                      <p class="text-xs text-amber-950 font-medium line-clamp-2">
                        {idea.premiereAction}
                      </p>
                    </div>

                    <!-- Compétences requises -->
                    {idea.competencesCles && idea.competencesCles.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 mb-4">
                        {idea.competencesCles.map((comp) => (
                          <span class="text-[10px] font-medium bg-stone-100 text-stone-600 px-2 py-0.5 rounded-md">
                            {comp}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>

                  <!-- Footer carte avec bouton -->
                  <div class="pt-3 border-t border-stone-100 flex items-center justify-between">
                    <span class="text-[11px] font-bold text-stone-400">
                      {idea.publicCible ? `Cible : ${idea.publicCible}` : 'Projet d\'insertion'}
                    </span>
                    <a
                      href={`/idees/${idea.slug}`}
                      class="inline-flex items-center gap-1 text-xs font-bold text-orange-600 hover:text-orange-700 hover:underline"
                    >
                      Détails de l'idée →
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}

    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const sectorSelect = document.getElementById('sector-select');
    const levelSelect = document.getElementById('level-select');
    const zoneSelect = document.getElementById('zone-select');
    const resetFiltersBtn = document.getElementById('reset-filters-btn');
    const resultsCount = document.getElementById('results-count');
    const noResults = document.getElementById('no-results');
    const btnClearEmpty = document.getElementById('btn-clear-empty');
    const cards = document.querySelectorAll('.idea-card');

    function applyFilters() {
      const textQuery = (searchInput ? searchInput.value : '').toLowerCase().trim();
      const sectorQuery = (sectorSelect ? sectorSelect.value : 'tous').toLowerCase();
      const levelQuery = (levelSelect ? levelSelect.value : 'tous').toLowerCase();
      const zoneQuery = (zoneSelect ? zoneSelect.value : 'tous').toLowerCase();

      let visibleCount = 0;

      cards.forEach(card => {
        const text = card.getAttribute('data-text') || '';
        const sector = card.getAttribute('data-sector') || '';
        const level = card.getAttribute('data-level') || '';
        const zone = card.getAttribute('data-zone') || '';

        const matchesText = !textQuery || text.includes(textQuery);
        const matchesSector = sectorQuery === 'tous' || sector.includes(sectorQuery);
        const matchesLevel = levelQuery === 'tous' || level.includes(levelQuery);
        const matchesZone = zoneQuery === 'tous' || zone.includes(zoneQuery);

        if (matchesText && matchesSector && matchesLevel && matchesZone) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (resultsCount) {
        resultsCount.textContent = `${visibleCount} idée${visibleCount > 1 ? 's' : ''} de projet`;
      }

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }

      const hasActiveFilter = Boolean(textQuery) || sectorQuery !== 'tous' || levelQuery !== 'tous' || zoneQuery !== 'tous';
      if (resetFiltersBtn) {
        resetFiltersBtn.classList.toggle('hidden', !hasActiveFilter);
      }
      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle('hidden', !textQuery);
      }
    }

    function resetFilters() {
      if (searchInput) searchInput.value = '';
      if (sectorSelect) sectorSelect.value = 'tous';
      if (levelSelect) levelSelect.value = 'tous';
      if (zoneSelect) zoneSelect.value = 'tous';
      applyFilters();
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (clearSearchBtn) clearSearchBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      applyFilters();
    });
    if (sectorSelect) sectorSelect.addEventListener('change', applyFilters);
    if (levelSelect) levelSelect.addEventListener('change', applyFilters);
    if (zoneSelect) zoneSelect.addEventListener('change', applyFilters);
    if (resetFiltersBtn) resetFiltersBtn.addEventListener('click', resetFilters);
    if (btnClearEmpty) btnClearEmpty.addEventListener('click', resetFilters);
  });
</script>
