---
import BaseLayout from "@malihub/sites-core/layouts/BaseLayout.astro";
import MinimalHeader from "../components/MinimalHeader.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import siteConfig from "../../site.config.json";
---

<BaseLayout
  title={`Guide & Documentation — ${siteConfig.title}`}
  description="Guide complet pour comprendre la mission de Sites Faciles, utiliser le moteur CMS et déployer des sites conformes au DSML."
>
  <MinimalHeader slot="header" />

  <main
    id="main-content"
    class="py-12 bg-[var(--ml-color-bogolan-kaolin)]/50 min-h-screen"
  >
    <div class="ml-container max-w-4xl mx-auto px-4">
      <nav class="text-xs text-[var(--ml-color-neutral-500)] mb-6 flex gap-2">
        <a href="/" class="hover:underline text-[var(--ml-color-neutral-600)]"
          >Accueil</a
        >
        <span>/</span>
        <span class="text-[var(--ml-color-neutral-800)] font-semibold"
          >Guide & Documentation</span
        >
      </nav>

      <!-- Banner Header -->
      <div
        class="relative rounded-3xl overflow-hidden mb-12 bg-gradient-to-r from-[var(--ml-color-river-800)] via-[var(--ml-color-indigo-700)] to-[var(--ml-color-indigo-900)] text-white p-8 md:p-12 shadow-xl border-2 border-[var(--ml-color-mandingue-orange)]/50"
      >
        <div
          class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-[var(--ml-color-mandingue-500)] via-transparent to-transparent pointer-events-none"
        >
        </div>
        <div class="relative z-10">
          <span
            class="inline-flex items-center gap-1.5 bg-white/15 text-[var(--ml-color-mandingue-100)] text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-wider mb-4 border border-white/20 backdrop-blur-md"
          >
            Documentation Officielle
          </span>
          <h1
            class="text-3xl md:text-4xl font-black font-title tracking-tight text-[var(--ml-color-mandingue-100)] mb-3 drop-shadow-md"
          >
            Guide d'Utilisation & Prise en Main
          </h1>
          <p
            class="text-sm md:text-base text-white/95 leading-relaxed font-medium"
          >
            Découvrez comment Sites Faciles Mali simplifie la création,
            l'édition et le déploiement de portails institutionnels conformes à
            la charte DSML.
          </p>
        </div>
      </div>

      <!-- Content Sections -->
      <div class="space-y-10">
        <!-- 1. Vocation du projet -->
        <section
          class="bg-white p-8 rounded-3xl border border-[var(--ml-color-neutral-200)] shadow-sm"
        >
          <div class="flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-full bg-[var(--ml-color-mandingue-50)] text-[var(--ml-color-mandingue-700)] flex items-center justify-center font-bold text-sm border border-[var(--ml-color-mandingue-200)]"
              >1</span
            >
            <h2
              class="text-xl font-extrabold text-[var(--ml-color-neutral-900)] font-title m-0"
            >
              Vocation & Mission de Sites Faciles
            </h2>
          </div>
          <p
            class="text-sm text-[var(--ml-color-neutral-700)] leading-relaxed mb-4"
          >
            <strong>Sites Faciles Mali</strong> a été conçu pour résoudre un défi
            récurrent des administrations publiques : la création rapide de sites
            web modernes, sécurisés et visuellement cohérents sans réinventer la roue.
          </p>
          <ul
            class="space-y-2 text-xs text-[var(--ml-color-neutral-700)] list-disc pl-5"
          >
            <li>
              <strong>Conformité au Design System Mali (DSML) :</strong> L'intégration native du
              Design System Mali (la charte graphique et ergonomique officielle des sites publics du Mali) assure le respect des couleurs, typographies et pictogrammes
              officiels.
            </li>
            <li>
              <strong>Édition sans code :</strong> Les agents et rédacteurs peuvent
              modifier les contenus directement depuis l'interface grâce au CMS inline.
            </li>
            <li>
              <strong>Déploiement Git automatisé :</strong> Publication des contenus
              en temps réel via des commits Git automatiques sur Dokploy/GitHub.
            </li>
          </ul>
        </section>

        <!-- 2. Guide d'édition CMS -->
        <section
          class="bg-white p-8 rounded-3xl border border-[var(--ml-color-neutral-200)] shadow-sm"
        >
          <div class="flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-full bg-[var(--ml-color-river-50)] text-[var(--ml-color-river-700)] flex items-center justify-center font-bold text-sm border border-[var(--ml-color-river-200)]"
              >2</span
            >
            <h2
              class="text-xl font-extrabold text-[var(--ml-color-neutral-900)] font-title m-0"
            >
              Mode Édition & CMS Inline
            </h2>
          </div>
          <p
            class="text-sm text-[var(--ml-color-neutral-700)] leading-relaxed mb-4"
          >
            Le mode édition permet d'éditer le texte directement sur les pages
            sans passer par un tableau de bord complexe.
          </p>
          <ol
            class="space-y-3 text-xs text-[var(--ml-color-neutral-700)] list-decimal pl-5"
          >
            <li>
              Rendez-vous sur la page d'administration <code>/admin</code> pour déverrouiller
              l'accès.
            </li>
            <li>
              Activez l'interrupteur <strong>"Mode Édition"</strong> dans le bandeau
              supérieur d'administration.
            </li>
            <li>
              Survolez n'importe quel élément entouré d'un pointillé bleu pour
              cliquer et modifier son contenu.
            </li>
            <li>
              Cliquez sur <strong>"Publier les modifications"</strong> dans le bandeau
              supérieur pour valider et enregistrer.
            </li>
          </ol>
        </section>

        <!-- 3. Configuration & Guide Développeur -->
        <section
          class="bg-white p-8 rounded-3xl border border-[var(--ml-color-neutral-200)] shadow-sm"
        >
          <div class="flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-full bg-[var(--ml-color-green-50)] text-[var(--ml-color-green-700)] flex items-center justify-center font-bold text-sm border border-[var(--ml-color-green-200)]"
              >3</span
            >
            <h2
              class="text-xl font-extrabold text-[var(--ml-color-neutral-900)] font-title m-0"
            >
              Guide Développeur & Méthodes d'Installation
            </h2>
          </div>
          <p
            class="text-sm text-[var(--ml-color-neutral-700)] leading-relaxed mb-6"
          >
            Pour créer un nouveau portail institutionnel ou intégrer <strong>Sites Faciles Mali</strong>, trois approches adaptées à votre flux de travail sont disponibles :
          </p>

          <div class="space-y-6">
            <!-- Méthode 1 -->
            <div class="border border-[var(--ml-color-neutral-200)] rounded-2xl p-5 bg-[var(--ml-color-neutral-50)]">
              <h3 class="text-sm font-extrabold text-[var(--ml-color-neutral-900)] mb-2 font-title">
                Méthode 1 — Cloner / Copier le dépôt complet monorépo
              </h3>
              <p class="text-xs text-[var(--ml-color-neutral-700)] mb-3">
                Pour développer le moteur, modifier les composants cœurs de <code>@malihub/sites-core</code> ou disposer d'un environnement monorépo complet.
              </p>
              <div class="bg-[var(--ml-color-neutral-900)] text-white p-4 rounded-xl text-xs font-mono overflow-x-auto">
                <div class="text-[var(--ml-color-gold-400)] mb-1"># Cloner et installer</div>
                <div>git clone https://github.com/malibub-digital/sites.git mon-site</div>
                <div>cd mon-site && npm install</div>
                <div>npm run dev</div>
              </div>
            </div>

            <!-- Méthode 2 -->
            <div class="border border-[var(--ml-color-neutral-200)] rounded-2xl p-5 bg-[var(--ml-color-neutral-50)]">
              <h3 class="text-sm font-extrabold text-[var(--ml-color-neutral-900)] mb-2 font-title">
                Méthode 2 — Copier le dossier <code>template</code> d'amorçage
              </h3>
              <p class="text-xs text-[var(--ml-color-neutral-700)] mb-3">
                Pour démarrer un projet autonome avec toutes les pages d'exemple, les fiches démarches et la configuration CMS préinstallées.
              </p>
              <div class="bg-[var(--ml-color-neutral-900)] text-white p-4 rounded-xl text-xs font-mono overflow-x-auto">
                <div class="text-[var(--ml-color-gold-400)] mb-1"># Copier le template & installer</div>
                <div>cp -r sites/template mon-nouveau-site</div>
                <div>cd mon-nouveau-site && npm install</div>
                <div>npm run dev</div>
              </div>
            </div>

            <!-- Méthode 3 -->
            <div class="border border-[var(--ml-color-neutral-200)] rounded-2xl p-5 bg-[var(--ml-color-neutral-50)]">
              <h3 class="text-sm font-extrabold text-[var(--ml-color-neutral-900)] mb-2 font-title">
                Méthode 3 — Installer le package <code>@malihub/sites-core</code> via NPM
              </h3>
              <p class="text-xs text-[var(--ml-color-neutral-700)] mb-3">
                Pour ajouter le moteur CMS et les composants certifiés DSML dans une application Astro existante.
              </p>
              <div class="bg-[var(--ml-color-neutral-900)] text-white p-4 rounded-xl text-xs font-mono overflow-x-auto mb-3">
                <div>npm install @malihub/sites-core @malihub/dsml-core</div>
              </div>
              <div class="bg-[var(--ml-color-neutral-900)] text-white p-4 rounded-xl text-xs font-mono overflow-x-auto">
                <div class="text-[var(--ml-color-mandingue-100)]">---</div>
                <div class="text-[var(--ml-color-gold-400)]">import &#123; BaseLayout, Header, Footer, Hero, ServiceCard &#125; from '@malihub/sites-core';</div>
                <div class="text-[var(--ml-color-gold-400)]">import siteConfig from '../site.config.json';</div>
                <div class="text-[var(--ml-color-mandingue-100)]">---</div>
                <div class="mt-1">&lt;BaseLayout title=&#123;siteConfig.title&#125;&gt;</div>
                <div class="pl-4">&lt;Header slot="header" title=&#123;siteConfig.title&#125; institution=&#123;siteConfig.institution&#125; /&gt;</div>
                <div class="pl-4">&lt;main id="main-content" class="py-12"&gt;</div>
                <div class="pl-8">&lt;Hero title="Bienvenue" subtitle="Portail Officiel" /&gt;</div>
                <div class="pl-4">&lt;/main&gt;</div>
                <div class="pl-4">&lt;Footer slot="footer" institution=&#123;siteConfig.institution&#125; contact=&#123;siteConfig.contact&#125; /&gt;</div>
                <div>&lt;/BaseLayout&gt;</div>
              </div>
            </div>

            <!-- Composants inclus -->
            <div>
              <h4 class="text-xs font-bold text-[var(--ml-color-neutral-900)] uppercase tracking-wider mb-2">
                Composants Cœurs Disponibles dans <code>@malihub/sites-core</code> :
              </h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                <div class="p-2.5 bg-[var(--ml-color-green-50)] rounded-lg border border-[var(--ml-color-green-200)]">
                  <code>BaseLayout</code> — Layout HTML5 universel DSML + SEO + CMS
                </div>
                <div class="p-2.5 bg-[var(--ml-color-green-50)] rounded-lg border border-[var(--ml-color-green-200)]">
                  <code>Header</code> — En-tête républicain & navigation
                </div>
                <div class="p-2.5 bg-[var(--ml-color-green-50)] rounded-lg border border-[var(--ml-color-green-200)]">
                  <code>Footer</code> — Pied de page institutionnel & liens
                </div>
                <div class="p-2.5 bg-[var(--ml-color-green-50)] rounded-lg border border-[var(--ml-color-green-200)]">
                  <code>Hero</code> — Bannière d'accueil & accès rapide
                </div>
                <div class="p-2.5 bg-[var(--ml-color-green-50)] rounded-lg border border-[var(--ml-color-green-200)]">
                  <code>ServiceCard</code> — Carte de démarche réutilisable
                </div>
                <div class="p-2.5 bg-[var(--ml-color-green-50)] rounded-lg border border-[var(--ml-color-green-200)]">
                  <code>EmergencyBanner</code> — Alerte urgente sticky
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 4. Protocole d'Assistance IA (LLM) -->
        <section
          class="bg-white p-8 rounded-3xl border border-[var(--ml-color-neutral-200)] shadow-sm"
        >
          <div class="flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-full bg-[var(--ml-color-indigo-50)] text-[var(--ml-color-indigo-700)] flex items-center justify-center font-bold text-sm border border-[var(--ml-color-indigo-200)]"
              >4</span
            >
            <h2
              class="text-xl font-extrabold text-[var(--ml-color-neutral-900)] font-title m-0"
            >
              Protocole pour Assistants de Code & LLM
            </h2>
          </div>
          <p
            class="text-sm text-[var(--ml-color-neutral-700)] leading-relaxed mb-4"
          >
            Le projet fournit des directives et des inventaires standards pour alimenter vos assistants de code (Cursor, Windsurf, Copilot, Antigravity...) :
          </p>
          <ul class="space-y-2 text-xs text-[var(--ml-color-neutral-700)] list-disc pl-5 mb-4">
            <li><strong>Fichier <code>AI_RULES.md</code> :</strong> Règles d'architecture, découpage des bindings <code>data-cms-bind</code> et configurations d'IDE.</li>
            <li><strong>Fichier <code>/llms.txt</code> :</strong> Guide standardisé exposé publiquement à la racine du domaine pour tout agent ou LLM externe.</li>
          </ul>
          <a
            href="/llms.txt"
            target="_blank"
            class="inline-flex items-center gap-2 text-xs font-bold text-[var(--ml-color-indigo-700)] hover:underline"
          >
            <span>Consulter le fichier /llms.txt en direct</span>
            <span>&rarr;</span>
          </a>
        </section>

        <!-- Call to Action -->
        <div
          class="bg-gradient-to-r from-[var(--ml-color-river-800)] to-[var(--ml-color-indigo-900)] p-8 rounded-3xl text-white flex flex-wrap items-center justify-between gap-6 shadow-lg"
        >
          <div>
            <h3 class="text-lg font-black font-title text-white m-0 mb-1">
              Prêt à explorer la bibliothèque ?
            </h3>
            <p class="text-xs text-white/80 m-0">
              Découvrez l'ensemble des palettes et des éléments UI certifiés
              DSML.
            </p>
          </div>
          <a
            href="/composants"
            class="px-6 py-3 bg-[var(--ml-color-mandingue-orange)] hover:bg-[var(--ml-color-mandingue-700)] text-white font-bold rounded-xl text-xs transition-all no-underline inline-flex items-center gap-2"
          >
            <span>Bibliothèque de Composants</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer
    slot="footer"
    institution={siteConfig.institution}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
