---
import BaseLayout from '../layouts/BaseLayout.astro';
import MinimalHeader from "../components/MinimalHeader.astro";
import Footer from '@malihub/sites-core/components/Footer.astro';
import siteConfig from '../../site.config.json';

const footerLogos = [
  { src: "/images/logo-apej.svg", alt: "APEJ Mali" },
  { src: "/images/logo-eoj.svg", alt: "EOJ Mali" },
  { src: "/images/logo-particip.png", alt: "PartiCIP" },
];
---

<BaseLayout
  title={`À propos de Mali Job — Présentation & Écosystème Partenaire`}
  description="Découvrez la mission de Mali Job, plateforme nationale d'accès à l'emploi et aux opportunités, sous l'égide de l'APEJ avec les EOJ et PartiCIP."
>
  <MinimalHeader slot="header" showBackHome={true} />

  <main id="main-content" class="min-h-screen">
    <!-- HERO SECTION -->
    <section class="relative overflow-hidden bg-gradient-to-br from-stone-900 via-stone-800 to-amber-900/90 text-white py-16 md:py-24">
      <!-- Decorative elements -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 rounded-full bg-amber-500/5 blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full bg-orange-500/5 blur-3xl"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-amber-400/3 blur-3xl"></div>
      </div>

      <div class="relative z-10 ml-container max-w-5xl mx-auto px-4">
        <nav class="text-xs text-amber-200/70 mb-8 flex gap-2 items-center">
          <a href="/" class="hover:text-white transition-colors">Accueil</a>
          <span class="text-amber-300/40">/</span>
          <span class="text-amber-200 font-semibold">À propos</span>
        </nav>

        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-amber-400/15 text-amber-300 border border-amber-400/30 mb-5 shadow-sm backdrop-blur-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Dispositif National pour l'Emploi
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-black font-title tracking-tight leading-[1.08] mb-4">
            À propos de <br /><span class="text-amber-400">Mali Job</span>
          </h1>
          <p class="text-base sm:text-lg text-stone-300 leading-relaxed max-w-2xl">
            Mali Job (<strong class="text-white">malijob.ml</strong>) est le guichet numérique unifié des débouchés professionnels, de l'insertion et de l'entrepreneuriat au Mali.
          </p>
          <!-- Quick stats -->
          <div class="grid grid-cols-3 gap-4 sm:gap-6 mt-8 pt-8 border-t border-white/10 max-w-lg">
            <div>
              <div class="text-2xl sm:text-3xl font-black text-amber-400">+100</div>
              <div class="text-[11px] text-stone-400 font-semibold uppercase tracking-wider mt-0.5">Opportunités / mois</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-amber-400">4</div>
              <div class="text-[11px] text-stone-400 font-semibold uppercase tracking-wider mt-0.5">Types d'offres</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-amber-400">100%</div>
              <div class="text-[11px] text-stone-400 font-semibold uppercase tracking-wider mt-0.5">Gratuit</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTENU PRINCIPAL -->
    <section class="py-12 md:py-16 bg-stone-50">
      <div class="ml-container max-w-4xl mx-auto px-4 space-y-10 md:space-y-12">

        <!-- NOTRE MISSION -->
        <div class="bg-white p-8 md:p-10 rounded-3xl shadow-sm border border-stone-200/80">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-lg shrink-0 shadow-sm">🎯</div>
            <div>
              <h2 class="text-xl font-black text-stone-900 font-title m-0">Notre Mission</h2>
              <p class="text-xs text-stone-400 m-0">Ce qui nous anime au quotidien</p>
            </div>
          </div>
          <div class="relative pl-5 border-l-2 border-amber-400/50">
            <p class="text-sm text-stone-700 leading-relaxed">
              Centraliser, fiabiliser et démocratiser l'accès à l'information sur le marché de l'emploi malien. Mali Job agrège quotidiennement les opportunités vérifiées : <strong>emplois</strong> (CDI, CDD), <strong>stages</strong> professionnels, programmes de <strong>formation</strong> certifiante, appels à <strong>projets</strong> et subventions, ainsi que des fiches d'<strong>idées entrepreneuriales</strong> concrètes adaptées aux réalités économiques locales.
            </p>
          </div>
        </div>

        <!-- CADRE OFFICIEL DU DISPOSITIF -->
        <div class="relative">
          <!-- Decorative connector -->
          <div class="absolute -left-3 top-0 bottom-0 w-0.5 bg-gradient-to-b from-amber-400/30 via-orange-400/20 to-transparent hidden md:block"></div>

          <div class="bg-gradient-to-br from-stone-900 to-stone-800 p-8 md:p-10 rounded-3xl shadow-lg border border-stone-700/80">
            <!-- Header badge -->
            <div class="flex flex-wrap items-center gap-3 mb-5">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-400/15 text-amber-300 border border-amber-400/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                Document officiel — APEJ
              </span>
              <span class="text-xs text-stone-500">Bamako, le 6 novembre 2026</span>
            </div>

            <h2 class="text-xl md:text-2xl font-black text-white font-title leading-tight mb-2">
              Mali Job, une plateforme publique<br class="hidden sm:block" />
              <span class="text-amber-400">au service des opportunités</span>
            </h2>
            <p class="text-xs text-stone-500 mb-6 italic">Avec l'appui institutionnel du Programme PartiCIP – Swisscontact / C2D</p>

            <p class="text-sm text-stone-300 leading-relaxed mb-6">
              L'Agence pour la Promotion de l'Emploi des Jeunes (APEJ), avec l'appui institutionnel du Programme PartiCIP, un projet de la DDC, mis en œuvre par Swisscontact/C2D, met en place <strong class="text-white">Mali Job</strong>, une plateforme publique destinée à centraliser et diffuser les opportunités d'emploi, de stage, de formation et d'entrepreneuriat au Mali. Accessible via <strong class="text-white">malijob.ml</strong>, cette initiative vise à améliorer l'accès des jeunes à une information fiable, actualisée et facilement accessible, tout en renforçant la visibilité des opportunités portées par les différents acteurs de l'écosystème de l'emploi et de la formation.
            </p>

            <!-- 4 piliers en grille -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
              <div class="bg-white/5 backdrop-blur-sm p-4 rounded-xl border border-white/10 hover:bg-white/10 transition-colors">
                <span class="text-lg block mb-2">📢</span>
                <h4 class="text-sm font-bold text-white mb-1">Valorisation des investissements</h4>
                <p class="text-xs text-stone-400 leading-relaxed">Mali Job améliore la visibilité des opportunités financées, touche davantage de bénéficiaires et démontre l'impact des financements mobilisés.</p>
              </div>
              <div class="bg-white/5 backdrop-blur-sm p-4 rounded-xl border border-white/10 hover:bg-white/10 transition-colors">
                <span class="text-lg block mb-2">💼</span>
                <h4 class="text-sm font-bold text-white mb-1">Canal pour les entreprises</h4>
                <p class="text-xs text-stone-400 leading-relaxed">Un canal pour promouvoir recrutements, stages et alternances, rapprochant les entreprises des talents.</p>
              </div>
              <div class="bg-white/5 backdrop-blur-sm p-4 rounded-xl border border-white/10 hover:bg-white/10 transition-colors">
                <span class="text-lg block mb-2">🔗</span>
                <h4 class="text-sm font-bold text-white mb-1">Complémentarité & trafic source</h4>
                <p class="text-xs text-stone-400 leading-relaxed">Les opportunités renvoient vers leur source officielle. La plateforme amplifie sans se substituer.</p>
              </div>
              <div class="bg-white/5 backdrop-blur-sm p-4 rounded-xl border border-white/10 hover:bg-white/10 transition-colors">
                <span class="text-lg block mb-2">🆓</span>
                <h4 class="text-sm font-bold text-white mb-1">Gratuit, neutre et non commercial</h4>
                <p class="text-xs text-stone-400 leading-relaxed">Aucune contribution financière demandée. Un outil collectif au service de tous.</p>
              </div>
            </div>

            <!-- Citation -->
            <div class="bg-amber-400/10 p-5 rounded-2xl border border-amber-400/20 text-center">
              <p class="text-sm md:text-base font-bold text-amber-200 leading-relaxed">
                « Mali Job : une plateforme unique pour rendre les opportunités plus visibles,<br class="hidden sm:block" />
                les investissements plus efficaces et les jeunes mieux connectés aux perspectives d'avenir. »
              </p>
            </div>
          </div>
        </div>

        <!-- LES 3 PILIERS -->
        <div class="text-center max-w-lg mx-auto mb-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200/60 mb-3">
            Notre approche
          </span>
          <h2 class="text-2xl font-black text-stone-900 font-title m-0">Les 3 piliers de Mali Job</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div class="group bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
            <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition-transform shadow-sm">🔦</div>
            <h3 class="text-base font-black text-stone-900 font-title mb-2">Accessibilité Frugale</h3>
            <p class="text-sm text-stone-600 leading-relaxed">Interface ultra-légère conçue pour consommer un minimum de données mobiles (DSML).</p>
          </div>
          <div class="group bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
            <div class="w-12 h-12 rounded-xl bg-orange-100 text-orange-700 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition-transform shadow-sm">🔍</div>
            <h3 class="text-base font-black text-stone-900 font-title mb-2">Veille Exhaustive</h3>
            <p class="text-sm text-stone-600 leading-relaxed">Surveillance continue des sources officielles, parapubliques, ONG et secteur privé.</p>
          </div>
          <div class="group bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
            <div class="w-12 h-12 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition-transform shadow-sm">👥</div>
            <h3 class="text-base font-black text-stone-900 font-title mb-2">Orientation Active</h3>
            <p class="text-sm text-stone-600 leading-relaxed">Passerelle directe vers les structures d'orientation et de mentorat sur le terrain.</p>
          </div>
        </div>

        <!-- ÉCOSYSTÈME PARTENAIRE -->
        <div id="partenaires" class="scroll-mt-20">
          <div class="text-center max-w-lg mx-auto mb-8">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-stone-900 text-amber-300 border border-stone-800 mb-3">
              Écosystème institutionnel
            </span>
            <h2 class="text-2xl font-black text-stone-900 font-title m-0">Partenaires & Institutions</h2>
            <p class="text-sm text-stone-500 mt-2">Mali Job repose sur une alliance tripartite pour maximiser l'impact auprès de la jeunesse malienne.</p>
          </div>

          <div class="space-y-4">
            <!-- APEJ -->
            <div class="group bg-white p-6 md:p-7 rounded-2xl border border-stone-200 shadow-sm hover:shadow-md transition-all">
              <div class="flex flex-col sm:flex-row items-start gap-5">
                <div class="w-16 h-16 shrink-0 bg-amber-50 rounded-2xl p-3 border border-amber-200/70 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <img src="/images/logo-apej.svg" alt="APEJ Mali" class="max-h-10 w-auto object-contain" />
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2 flex-wrap mb-1.5">
                    <h3 class="text-base font-black text-stone-900 font-title">APEJ Mali</h3>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-900 border border-amber-300">Institution Mandataire</span>
                  </div>
                  <p class="text-sm text-stone-600 leading-relaxed">
                    L'Agence Pour la Promotion de l'Emploi des Jeunes est l'organe d'exécution du Programme Emploi-Jeunes (PEJ). Elle impulse la politique d'insertion, pilote les grands programmes de stages de qualification et facilite le financement des projets pour les jeunes de 15 à 40 ans.
                  </p>
                </div>
              </div>
            </div>

            <!-- EOJ -->
            <div class="group bg-white p-6 md:p-7 rounded-2xl border border-stone-200 shadow-sm hover:shadow-md transition-all">
              <div class="flex flex-col sm:flex-row items-start gap-5">
                <div class="w-16 h-16 shrink-0 bg-orange-50 rounded-2xl p-3 border border-orange-200/70 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <img src="/images/logo-eoj.svg" alt="EOJ Mali" class="max-h-10 w-auto object-contain" />
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2 flex-wrap mb-1.5">
                    <h3 class="text-base font-black text-stone-900 font-title">EOJ Mali</h3>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-orange-100 text-orange-900 border border-orange-300">Orientation Terrain</span>
                  </div>
                  <p class="text-sm text-stone-600 leading-relaxed">
                    Dispositif transversal de proximité qui offre un accueil personnalisé, des bilans de compétences, un accompagnement à la recherche d'emploi et des ateliers pratiques animés par des conseillers qualifiés à Bamako et dans les régions.
                  </p>
                </div>
              </div>
            </div>

            <!-- PartiCIP -->
            <div class="group bg-white p-6 md:p-7 rounded-2xl border border-stone-200 shadow-sm hover:shadow-md transition-all">
              <div class="flex flex-col sm:flex-row items-start gap-5">
                <div class="w-16 h-16 shrink-0 bg-sky-50 rounded-2xl p-3 border border-sky-200/70 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <img src="/images/logo-particip.png" alt="PartiCIP" class="max-h-10 w-auto object-contain rounded-lg" />
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2 flex-wrap mb-1.5">
                    <h3 class="text-base font-black text-stone-900 font-title">Programme PartiCIP</h3>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-sky-100 text-sky-900 border border-sky-300">Formation & Compétences</span>
                  </div>
                  <p class="text-sm text-stone-600 leading-relaxed">
                    Programme innovant axé sur le développement des compétences professionnelles inclusives et pérennes, l'apprentissage adapté aux filières locales et l'implication du secteur privé pour une insertion durable des jeunes de 15 à 35 ans.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="bg-gradient-to-br from-orange-500 to-amber-600 p-8 md:p-10 rounded-3xl shadow-lg text-center">
          <div class="max-w-xl mx-auto">
            <h2 class="text-xl md:text-2xl font-black text-white font-title mb-3">Vous souhaitez publier une offre ou rejoindre notre réseau ?</h2>
            <p class="text-sm text-orange-100 mb-6">Rejoignez les partenaires qui diffusent leurs opportunités auprès de milliers de jeunes talents chaque mois.</p>
            <a href="/contact"
               class="inline-flex items-center gap-2 px-8 py-3.5 rounded-2xl bg-white text-orange-700 hover:bg-orange-50 font-black text-sm shadow-lg hover:shadow-xl transition-all no-underline">
              <span>Contacter l'équipe Mali Job</span>
              <span class="text-lg leading-none">→</span>
            </a>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer serviceName={siteConfig.title} serviceTagline="un dispositif de l'APEJ"
    slot="footer"
    institution={siteConfig.institution}
    partnerLogos={footerLogos}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
