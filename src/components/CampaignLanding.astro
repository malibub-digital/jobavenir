---
interface Props {
  campaign: any;
  isHomePrelaunch?: boolean;
  allCampaigns?: any[];
}

const { campaign, isHomePrelaunch = false } = Astro.props;
---

<!-- BLOC 1 : HERO TOUT-EN-UN ULTRA-ÉPURÉ (LECTURE EN 5 SECONDES) -->
<section
  class="ml-hero bg-gradient-to-b from-amber-50/95 via-orange-50/35 to-white text-stone-900 pt-7 pb-12 sm:py-14 px-3 sm:px-4 relative overflow-hidden border-b border-stone-200/80"
>
  <!-- Illustrations latérales Mali Job -->
  <div
    class="hero-illustration-left hidden md:block absolute -left-2 lg:left-4 bottom-0 w-[200px] lg:w-[290px] xl:w-[350px] pointer-events-none select-none z-0 opacity-85 lg:opacity-95"
  >
    <picture>
      <source srcset="/images/jobavenir-4.webp" type="image/webp" />
      <img
        src="/images/jobavenir-4.png"
        alt="Illustration Métiers et Innovation Mali"
        class="w-full h-auto object-contain object-left-bottom drop-shadow-md max-h-[390px]"
        width="800"
        height="818"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>

  <div
    class="hero-illustration-right hidden md:block absolute -right-2 lg:right-4 bottom-0 w-[200px] lg:w-[290px] xl:w-[350px] pointer-events-none select-none z-0 opacity-85 lg:opacity-95"
  >
    <picture>
      <source srcset="/images/jobavenir-5.webp" type="image/webp" />
      <img
        src="/images/jobavenir-5.png"
        alt="Illustration Opportunités Jeunesse Mali"
        class="w-full h-auto object-contain object-right-bottom drop-shadow-md max-h-[390px]"
        width="800"
        height="818"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>

  <div class="w-full max-w-3xl mx-auto text-center relative z-10 px-2 sm:px-4">
    <!-- Petit badge court -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-stone-900 text-amber-300 text-xs font-extrabold mb-4 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>
        {isHomePrelaunch
          ? "Bientôt : Ouverture des offres d'emploi Mali Job"
          : campaign.badge}
      </span>
    </div>

    <!-- Titre direct et court -->
    <h1
      class="text-2xl sm:text-4xl md:text-5xl font-black font-title tracking-tight text-stone-900 leading-[1.15] mb-5"
    >
      Grand Concours d'Innovation<br />
      <span class="text-orange-600">{campaign.highlightTitle}</span>
    </h1>

    <!-- Les 2 récompenses résumées en 2 cartes courtes et visuelles -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-2xl mx-auto mb-6 text-left">
      <div class="bg-white/95 p-3.5 sm:p-4 rounded-2xl border-2 border-amber-300 shadow-xs flex items-start gap-3">
        <span class="text-2xl leading-none shrink-0 mt-0.5">🥇</span>
        <div>
          <div class="text-xs sm:text-sm font-black text-stone-900">
            {campaign.prizes.grandPrizeCount} Grands Prix de {campaign.prizes.grandPrizeAmount}
          </div>
          <div class="text-xs text-stone-600 mt-0.5">
            Financement direct + mise à l'honneur sur le site officiel.
          </div>
        </div>
      </div>

      <div class="bg-white/95 p-3.5 sm:p-4 rounded-2xl border-2 border-emerald-300 shadow-xs flex items-start gap-3">
        <span class="text-2xl leading-none shrink-0 mt-0.5">🌟</span>
        <div>
          <div class="text-xs sm:text-sm font-black text-stone-900">
            {campaign.prizes.laureateCount} Projets publiés sur Mali Job
          </div>
          <div class="text-xs text-stone-600 mt-0.5">
            Une page officielle dédiée pour vous faire connaître et lever des fonds.
          </div>
        </div>
      </div>
    </div>

    <!-- CARTE D'ACTION UNIQUE : REJOINDRE WHATSAPP OU TELEGRAM -->
    <div class="bg-white p-5 sm:p-6 rounded-3xl shadow-xl shadow-orange-950/10 border-2 border-orange-300 max-w-2xl mx-auto text-left relative z-20">
      <div class="text-sm sm:text-base font-black text-stone-900 mb-3 text-center sm:text-left">
        📲 Rejoignez notre groupe WhatsApp ou Telegram pour :
      </div>

      <ul class="space-y-2 mb-5 text-xs sm:text-sm text-stone-800 font-semibold list-none p-0">
        <li class="flex items-center gap-2.5 bg-amber-50/90 px-3.5 py-2.5 rounded-xl border border-amber-200/80">
          <span class="w-5 h-5 rounded-full bg-orange-600 text-white text-xs font-black flex items-center justify-center shrink-0">1</span>
          <span>
            <strong>Participer au concours</strong> <span class="text-stone-600 font-normal">(consignes dans le groupe : 1 vidéo simple &lt; {campaign.submission.maxDurationMinutes} min)</span>
          </span>
        </li>
        <li class="flex items-center gap-2.5 bg-stone-50 px-3.5 py-2.5 rounded-xl border border-stone-200/80">
          <span class="w-5 h-5 rounded-full bg-emerald-600 text-white text-xs font-black flex items-center justify-center shrink-0">2</span>
          <span>
            <strong>Recevoir nos opportunités</strong> <span class="text-stone-600 font-normal">(emplois, stages, formations, appels à projets, idées business)</span>
          </span>
        </li>
      </ul>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a
          href={campaign.community.whatsappGroupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-extrabold py-3.5 px-5 rounded-2xl shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-2.5 no-underline text-sm sm:text-base"
        >
          <svg class="w-5 h-5 shrink-0 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.126.556 4.124 1.529 5.856l-1.529 5.584 5.735-1.504c1.693.924 3.631 1.451 5.694 1.451 6.627 0 12-5.373 12-12 0-6.627-5.373-12-11.429-11.387z"/>
          </svg>
          <span>Rejoindre sur WhatsApp</span>
        </a>

        <a
          href={campaign.community.telegramGroupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-sky-600 hover:bg-sky-700 active:scale-[0.99] text-white font-extrabold py-3.5 px-5 rounded-2xl shadow-md shadow-sky-600/20 transition-all flex items-center justify-center gap-2.5 no-underline text-sm sm:text-base"
        >
          <svg class="w-5 h-5 shrink-0 fill-current" viewBox="0 0 24 24">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          <span>Rejoindre sur Telegram</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- BLOC 2 : ENCART SPONSORING COMPACT -->
<section class="py-8 bg-stone-50 border-b border-stone-200">
  <div class="ml-container max-w-4xl mx-auto px-4">
    <div class="bg-white rounded-2xl p-5 sm:p-6 border border-amber-300/90 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <span class="text-[11px] font-black uppercase tracking-wider text-orange-700 block mb-0.5">
          🤝 Entreprises, ONG, Institutions & Diaspora
        </span>
        <h2 class="text-base sm:text-lg font-black text-stone-900 font-title m-0">
          Vous souhaitez sponsoriser un prix d'innovation (ou notre prochaine édition Agricole) ?
        </h2>
      </div>
      <a
        href={campaign.sponsoring.contactUrl}
        class="px-5 py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-white font-extrabold text-xs sm:text-sm no-underline shrink-0 transition-all shadow-xs"
      >
        📩 Nous écrire
      </a>
    </div>
  </div>
</section>

<!-- BLOC 3 : PARTENAIRES & CADRE INSTITUTIONNEL -->
<section class="py-10 sm:py-14 bg-white">
  <div class="ml-container max-w-5xl mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-orange-100/70 text-orange-800 border border-orange-200/60 mb-2">
        Écosystème institutionnel & partenaires
      </span>
      <h2 class="text-xl sm:text-2xl font-black text-stone-900 font-title m-0">
        Un dispositif au service de l'emploi des jeunes
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
      <!-- APEJ -->
      <div class="bg-gradient-to-b from-amber-50/40 to-stone-50/60 rounded-2xl p-5 border-2 border-amber-300/80 shadow-xs flex flex-col justify-between text-center relative">
        <div class="h-20 flex items-center justify-center my-1">
          <img
            src="/images/logo-apej.svg"
            alt="APEJ Mali"
            class="max-h-16 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <div>
          <h3 class="text-sm font-bold text-stone-900 font-title mb-0.5">APEJ Mali</h3>
          <p class="text-xs font-semibold text-amber-900 m-0">Commanditaire & Autorité de tutelle</p>
        </div>
      </div>

      <!-- EOJ -->
      <div class="bg-stone-50/70 rounded-2xl p-5 border border-stone-200 shadow-xs flex flex-col justify-between text-center">
        <div class="h-20 flex items-center justify-center my-1">
          <img
            src="/images/logo-eoj.svg"
            alt="EOJ Mali"
            class="max-h-14 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <div>
          <h3 class="text-sm font-bold text-stone-900 font-title mb-0.5">EOJ Mali</h3>
          <p class="text-xs font-semibold text-orange-700 m-0">Orientation & Déploiement terrain</p>
        </div>
      </div>

      <!-- PartiCIP -->
      <div class="bg-stone-50/70 rounded-2xl p-5 border border-stone-200 shadow-xs flex flex-col justify-between text-center">
        <div class="h-20 flex items-center justify-center my-1">
          <img
            src="/images/logo-particip.png"
            alt="PartiCIP"
            class="max-h-16 w-auto object-contain rounded-xl"
            loading="lazy"
          />
        </div>
        <div>
          <h3 class="text-sm font-bold text-stone-900 font-title mb-0.5">PartiCIP</h3>
          <p class="text-xs font-semibold text-sky-800 m-0">Partenaire Insertion & Mobilisation</p>
        </div>
      </div>
    </div>
  </div>
</section>
