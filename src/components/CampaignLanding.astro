---
interface Props {
  campaign: any;
  isHomePrelaunch?: boolean;
  allCampaigns?: any[];
}

const { campaign, isHomePrelaunch = false } = Astro.props;
---

<!-- BLOC 1 : HERO TOUT-EN-UN ULTRA-ÉPURÉ (LECTURE EN 5 SECONDES) -->
<section
  class="ml-hero bg-gradient-to-b from-amber-50/95 via-orange-50/35 to-white text-stone-900 pt-7 pb-12 sm:py-14 px-3 sm:px-4 relative overflow-hidden border-b border-stone-200/80"
>
  <!-- Illustrations latérales Mali Job -->
  <div
    class="hero-illustration-left hidden md:block absolute -left-2 lg:left-4 bottom-0 w-[200px] lg:w-[290px] xl:w-[350px] pointer-events-none select-none z-0 opacity-85 lg:opacity-95"
  >
    <picture>
      <source srcset="/images/jobavenir-4.webp" type="image/webp" />
      <img
        src="/images/jobavenir-4.png"
        alt="Illustration Métiers et Innovation Mali"
        class="w-full h-auto object-contain object-left-bottom drop-shadow-md max-h-[390px]"
        width="800"
        height="818"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>

  <div
    class="hero-illustration-right hidden md:block absolute -right-2 lg:right-4 bottom-0 w-[200px] lg:w-[290px] xl:w-[350px] pointer-events-none select-none z-0 opacity-85 lg:opacity-95"
  >
    <picture>
      <source srcset="/images/jobavenir-5.webp" type="image/webp" />
      <img
        src="/images/jobavenir-5.png"
        alt="Illustration Opportunités Jeunesse Mali"
        class="w-full h-auto object-contain object-right-bottom drop-shadow-md max-h-[390px]"
        width="800"
        height="818"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>

  <div class="w-full max-w-3xl mx-auto text-center relative z-10 px-2 sm:px-4">
    <!-- Petit badge court -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-stone-900 text-amber-300 text-xs font-extrabold mb-4 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>
        {isHomePrelaunch
          ? "Bientôt : Ouverture des offres d'emploi Mali Job"
          : campaign.badge}
      </span>
    </div>

    <!-- Titre percutant et épuré -->
    <h1
      class="text-3xl sm:text-5xl md:text-6xl font-black font-title tracking-tight text-stone-900 leading-[1.12] mb-4"
    >
      Grand Concours d'Innovation<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-600">
        3 × 100 000 FCFA à gagner
      </span>
    </h1>

    <p class="text-base sm:text-xl font-medium text-stone-700 max-w-2xl mx-auto mb-8 leading-relaxed">
      Financement direct pour vos projets et mise en avant de <strong>10 lauréats</strong> sur le portail officiel Mali Job.
    </p>

    <!-- LES 2 AVANTAGES CLÉS DE LA COMMUNAUTÉ -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl mx-auto mb-7 text-left">
      <!-- Avantage 1 : Concours -->
      <div class="bg-white/95 p-5 sm:p-6 rounded-2xl border-2 border-orange-200/90 shadow-sm flex items-start gap-4 transition-all hover:border-orange-300">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 text-white flex items-center justify-center shrink-0 shadow-md shadow-orange-500/25">
          <!-- Trophée / Fusée d'innovation -->
          <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
            <path d="M12 2a1 1 0 0 1 1 1v1.07A8.003 8.003 0 0 1 20 12c0 2.92-1.56 5.48-3.88 6.87l-.12.07v1.06a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-1.06l-.12-.07A7.999 7.999 0 0 1 4 12c0-4.08 3.05-7.44 7-7.93V3a1 1 0 0 1 1-1zm0 4a6 6 0 0 0-6 6c0 2.22 1.21 4.16 3 5.2v1.8a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1V17.2c1.79-1.04 3-2.98 3-5.2a6 6 0 0 0-6-6zm-1 3a1 1 0 0 1 2 0v2.59l1.71 1.7a1 1 0 0 1-1.42 1.42L11.58 13A1 1 0 0 1 11 12.41V9z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-base sm:text-lg font-black text-stone-900 mb-1 font-title">
            Participer au concours
          </h3>
          <p class="text-xs sm:text-sm text-stone-600 leading-relaxed m-0">
            Déposez votre vidéo en moins de 3 min avec votre téléphone et tentez de remporter l'un des 3 prix de 100 000 FCFA.
          </p>
        </div>
      </div>

      <!-- Avantage 2 : Opportunités & Emploi -->
      <div class="bg-white/95 p-5 sm:p-6 rounded-2xl border-2 border-emerald-200/90 shadow-sm flex items-start gap-4 transition-all hover:border-emerald-300">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 text-white flex items-center justify-center shrink-0 shadow-md shadow-emerald-500/25">
          <!-- Mallette / Emploi -->
          <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
            <path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2zM4 19V8h16v11H4zm7-9h2v3h3v2h-3v3h-2v-3H8v-2h3v-3z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-base sm:text-lg font-black text-stone-900 mb-1 font-title">
            Recevoir les opportunités
          </h3>
          <p class="text-xs sm:text-sm text-stone-600 leading-relaxed m-0">
            Offres d'emploi, stages vérifiés, formations professionnelles financées et opportunités économiques au Mali.
          </p>
        </div>
      </div>
    </div>

    <!-- CARTE D'ACTION UNIQUE ET LIMPIDE -->
    <div class="bg-white p-6 sm:p-8 rounded-3xl shadow-xl shadow-orange-950/10 border-2 border-stone-200/90 max-w-2xl mx-auto text-center relative z-20">
      <h2 class="text-lg sm:text-2xl font-black text-stone-900 mb-2 font-title leading-snug">
        Rejoignez notre groupe WhatsApp ou Telegram
      </h2>
      <p class="text-xs sm:text-sm text-stone-500 mb-6">
        Accès direct, gratuit et sans inscription préalable.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <a
          href={campaign.community.whatsappGroupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white font-black py-4 px-5 rounded-2xl shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2.5 no-underline text-base sm:text-lg"
        >
          <svg class="w-6 h-6 shrink-0 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.126.556 4.124 1.529 5.856l-1.529 5.584 5.735-1.504c1.693.924 3.631 1.451 5.694 1.451 6.627 0 12-5.373 12-12 0-6.627-5.373-12-11.429-11.387z"/>
          </svg>
          <span>WhatsApp</span>
        </a>

        <a
          href={campaign.community.telegramGroupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-sky-600 hover:bg-sky-700 active:scale-[0.98] text-white font-black py-4 px-5 rounded-2xl shadow-lg shadow-sky-600/25 transition-all flex items-center justify-center gap-2.5 no-underline text-base sm:text-lg"
        >
          <svg class="w-6 h-6 shrink-0 fill-current" viewBox="0 0 24 24">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          <span>Telegram</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- BLOC 2 : ENCART SPONSORING COMPACT -->
<section class="py-8 bg-stone-50 border-b border-stone-200">
  <div class="ml-container max-w-4xl mx-auto px-4">
    <div class="bg-white rounded-2xl p-5 sm:p-6 border border-amber-300/90 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <span class="text-[11px] font-black uppercase tracking-wider text-orange-700 block mb-0.5 flex items-center justify-center sm:justify-start gap-1">
          <i class="ml-icon-building-line ml-icon--xs"></i>
          <span>Entreprises, ONG, Institutions & Diaspora</span>
        </span>
        <h2 class="text-base sm:text-lg font-black text-stone-900 font-title m-0">
          Vous souhaitez sponsoriser un prix d'innovation ?
        </h2>
      </div>
      <a
        href={campaign.sponsoring.contactUrl}
        class="px-5 py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-white font-extrabold text-xs sm:text-sm no-underline shrink-0 transition-all shadow-xs inline-flex items-center gap-1.5"
      >
        <i class="ml-icon-mail-line ml-icon--xs"></i>
        <span>Nous écrire</span>
      </a>
    </div>
  </div>
</section>

<!-- BLOC 3 : PARTENAIRES & CADRE INSTITUTIONNEL -->
<section class="py-10 sm:py-14 bg-white">
  <div class="ml-container max-w-5xl mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-orange-100/70 text-orange-800 border border-orange-200/60 mb-2">
        Écosystème institutionnel & partenaires
      </span>
      <h2 class="text-xl sm:text-2xl font-black text-stone-900 font-title m-0">
        Un dispositif au service de l'emploi des jeunes
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
      <!-- APEJ -->
      <div class="bg-gradient-to-b from-amber-50/40 to-stone-50/60 rounded-2xl p-5 border-2 border-amber-300/80 shadow-xs flex flex-col justify-between text-center relative">
        <div class="h-20 flex items-center justify-center my-1">
          <img
            src="/images/logo-apej.svg"
            alt="APEJ Mali"
            class="max-h-16 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <div>
          <h3 class="text-sm font-bold text-stone-900 font-title mb-0.5">APEJ Mali</h3>
          <p class="text-xs font-semibold text-amber-900 m-0">Commanditaire & Autorité de tutelle</p>
        </div>
      </div>

      <!-- EOJ -->
      <div class="bg-stone-50/70 rounded-2xl p-5 border border-stone-200 shadow-xs flex flex-col justify-between text-center">
        <div class="h-20 flex items-center justify-center my-1">
          <img
            src="/images/logo-eoj.svg"
            alt="EOJ Mali"
            class="max-h-14 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <div>
          <h3 class="text-sm font-bold text-stone-900 font-title mb-0.5">EOJ Mali</h3>
          <p class="text-xs font-semibold text-orange-700 m-0">Orientation & Déploiement terrain</p>
        </div>
      </div>

      <!-- PartiCIP -->
      <div class="bg-stone-50/70 rounded-2xl p-5 border border-stone-200 shadow-xs flex flex-col justify-between text-center">
        <div class="h-20 flex items-center justify-center my-1">
          <img
            src="/images/logo-particip.png"
            alt="PartiCIP"
            class="max-h-16 w-auto object-contain rounded-xl"
            loading="lazy"
          />
        </div>
        <div>
          <h3 class="text-sm font-bold text-stone-900 font-title mb-0.5">PartiCIP</h3>
          <p class="text-xs font-semibold text-sky-800 m-0">Partenaire Insertion & Mobilisation</p>
        </div>
      </div>
    </div>
  </div>
</section>
