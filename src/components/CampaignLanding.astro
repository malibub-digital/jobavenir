---
interface Props {
  campaign: any;
  isHomePrelaunch?: boolean;
  allCampaigns?: any[];
}

const { campaign, isHomePrelaunch = false } = Astro.props;
---

<!-- BLOC 1 : HERO TOUT-EN-UN ULTRA-ÉPURÉ (LECTURE EN 5 SECONDES) -->
<section
  class="ml-hero bg-gradient-to-b from-amber-50/95 via-orange-50/35 to-white text-stone-900 pt-7 pb-12 sm:py-14 px-3 sm:px-4 relative overflow-hidden border-b border-stone-200/80"
>
  <!-- Illustrations latérales Mali Job -->
  <div
    class="hero-illustration-left hidden md:block absolute -left-2 lg:left-4 bottom-0 w-[200px] lg:w-[290px] xl:w-[350px] pointer-events-none select-none z-0 opacity-85 lg:opacity-95"
  >
    <picture>
      <source srcset="/images/jobavenir-4.webp" type="image/webp" />
      <img
        src="/images/jobavenir-4.png"
        alt="Illustration Métiers et Innovation Mali"
        class="w-full h-auto object-contain object-left-bottom drop-shadow-md max-h-[390px]"
        width="800"
        height="818"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>

  <div
    class="hero-illustration-right hidden md:block absolute -right-2 lg:right-4 bottom-0 w-[200px] lg:w-[290px] xl:w-[350px] pointer-events-none select-none z-0 opacity-85 lg:opacity-95"
  >
    <picture>
      <source srcset="/images/jobavenir-5.webp" type="image/webp" />
      <img
        src="/images/jobavenir-5.png"
        alt="Illustration Opportunités Jeunesse Mali"
        class="w-full h-auto object-contain object-right-bottom drop-shadow-md max-h-[390px]"
        width="800"
        height="818"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>

  <div class="w-full max-w-4xl mx-auto text-center relative z-10 px-2 sm:px-4">
    <!-- Petit badge court -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-stone-900 text-amber-300 text-xs font-extrabold mb-4 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>
        {isHomePrelaunch
          ? "Bientôt : Ouverture des offres d'emploi Mali Job"
          : campaign.badge}
      </span>
    </div>

    <!-- Titre percutant et grand -->
    <h1
      class="text-3xl sm:text-5xl md:text-6xl font-black font-title tracking-tight text-stone-900 leading-[1.12] mb-3"
    >
      Grand Concours d'Innovation<br />
      <span class="text-orange-600">{campaign.highlightTitle}</span>
    </h1>

    <p class="text-sm sm:text-base md:text-lg font-medium text-stone-600 max-w-2xl mx-auto mb-8">
      Soutien direct aux entrepreneurs et mise en lumière des talents maliens.
    </p>

    <!-- CARTE MAÎTRESSE CENTRALE : TOUT EN UN COUP D'ŒIL (PLUS LARGE & AÉRÉE) -->
    <div class="bg-white p-6 sm:p-9 rounded-3xl shadow-xl shadow-orange-950/10 border-2 border-orange-200/90 max-w-3xl mx-auto text-left relative z-20">
      
      <!-- 1. CE QU'IL Y A À GAGNER (2 CARTES VALORISÉES) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-6">
        <div class="bg-amber-50/70 p-4 rounded-2xl border border-amber-300 flex items-start gap-3.5">
          <div class="w-11 h-11 rounded-xl bg-amber-500 text-stone-950 flex items-center justify-center shrink-0 shadow-sm font-black text-lg">
            🏆
          </div>
          <div>
            <div class="text-sm sm:text-base font-black text-stone-900 leading-snug">
              {campaign.prizes.grandPrizeCount} Grands Prix de {campaign.prizes.grandPrizeAmount}
            </div>
            <div class="text-xs text-stone-600 mt-1 leading-normal">
              Financement direct + mise à l'honneur sur le site officiel.
            </div>
          </div>
        </div>

        <div class="bg-emerald-50/70 p-4 rounded-2xl border border-emerald-300 flex items-start gap-3.5">
          <div class="w-11 h-11 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-sm font-black text-lg">
            🚀
          </div>
          <div>
            <div class="text-sm sm:text-base font-black text-stone-900 leading-snug">
              {campaign.prizes.laureateCount} Projets publiés sur Mali Job
            </div>
            <div class="text-xs text-stone-600 mt-1 leading-normal">
              Une page officielle dédiée pour vous faire connaître et lever des fonds.
            </div>
          </div>
        </div>
      </div>

      <!-- 2. REJOINDRE LE GROUPE POUR (2 RAISONS SIMPLES) -->
      <div class="border-t border-stone-200/80 pt-5 mb-5">
        <div class="text-sm sm:text-base font-black text-stone-900 mb-3 flex items-center gap-2">
          <i class="ml-icon-cellphone-line ml-icon--sm text-orange-600"></i>
          <span>Rejoignez notre groupe WhatsApp ou Telegram pour :</span>
        </div>

        <div class="space-y-2.5">
          <div class="flex items-center gap-3 bg-amber-50/90 px-4 py-3 rounded-xl border border-amber-200">
            <span class="w-6 h-6 rounded-full bg-orange-600 text-white text-xs font-black flex items-center justify-center shrink-0 shadow-xs">1</span>
            <span class="text-xs sm:text-sm text-stone-800">
              <strong>Participer au concours</strong> <span class="text-stone-600">(consignes dans le groupe : 1 vidéo simple &lt; 3 min)</span>
            </span>
          </div>

          <div class="flex items-center gap-3 bg-stone-50 px-4 py-3 rounded-xl border border-stone-200">
            <span class="w-6 h-6 rounded-full bg-emerald-600 text-white text-xs font-black flex items-center justify-center shrink-0 shadow-xs">2</span>
            <span class="text-xs sm:text-sm text-stone-800">
              <strong>Recevoir nos opportunités</strong> <span class="text-stone-600">(emplois, stages, formations, idées business)</span>
            </span>
          </div>
        </div>
      </div>

      <!-- 3. ACTIONS BOUTONS WHATSAPP / TELEGRAM -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
        <a
          href={campaign.community.whatsappGroupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white font-extrabold py-3.5 px-5 rounded-2xl shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-2.5 no-underline text-sm sm:text-base"
        >
          <svg class="w-5 h-5 shrink-0 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.126.556 4.124 1.529 5.856l-1.529 5.584 5.735-1.504c1.693.924 3.631 1.451 5.694 1.451 6.627 0 12-5.373 12-12 0-6.627-5.373-12-11.429-11.387z"/>
          </svg>
          <span>Rejoindre sur WhatsApp</span>
        </a>

        <a
          href={campaign.community.telegramGroupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-sky-600 hover:bg-sky-700 active:scale-[0.98] text-white font-extrabold py-3.5 px-5 rounded-2xl shadow-md shadow-sky-600/20 transition-all flex items-center justify-center gap-2.5 no-underline text-sm sm:text-base"
        >
          <svg class="w-5 h-5 shrink-0 fill-current" viewBox="0 0 24 24">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          <span>Rejoindre sur Telegram</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- BLOC 2 : PROCESSUS DE SÉLECTION & JURY -->
<section class="py-12 sm:py-16 bg-gradient-to-b from-white via-amber-50/20 to-stone-50/40 border-b border-stone-200/80">
  <div class="ml-container max-w-5xl mx-auto px-4">

    <!-- En-tête -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-stone-900 text-amber-300 border border-stone-800 mb-3 shadow-xs">
        Comment sont sélectionnés les projets ?
      </span>
      <h2 class="text-2xl sm:text-3xl font-black text-stone-900 font-title leading-tight m-0">
        Critères de sélection & Jury
      </h2>
      <p class="text-sm sm:text-base text-stone-600 mt-2 max-w-xl mx-auto leading-relaxed">
        Une évaluation équitable, transparente et accessible à tous les talents, en trois étapes à partir de votre vidéo de présentation de moins de 3 minutes.
      </p>
    </div>

    <!-- ÉTAPE 1 : VÉRIFICATION DE RECEVABILITÉ -->
    <div class="relative mb-8 sm:mb-10">
      <div class="bg-white p-5 sm:p-7 rounded-2xl border border-stone-200/90 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-start gap-4 sm:gap-5">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-stone-900 text-amber-300 flex items-center justify-center shrink-0 font-black text-base sm:text-lg shadow-xs">
            1
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-base sm:text-lg font-black text-stone-900 font-title mb-1.5">Vérification de recevabilité</h3>
            <p class="text-sm text-stone-600 leading-relaxed m-0">
              L'équipe Mali Job vérifie que chaque candidature respecte les conditions du concours&nbsp;: projet porté au Mali, format vidéo inférieur à 3&nbsp;minutes, présentation claire du problème résolu et de la solution proposée.
            </p>
          </div>
        </div>
      </div>
      <!-- Flèche de liaison -->
      <div class="hidden sm:flex justify-center py-1 text-stone-300">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
      </div>
    </div>

    <!-- ÉTAPE 2 : GRILLE D'ÉVALUATION 100 POINTS -->
    <div class="relative mb-8 sm:mb-10">
      <div class="bg-gradient-to-br from-orange-50/60 via-white to-amber-50/40 p-5 sm:p-7 rounded-2xl border-2 border-orange-200/80 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-start gap-4 sm:gap-5">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-orange-600 text-white flex items-center justify-center shrink-0 font-black text-base sm:text-lg shadow-xs">
            2
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-base sm:text-lg font-black text-stone-900 font-title mb-3">Grille d'évaluation sur <span class="text-orange-600">100 points</span></h3>
            <p class="text-sm text-stone-600 mb-4 leading-relaxed">
              Les vidéos recevables sont évaluées selon quatre critères adaptés aux projets en phase de lancement ou de développement&nbsp;:
            </p>
            <!-- 4 critères en grille 2x2 -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- Critère 1 -->
              <div class="bg-white p-4 rounded-xl border border-orange-200/70 flex flex-col">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-xs font-black text-orange-700 uppercase tracking-wider">Utilité & impact local</span>
                  <span class="text-sm font-black text-orange-600 bg-orange-100/80 px-2 py-0.5 rounded-lg">30 pts</span>
                </div>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed m-0">
                  Le projet répond-il à un besoin réel au Mali et présente-t-il un potentiel concret de création d'activité ou d'emplois&nbsp;?
                </p>
              </div>
              <!-- Critère 2 -->
              <div class="bg-white p-4 rounded-xl border border-orange-200/70 flex flex-col">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-xs font-black text-stone-700 uppercase tracking-wider">Clarté & faisabilité</span>
                  <span class="text-sm font-black text-orange-600 bg-orange-100/80 px-2 py-0.5 rounded-lg">30 pts</span>
                </div>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed m-0">
                  La solution est-elle compréhensible, réaliste et activable rapidement avec un premier soutien de 100&nbsp;000&nbsp;FCFA&nbsp;?
                </p>
              </div>
              <!-- Critère 3 -->
              <div class="bg-white p-4 rounded-xl border border-amber-200/70 flex flex-col">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-xs font-black text-amber-800 uppercase tracking-wider">Motivation & maîtrise</span>
                  <span class="text-sm font-black text-amber-700 bg-amber-100/80 px-2 py-0.5 rounded-lg">25 pts</span>
                </div>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed m-0">
                  Le porteur démontre-t-il sa connaissance du terrain, son engagement et sa capacité à passer à l'action dans sa vidéo&nbsp;?
                </p>
              </div>
              <!-- Critère 4 -->
              <div class="bg-white p-4 rounded-xl border border-amber-200/70 flex flex-col">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-xs font-black text-emerald-800 uppercase tracking-wider">Originalité de l'approche</span>
                  <span class="text-sm font-black text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-lg">15 pts</span>
                </div>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed m-0">
                  Le projet apporte-t-il une amélioration concrète, une idée neuve ou une adaptation pertinente aux réalités maliennes&nbsp;?
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Flèche -->
      <div class="hidden sm:flex justify-center py-1 text-stone-300">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
      </div>
    </div>

    <!-- ÉTAPE 3 : JURY & ENTRETIENS -->
    <div class="mb-6 sm:mb-8">
      <div class="bg-white p-5 sm:p-7 rounded-2xl border border-stone-200/90 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-start gap-4 sm:gap-5">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 font-black text-base sm:text-lg shadow-xs">
            3
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-base sm:text-lg font-black text-stone-900 font-title mb-3">Le jury & les entretiens de sélection</h3>
            <p class="text-sm text-stone-600 mb-4 leading-relaxed">
              Un jury indépendant de <strong class="text-stone-900">5 membres</strong> évalue les candidatures présélectionnées en toute impartialité, sur la seule base de la grille d'évaluation ci-dessus&nbsp;:
            </p>

            <!-- 5 membres du jury -->
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5 mb-5">
              <div class="bg-stone-50/80 p-3 rounded-xl border border-stone-200 text-center">
                <div class="text-lg mb-1">🏛️</div>
                <div class="text-xs font-bold text-stone-800 leading-tight">APEJ Mali</div>
                <div class="text-[10px] text-stone-500">1 représentant</div>
              </div>
              <div class="bg-stone-50/80 p-3 rounded-xl border border-stone-200 text-center">
                <div class="text-lg mb-1">🤝</div>
                <div class="text-xs font-bold text-stone-800 leading-tight">PartiCIP</div>
                <div class="text-[10px] text-stone-500">1 représentant</div>
              </div>
              <div class="bg-stone-50/80 p-3 rounded-xl border border-stone-200 text-center">
                <div class="text-lg mb-1">⭐</div>
                <div class="text-xs font-bold text-stone-800 leading-tight">Sponsor</div>
                <div class="text-[10px] text-stone-500">2 représentants</div>
              </div>
              <div class="bg-stone-50/80 p-3 rounded-xl border border-stone-200 text-center">
                <div class="text-lg mb-1">💡</div>
                <div class="text-xs font-bold text-stone-800 leading-tight">Entrepreneur</div>
                <div class="text-[10px] text-stone-500">1 expérimenté</div>
              </div>
              <div class="col-span-2 sm:col-span-1 bg-amber-50/60 p-3 rounded-xl border border-amber-200 text-center">
                <div class="text-lg mb-1">⚖️</div>
                <div class="text-xs font-bold text-stone-800 leading-tight">5 membres</div>
                <div class="text-[10px] text-stone-500">indépendants</div>
              </div>
            </div>

            <!-- Suite : entretiens + résultats -->
            <div class="bg-stone-50/60 p-4 sm:p-5 rounded-xl border border-stone-200/80">
              <p class="text-sm text-stone-700 leading-relaxed m-0 mb-3">
                Les <strong class="text-stone-900">10 meilleurs projets</strong> retenus par le jury bénéficient d'un entretien individuel avec l'équipe d'évaluation afin de valider la réalité du projet, d'approfondir les besoins du porteur et de préparer leur mise en lumière sur la plateforme Mali Job.
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="bg-emerald-50/80 p-3.5 rounded-xl border border-emerald-200/70 flex items-start gap-3">
                  <span class="text-lg shrink-0 mt-0.5">🏅</span>
                  <div>
                    <div class="text-xs font-black text-stone-900">10 lauréats</div>
                    <p class="text-xs text-stone-600 m-0 leading-relaxed">
                      Une page officielle dédiée sur Mali Job pour gagner en visibilité auprès des partenaires et investisseurs.
                    </p>
                  </div>
                </div>
                <div class="bg-amber-50/80 p-3.5 rounded-xl border border-amber-200/70 flex items-start gap-3">
                  <span class="text-lg shrink-0 mt-0.5">🏆</span>
                  <div>
                    <div class="text-xs font-black text-stone-900">3 Grands Prix</div>
                    <p class="text-xs text-stone-600 m-0 leading-relaxed">
                      Les 3 premiers du classement final remportent <strong class="text-amber-700">100&nbsp;000&nbsp;FCFA</strong> chacun pour accélérer leur lancement.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- BLOC 3 : ENCART SPONSORING COMPACT -->
<section class="py-8 bg-stone-50 border-b border-stone-200">
  <div class="ml-container max-w-4xl mx-auto px-4">
    <div class="bg-white rounded-2xl p-5 sm:p-6 border border-amber-300/90 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <span class="text-[11px] font-black uppercase tracking-wider text-orange-700 block mb-0.5 flex items-center justify-center sm:justify-start gap-1">
          <i class="ml-icon-building-line ml-icon--xs"></i>
          <span>Entreprises, ONG, Institutions & Diaspora</span>
        </span>
        <h2 class="text-base sm:text-lg font-black text-stone-900 font-title m-0">
          Vous souhaitez sponsoriser un prix d'innovation ?
        </h2>
      </div>
      <a
        href={campaign.sponsoring.contactUrl}
        class="px-5 py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-white font-extrabold text-xs sm:text-sm no-underline shrink-0 transition-all shadow-xs inline-flex items-center gap-1.5"
      >
        <i class="ml-icon-mail-line ml-icon--xs"></i>
        <span>Nous écrire</span>
      </a>
    </div>
  </div>
</section>

<!-- BLOC 3 : PARTENAIRES & CADRE INSTITUTIONNEL -->
<section class="py-10 sm:py-14 bg-white">
  <div class="ml-container max-w-5xl mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-orange-100/70 text-orange-800 border border-orange-200/60 mb-2">
        Écosystème institutionnel & partenaires
      </span>
      <h2 class="text-xl sm:text-2xl font-black text-stone-900 font-title m-0">
        Un dispositif au service de l'emploi des jeunes
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
      <!-- APEJ -->
      <div class="bg-gradient-to-b from-amber-50/40 to-stone-50/60 rounded-2xl p-5 border-2 border-amber-300/80 shadow-xs flex flex-col justify-between text-center relative">
        <div class="h-20 flex items-center justify-center my-1">
          <img
            src="/images/logo-apej.svg"
            alt="APEJ Mali"
            class="max-h-16 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <div>
          <h3 class="text-sm font-bold text-stone-900 font-title mb-0.5">APEJ Mali</h3>
          <p class="text-xs font-semibold text-amber-900 m-0">Commanditaire & Autorité de tutelle</p>
        </div>
      </div>

      <!-- EOJ -->
