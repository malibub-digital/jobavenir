---
import siteConfig from '../../site.config.json';

interface Props {
  showBackHome?: boolean;
}

const { showBackHome = false } = Astro.props;
---

<header class="ml-header ml-header-sticky ml-header-shrinkable" id="site-header">
  <div class="ml-container">
    <div class="header-top">
      <!-- BRAND-BLOCK DSML AVEC LOGO OFFICIEL DU MALI & LOGO EOJ -->
      <a href="/" class="brand-block">
        <img
          src={siteConfig.logoUrl || "/images/logo-mali.svg"}
          alt="Armoiries de la République du Mali"
          class="ml-header-logo"
          width="50"
          height="50"
        />
        <img
          src="/images/logo-eoj.svg"
          alt="EOJ Mali"
          class="h-9 md:h-11 w-auto object-contain shrink-0"
          width="65"
          height="45"
        />
        <div class="brand-text">
          <div class="brand-title" data-cms-bind="siteConfig.institution">
            {siteConfig.institution || "RÉPUBLIQUE DU MALI"}
          </div>
          <div class="site-title" data-cms-bind="siteConfig.title">
            {siteConfig.title || "JobAvenir Mali"}
          </div>
          <div class="ml-tricolor-bar" aria-hidden="true">
            <div class="green"></div>
            <div class="yellow"></div>
            <div class="red"></div>
          </div>
        </div>
      </a>
      <div class="header-actions">
        <a
          href="/login"
          id="header-auth-login"
          class="header-auth-btn items-center gap-1.5"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Se connecter</span>
        </a>
        <button
          type="button"
          id="header-auth-logout"
          class="header-auth-btn header-auth-logout items-center gap-1.5 hidden"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Déconnexion</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-auth-btn {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--ml-color-river-700, #0284c7);
    border: 1px solid var(--ml-color-river-200, #bae6fd);
    background-color: var(--ml-color-river-50, #f0f9ff);
    transition: all 0.15s ease;
    text-decoration: none;
    display: inline-flex;
  }
  .header-auth-btn:hover {
    background-color: var(--ml-color-river-700, #0284c7);
    color: #ffffff;
    border-color: var(--ml-color-river-700, #0284c7);
  }
  .header-auth-logout {
    color: #dc2626;
    border-color: #fecaca;
    background-color: #fef2f2;
    cursor: pointer;
  }
  .header-auth-logout:hover {
    background-color: #dc2626;
    color: #ffffff;
    border-color: #dc2626;
  }

  @media (max-width: 640px) {
    .header-auth-btn {
      padding: 0.4rem;
      border-radius: 9999px;
    }
    .header-auth-btn span {
      display: none;
    }
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  import { getAdminCookieToken, clearAdminCookieToken } from '@malihub/sites-core/utils/auth.js';

  function updateHeaderAuth() {
    const token = getAdminCookieToken();
    const isLoggedIn = !!token && token.length > 0;

    const desktopLogin = document.getElementById("header-auth-login");
    const desktopLogout = document.getElementById("header-auth-logout");

    if (isLoggedIn) {
      desktopLogin?.classList.add("hidden");
      desktopLogout?.classList.remove("hidden");
    } else {
      desktopLogin?.classList.remove("hidden");
      desktopLogout?.classList.add("hidden");
    }
  }

  function setupAuthEvents() {
    const desktopLogout = document.getElementById("header-auth-logout");

    function handleLogout() {
      clearAdminCookieToken();
      updateHeaderAuth();
      if (window.location.pathname === "/admin") {
        window.location.href = "/";
      } else {
        window.location.reload();
      }
    }

    desktopLogout?.addEventListener("click", handleLogout);
  }

  function setupHeaderShrink() {
    const header = document.getElementById("site-header");
    if (!header) return;

    function onScroll() {
      if (window.scrollY > 30) {
        header?.classList.add("ml-scrolled");
      } else {
        header?.classList.remove("ml-scrolled");
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  updateHeaderAuth();
  setupAuthEvents();
  setupHeaderShrink();

  document.addEventListener("astro:after-swap", () => {
    updateHeaderAuth();
    setupAuthEvents();
    setupHeaderShrink();
  });
</script>

