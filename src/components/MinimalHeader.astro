---
import siteConfig from '../../site.config.json';

interface Props {
  showBackHome?: boolean;
  currentPath?: string;
}

const { showBackHome = false, currentPath = Astro.url.pathname } = Astro.props;

const normalizePath = (path: string) =>
  path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;

const cleanCurrentPath = normalizePath(currentPath);

const navLinks = [
  { label: 'Accueil', href: '/' },
  { label: 'Opportunités', href: '/opportunites' },
  { label: 'Idées business', href: '/idees' },
  { label: 'Actualités', href: '/actualites' },
  { label: 'Contact', href: '/contact' }
];
---

<header class="ml-header ml-header-sticky ml-header-shrinkable" id="site-header">
  <div class="ml-container">
    <div class="header-top">
      <!-- BRAND-BLOCK DSML AVEC LOGO OFFICIEL DU MALI & LOGO EOJ -->
      <a href="/" class="brand-block">
        <img
          src={siteConfig.logoUrl || "/images/logo-mali.svg"}
          alt="Armoiries de la République du Mali"
          class="ml-header-logo"
          width="50"
          height="50"
        />
        <img
          src="/images/logo-eoj.svg"
          alt="EOJ Mali"
          class="h-9 md:h-11 w-auto object-contain shrink-0"
          width="65"
          height="45"
        />
        <div class="brand-text">
          <div class="brand-title" data-cms-bind="siteConfig.institution">
            {siteConfig.institution || "RÉPUBLIQUE DU MALI"}
          </div>
          <div class="site-title" data-cms-bind="siteConfig.title">
            {siteConfig.title || "JobAvenir Mali"}
          </div>
          <div class="ml-tricolor-bar" aria-hidden="true">
            <div class="green"></div>
            <div class="yellow"></div>
            <div class="red"></div>
          </div>
        </div>
      </a>

      <!-- NAVIGATION PRINCIPALE DESKTOP -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2 ml-4">
        {navLinks.map((item) => {
          const cleanItemHref = normalizePath(item.href);
          const isActive =
            cleanItemHref === '/'
              ? cleanCurrentPath === '/'
              : cleanCurrentPath === cleanItemHref || cleanCurrentPath.startsWith(cleanItemHref + '/');
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded-xl text-xs lg:text-sm font-bold transition-colors no-underline ${
                isActive
                  ? 'bg-orange-50 text-orange-700 border border-orange-200/80 shadow-xs'
                  : 'text-stone-700 hover:text-orange-600 hover:bg-stone-50'
              }`}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="header-actions">
        <a
          href="/login"
          id="header-auth-login"
          class="header-auth-btn items-center gap-1.5"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Se connecter</span>
        </a>
        <a
          href="/admin"
          id="header-admin-portal"
          class="header-auth-btn header-admin-portal items-center gap-1.5 hidden"
          title="Accéder au panneau d'administration"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span>Admin</span>
        </a>
        <button
          type="button"
          id="header-auth-logout"
          class="header-auth-btn header-auth-logout items-center gap-1.5 hidden"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Déconnexion</span>
        </button>

        <!-- BOUTON MENU BURGER MOBILE -->
        <button
          type="button"
          class="ml-header-burger md:hidden p-2 rounded-xl text-stone-700 hover:bg-stone-100 transition-colors"
          id="header-burger"
          aria-label="Menu principal"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="22" height="22">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- MENU MOBILE TIROIR (DRAWER) -->
    <div
      id="mobile-nav-drawer"
      class="hidden md:hidden pt-3 pb-4 border-t border-stone-200/70 mt-2 flex flex-col gap-1"
    >
      {navLinks.map((item) => {
        const cleanItemHref = normalizePath(item.href);
        const isActive =
          cleanItemHref === '/'
            ? cleanCurrentPath === '/'
            : cleanCurrentPath === cleanItemHref || cleanCurrentPath.startsWith(cleanItemHref + '/');
        return (
          <a
            href={item.href}
            class={`px-3 py-2 rounded-xl text-sm font-bold transition-colors no-underline flex items-center justify-between ${
              isActive
                ? 'bg-orange-50 text-orange-700 font-extrabold border border-orange-200/80'
                : 'text-stone-700 hover:text-orange-600 hover:bg-stone-50'
            }`}
          >
            <span>{item.label}</span>
            {isActive && <span class="w-1.5 h-1.5 rounded-full bg-orange-600"></span>}
          </a>
        );
      })}
    </div>
  </div>
</header>

<style>
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-auth-btn {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--ml-color-river-700, #0284c7);
    border: 1px solid var(--ml-color-river-200, #bae6fd);
    background-color: var(--ml-color-river-50, #f0f9ff);
    transition: all 0.15s ease;
    text-decoration: none;
    display: inline-flex;
  }
  .header-auth-btn:hover {
    background-color: var(--ml-color-river-700, #0284c7);
    color: #ffffff;
    border-color: var(--ml-color-river-700, #0284c7);
  }
  .header-admin-portal {
    color: #b45309;
    border-color: #fde68a;
    background-color: #fef3c7;
    cursor: pointer;
  }
  .header-admin-portal:hover {
    background-color: #d97706;
    color: #ffffff;
    border-color: #d97706;
  }
  .header-auth-logout {
    color: #dc2626;
    border-color: #fecaca;
    background-color: #fef2f2;
    cursor: pointer;
  }
  .header-auth-logout:hover {
    background-color: #dc2626;
    color: #ffffff;
    border-color: #dc2626;
  }

  @media (max-width: 640px) {
    .header-auth-btn {
      padding: 0.4rem;
      border-radius: 9999px;
    }
    .header-auth-btn span {
      display: none;
    }
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  import { getAdminCookieToken, clearAdminCookieToken } from '@malihub/sites-core/utils/auth.js';

  function getMaliConnectUser() {
    if (typeof document === 'undefined') return null;
    const match = document.cookie.match(/(?:^|; )mali_connect_user=([^;]*)/);
    if (!match) return null;
    try {
      return JSON.parse(decodeURIComponent(match[1]));
    } catch {
      return null;
    }
  }

  function updateHeaderAuth() {
    const adminToken = getAdminCookieToken();
    const maliUser = getMaliConnectUser();
    const isLoggedIn = (!!adminToken && adminToken.length > 0) || !!maliUser;

    const desktopLogin = document.getElementById("header-auth-login");
    const desktopAdminPortal = document.getElementById("header-admin-portal");
    const desktopLogout = document.getElementById("header-auth-logout");

    if (isLoggedIn) {
      desktopLogin?.classList.add("hidden");
      if (maliUser && desktopLogout) {
        const textSpan = desktopLogout.querySelector("span");
        if (textSpan) {
          textSpan.textContent = maliUser.name ? `${maliUser.name.split(' ')[0]} (Déconnexion)` : 'Déconnexion';
        }
      }
      desktopAdminPortal?.classList.remove("hidden");
      desktopLogout?.classList.remove("hidden");
    } else {
      desktopLogin?.classList.remove("hidden");
      desktopAdminPortal?.classList.add("hidden");
      desktopLogout?.classList.add("hidden");
    }
  }

  function setupAuthEvents() {
    const desktopLogout = document.getElementById("header-auth-logout");

    function handleLogout() {
      clearAdminCookieToken();
      document.cookie = "mali_connect_user=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax";
      window.location.href = "/api/auth/logout";
    }

    desktopLogout?.addEventListener("click", handleLogout);
  }

  function setupHeaderShrink() {
    const header = document.getElementById("site-header");
    if (!header) return;

    function onScroll() {
      if (window.scrollY > 30) {
        header?.classList.add("ml-scrolled");
      } else {
        header?.classList.remove("ml-scrolled");
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  function setupBurgerMenu() {
    const burgerBtn = document.getElementById("header-burger");
    const drawer = document.getElementById("mobile-nav-drawer");
    if (!burgerBtn || !drawer) return;

    burgerBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = drawer.classList.toggle("hidden");
      burgerBtn.setAttribute("aria-expanded", String(!isHidden));
    });

    document.addEventListener("click", (e) => {
      if (!drawer.classList.contains("hidden") && !drawer.contains(e.target as Node) && !burgerBtn.contains(e.target as Node)) {
        drawer.classList.add("hidden");
        burgerBtn.setAttribute("aria-expanded", "false");
      }
    });
  }

  updateHeaderAuth();
  setupAuthEvents();
  setupHeaderShrink();
  setupBurgerMenu();

  document.addEventListener("astro:after-swap", () => {
    updateHeaderAuth();
    setupAuthEvents();
    setupHeaderShrink();
    setupBurgerMenu();
  });
</script>

