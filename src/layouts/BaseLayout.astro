---
import '@malihub/dsml-core/css/dsml.css';
import '@malihub/dsml-core/css/dsml-icons.css';
import AdminToolbar from '@malihub/sites-core/components/AdminToolbar.astro';
import EmergencyBanner from '@malihub/sites-core/components/EmergencyBanner.astro';
import type { EmergencyNotice } from '@malihub/sites-core/schemas/index.js';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  adminSecret?: string;
  siteId?: string;
  gitEnabled?: boolean;
  emergencyNotice?: EmergencyNotice;
}

const {
  title,
  description = 'Site officiel de l\'administration du Mali',
  lang = 'fr',
  adminSecret = import.meta.env.CMS_ADMIN_SECRET || process.env.CMS_ADMIN_SECRET || '',
  siteId = 'default',
  gitEnabled = Astro.props.gitEnabled,
  emergencyNotice,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

  <script is:inline>
    (function () {
      try {
        const saved = localStorage.getItem('ml_theme') || localStorage.getItem('consulat_theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved === 'dark' || (!saved && prefersDark) ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>
  <!-- Umami Analytics (Malihub) -->
  <script defer src="https://stats.malihub.digital/script.js" data-website-id="f0e5aed9-4da3-4cf1-8c7b-8b70b1760842"></script>
  <slot name="head" />
</head>
<body class="ml-body">
  <AdminToolbar adminSecret={adminSecret} siteId={siteId} gitEnabled={gitEnabled} />
  {emergencyNotice && (
    <EmergencyBanner
      enabled={emergencyNotice.enabled}
      type={emergencyNotice.type}
      message={emergencyNotice.message}
      ctaLabel={emergencyNotice.ctaLabel}
      ctaHref={emergencyNotice.ctaHref}
    />
  )}
  <div class="ml-page-wrapper">
    <slot name="header" />
    <main id="main-content" class="ml-main-content">
      <slot />
    </main>
    <slot name="footer" />
  </div>

  <style is:global>
    body.cms-mode-editing [data-cms-bind] {
      position: relative;
      outline: 1.5px dashed rgba(2, 132, 199, 0.4);
      outline-offset: 2px;
      border-radius: 6px;
      cursor: pointer;
      transition: outline 0.15s ease-in-out, background-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
    body.cms-mode-editing [data-cms-bind]:hover {
      outline: 2px solid #0284c7;
      outline-offset: 2px;
      background-color: rgba(2, 132, 199, 0.08);
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }
    body.cms-mode-editing [data-cms-bind][data-cms-active="true"] {
      outline: 2px solid #0284c7;
      outline-offset: 2px;
      background-color: rgba(2, 132, 199, 0.12);
      box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.25);
    }
    body.cms-mode-editing [data-cms-bind][data-cms-has-draft="true"] {
      outline: 2px dashed #f59e0b;
      outline-offset: 2px;
      background-color: rgba(245, 158, 11, 0.06);
    }
    body.cms-mode-editing [data-cms-bind][data-cms-has-draft="true"]:hover {
      outline: 2px solid #d97706;
      background-color: rgba(245, 158, 11, 0.12);
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
    }
    body.cms-mode-editing .brand-text {
      gap: 6px;
    }

    /* ========================================================
       DARK THEME HARMONIZATION (DSML & CONCOURS DESIGN SYSTEM)
       ======================================================== */
    [data-theme="dark"],
    html[data-theme="dark"],
    .dark {
      /* DSML Dark variables */
      --ml-bg-canvas: #0C120E;
      --ml-bg-surface: #141E17;
      --ml-bg-surface-elevated: #1B2920;
      --ml-bg-surface-subtle: #101813;
      --ml-border-subtle: rgba(255, 255, 255, 0.12);
      --ml-border-strong: rgba(255, 255, 255, 0.22);
      --ml-text-primary: #F3F4F6;
      --ml-text-secondary: #D1D5DB;
      --ml-text-muted: #9CA3AF;
    }

    /* Canvas global en thème sombre */
    [data-theme="dark"] body,
    html[data-theme="dark"] body,
    .dark body {
      background-color: var(--ml-bg-canvas) !important;
      color: var(--ml-text-primary) !important;
    }

    /* Hero section de concours en thème sombre */
    [data-theme="dark"] .ml-hero,
    html[data-theme="dark"] .ml-hero,
    .dark .ml-hero {
      background: radial-gradient(ellipse at 50% 0%, rgba(245, 158, 11, 0.12) 0%, rgba(12, 18, 14, 0.98) 70%, #0C120E 100%) !important;
      border-bottom-color: rgba(255, 255, 255, 0.1) !important;
      color: var(--ml-text-primary) !important;
    }

    /* Titres et textes dans le hero */
    [data-theme="dark"] .ml-hero h1,
    html[data-theme="dark"] .ml-hero h1,
    .dark .ml-hero h1 {
      color: #FFFFFF !important;
    }

    [data-theme="dark"] .ml-hero p,
    html[data-theme="dark"] .ml-hero p,
    .dark .ml-hero p {
      color: #D1D5DB !important;
    }

    /* Carte maîtresse centrale du concours */
    [data-theme="dark"] .ml-hero .bg-white,
    html[data-theme="dark"] .ml-hero .bg-white,
    .dark .ml-hero .bg-white {
      background-color: #141E17 !important;
      border-color: rgba(245, 158, 11, 0.35) !important;
      box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.65) !important;
      color: #F3F4F6 !important;
    }

    /* Sous-cartes et encarts dans la carte maîtresse */
    [data-theme="dark"] .ml-hero .bg-gradient-to-br.from-amber-50\/90,
    html[data-theme="dark"] .ml-hero .bg-gradient-to-br.from-amber-50\/90,
    .dark .ml-hero .bg-gradient-to-br.from-amber-50\/90 {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(20, 30, 23, 0.95) 100%) !important;
      border-color: rgba(245, 158, 11, 0.4) !important;
    }

    [data-theme="dark"] .ml-hero .bg-gradient-to-br.from-emerald-50\/90,
    html[data-theme="dark"] .ml-hero .bg-gradient-to-br.from-emerald-50\/90,
    .dark .ml-hero .bg-gradient-to-br.from-emerald-50\/90 {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(20, 30, 23, 0.95) 100%) !important;
      border-color: rgba(16, 185, 129, 0.4) !important;
    }

    /* Encart langues et cadenas */
    [data-theme="dark"] .ml-hero .bg-gradient-to-r.from-emerald-50\/90,
    html[data-theme="dark"] .ml-hero .bg-gradient-to-r.from-emerald-50\/90,
    .dark .ml-hero .bg-gradient-to-r.from-emerald-50\/90 {
      background: linear-gradient(90deg, rgba(16, 185, 129, 0.14) 0%, rgba(20, 30, 23, 0.9) 100%) !important;
      border-color: rgba(16, 185, 129, 0.35) !important;
    }

    [data-theme="dark"] .ml-hero .bg-gradient-to-r.from-stone-50,
    html[data-theme="dark"] .ml-hero .bg-gradient-to-r.from-stone-50,
    .dark .ml-hero .bg-gradient-to-r.from-stone-50 {
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.06) 0%, rgba(20, 30, 23, 0.9) 100%) !important;
      border-color: rgba(255, 255, 255, 0.14) !important;
    }

    /* Textes dans les cartes */
    [data-theme="dark"] .ml-hero .text-stone-900,
    html[data-theme="dark"] .ml-hero .text-stone-900,
    .dark .ml-hero .text-stone-900 {
      color: #FFFFFF !important;
    }

    [data-theme="dark"] .ml-hero .text-stone-800,
    html[data-theme="dark"] .ml-hero .text-stone-800,
    .dark .ml-hero .text-stone-800 {
      color: #E5E7EB !important;
    }

    [data-theme="dark"] .ml-hero .text-stone-700,
    html[data-theme="dark"] .ml-hero .text-stone-700,
    .dark .ml-hero .text-stone-700,
    [data-theme="dark"] .ml-hero .text-stone-600,
    html[data-theme="dark"] .ml-hero .text-stone-600,
    .dark .ml-hero .text-stone-600 {
      color: #9CA3AF !important;
    }

    [data-theme="dark"] .ml-hero .text-emerald-950,
    html[data-theme="dark"] .ml-hero .text-emerald-950,
    .dark .ml-hero .text-emerald-950 {
      color: #6EE7B7 !important;
    }

    [data-theme="dark"] .ml-hero .text-emerald-900,
    html[data-theme="dark"] .ml-hero .text-emerald-900,
    .dark .ml-hero .text-emerald-900 {
      color: #A7F3D0 !important;
    }

    /* Bandeau date limite dans le Hero */
    [data-theme="dark"] .ml-hero .bg-amber-50,
    html[data-theme="dark"] .ml-hero .bg-amber-50,
    .dark .ml-hero .bg-amber-50 {
      background-color: rgba(245, 158, 11, 0.15) !important;
      border-color: rgba(245, 158, 11, 0.4) !important;
      color: #FDE68A !important;
    }

    /* Encart date limite dans la carte */
    [data-theme="dark"] .ml-hero .bg-gradient-to-r.from-orange-50,
    html[data-theme="dark"] .ml-hero .bg-gradient-to-r.from-orange-50,
    .dark .ml-hero .bg-gradient-to-r.from-orange-50 {
      background: linear-gradient(90deg, rgba(249, 115, 22, 0.15) 0%, rgba(245, 158, 11, 0.12) 100%) !important;
      border-color: rgba(249, 115, 22, 0.35) !important;
    }

    /* Pastilles d'étapes 1 et 2 */
    [data-theme="dark"] .ml-hero .bg-amber-50\/90,
    html[data-theme="dark"] .ml-hero .bg-amber-50\/90,
    .dark .ml-hero .bg-amber-50\/90 {
      background-color: rgba(245, 158, 11, 0.12) !important;
      border-color: rgba(245, 158, 11, 0.3) !important;
    }

    [data-theme="dark"] .ml-hero .bg-stone-50,
    html[data-theme="dark"] .ml-hero .bg-stone-50,
    .dark .ml-hero .bg-stone-50 {
      background-color: rgba(255, 255, 255, 0.05) !important;
      border-color: rgba(255, 255, 255, 0.12) !important;
    }

    /* Sections annexes (Jury, Évaluation, Partenaires) en thème sombre */
    [data-theme="dark"] section.bg-white,
    html[data-theme="dark"] section.bg-white,
    .dark section.bg-white {
      background-color: #0C120E !important;
      color: var(--ml-text-primary) !important;
    }

    [data-theme="dark"] section.bg-stone-50,
    html[data-theme="dark"] section.bg-stone-50,
    .dark section.bg-stone-50 {
      background-color: #101813 !important;
      border-color: rgba(255, 255, 255, 0.08) !important;
      color: var(--ml-text-primary) !important;
    }

    [data-theme="dark"] section .bg-white,
    html[data-theme="dark"] section .bg-white,
    .dark section .bg-white {
      background-color: #141E17 !important;
      border-color: rgba(255, 255, 255, 0.12) !important;
      color: var(--ml-text-primary) !important;
    }

    [data-theme="dark"] section h2,
    html[data-theme="dark"] section h2,
    .dark section h2,
    [data-theme="dark"] section h3,
    html[data-theme="dark"] section h3,
    .dark section h3 {
      color: #FFFFFF !important;
    }

    [data-theme="dark"] section p,
    html[data-theme="dark"] section p,
    .dark section p {
      color: #D1D5DB !important;
    }

    /* Pages de dépôt et traduction en thème sombre */
    [data-theme="dark"] main.bg-stone-50,
    html[data-theme="dark"] main.bg-stone-50,
    .dark main.bg-stone-50 {
      background-color: #0C120E !important;
    }

    [data-theme="dark"] section.bg-white.rounded-3xl,
    html[data-theme="dark"] section.bg-white.rounded-3xl,
    .dark section.bg-white.rounded-3xl {
      background-color: #141E17 !important;
      border-color: rgba(255, 255, 255, 0.12) !important;
    }
  </style>
</body>
</html>
